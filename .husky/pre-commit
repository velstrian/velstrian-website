#!/bin/sh
# [IDENTITY HARD RULE 2026-06-14] Enforce platform identity on all commits.
# Required author: Velstrian Tenderworks <platform@velstrian.com>
# [R285-REBRAND-12 2026-10-21] Owner approved the move from Crow Agent
# <crowagent.platform@gmail.com>. The workspace rule changed on 2026-10-20 and this hook had not,
# so it forced every website commit back onto the old identity. History is not rewritten.
__ok_email="platform@velstrian.com"
__author="$(git var GIT_AUTHOR_IDENT 2>/dev/null)"
case "$__author" in
  *"<$__ok_email>"*)
    :;; # platform identity confirmed, proceed
  *)
    echo "BLOCKED: commit author must be 'Velstrian Tenderworks <platform@velstrian.com>'." >&2
    echo "Run: git config user.name 'Velstrian Tenderworks' && git config user.email 'platform@velstrian.com'" >&2
    exit 1;;
esac

# [IDENTITY HARD RULE] Also block the personal identity appearing in STAGED CONTENT,
# not just in the commit author. The author check above cannot catch a personal
# address pasted into a doc, a ledger table, an email template or app copy, which
# is exactly the mistake this caught in crowagent-platform on 2026-07-21.
# CLAUDE.md and the hooks themselves are excluded: they must NAME the pattern in
# order to forbid it.
__pn="Bhavesh Parihar"; __pm="bhavesh.parihar@gmail.com"
if git diff --cached -U0 -- . ":(exclude)CLAUDE.md" ":(exclude)**/CLAUDE.md" ":(exclude).husky/**" | grep -iF "$__pm" >/dev/null 2>&1; then
  echo "BLOCKED: staged content contains the personal Gmail ($__pm). Use platform@velstrian.com." >&2; exit 1
fi
if git diff --cached -U0 -- . ":(exclude)CLAUDE.md" ":(exclude)**/CLAUDE.md" ":(exclude).husky/**" | grep -iF "$__pn" >/dev/null 2>&1; then
  echo "BLOCKED: staged content contains the owner's personal name ($__pn). Use 'Velstrian Tenderworks'." >&2; exit 1
fi

# [R284-AGENT-GUARDRAILS-01 2026-10-09] The shared guardrail checker lives in crowagent-platform.
# It FAILS CLOSED: if the checker cannot be found, the commit is refused rather than passed.
__g="../crowagent-platform/scripts/guardrails/guardrails.mjs"
if [ ! -f "$__g" ]; then
  echo "BLOCKED: guardrail checker not found at $__g. Restore crowagent-platform beside this repository." >&2; exit 1
fi
node "$__g" pre-commit || exit 1
