---
/**
 * BidWhatItDoes: what can it do for me? (/bid/, strategy 0.4 row 3).
 *
 * A LIGHT ALT band. The five things Velstrian Bid does, in the order the work
 * happens, each said the way a small business owner would say it and each
 * beside one product screen on a stage. On the home page the same five sit in
 * tabs; here a reader has come for the product, so all five are open, one row
 * each, alternating sides so the eye walks down the page.
 *
 * Every capability the previous /bid/ page described is here or in BidDetail:
 * finding work (the live sources, private tenders by upload or email),
 * deciding (the fit score and its reasons, award history), answering from your
 * own documents with every claim checked, review by guests at no seat cost,
 * and keeping track of promises after you win.
 *
 * Every number is read from site-facts.json.
 *
 * 2026-10-23, R285-WEB-PREMIUM-CARDS-01 (owner: "Stripe style bento card with
 * one side gradient colorful"): the five rows became one bento, so all five
 * are seen at once instead of a long walk down the page. Every heading and
 * every paragraph is unchanged, word for word. All five screens are now real
 * staging captures (data/product-captures.real.json), so the HTML recreations
 * and their example progress steps were retired with the rows.
 */
import Band from '../evidenced/Band.astro';
import Bento from '../ui/Bento.astro';
import { FACTS, LIVE_SOURCES, GUEST_REVIEWERS } from '../../data/site-facts';
import { PRODUCT_NAME_BID } from '../../lib/brand-names';

const fitTotal = FACTS.fit_dimensions.dimensions.reduce((a, d) => a + d.points, 0);
---

<Band tone="light-alt" class="ea-caps" labelledby="bid-what-title" id="what-it-does" wedge="left">
  <div class="ea-wrap">
    <div class="ea-head-row" data-reveal>
      <h2 class="ea-h2" id="bid-what-title">Everything from finding the work to delivering it.</h2>
      <p class="ea-lead">
        Councils, schools, housing associations, the NHS and private companies all ask for bids. {PRODUCT_NAME_BID} helps
        you with each one, step by step.
      </p>
    </div>

    <Bento
      tiles={[
        {
          size: 'lg',
          flood: 'end',
          kicker: 'Write',
          title: 'Answer every question from your own documents',
          body: 'Each answer is drafted from your past bids, policies and case studies, kept in one library that grows as you go. Every claim is checked against your documents, and you can see where each one came from.',
          capture: 'home-car-answer',
        },
        {
          kicker: 'Find',
          title: 'Find contracts that suit you',
          body: `New public contracts from ${LIVE_SOURCES} arrive every morning, already matched to your business. Sent a private tender or a request for a quote? Upload it. You find the work that actually fits.`,
          capture: 'home-cap-find',
        },
        {
          kicker: 'Decide',
          title: 'Decide which ones to go for',
          body: `Every contract gets a score out of ${fitTotal} for how well it suits you, with the reason behind each part. Award history shows who won similar work before, and what it was worth. You make the call.`,
          capture: 'bid-decide',
        },
        {
          size: 'half',
          flood: 'end',
          kicker: 'Check',
          title: 'Get a colleague to check it',
          body: `Invite people to read and comment without paying for another seat: ${GUEST_REVIEWERS.starter} on Starter, ${GUEST_REVIEWERS.pro} on Pro and ${GUEST_REVIEWERS.portfolio} on Portfolio. Nothing is sent until a person approves it.`,
          capture: 'bid-check',
        },
        {
          size: 'half',
          flood: 'end',
          kicker: 'Deliver',
          title: 'Keep track of what you promised after you win',
          body: 'Every promise survives the award. Once you win, the promises in your bid become a checklist with dates. The proof sits beside each one, so your report to the customer is ready when they ask.',
          capture: 'bid-deliver',
        },
      ]}
    />
  </div>
</Band>
