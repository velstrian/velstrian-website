---
/**
 * AboutRoles: the four reader perspectives (/about/, strategy 0.3, 0.4).
 *
 * A LIGHT ALT band. Addresses each of the four people who touch a bid:
 *   1. If you write the bid
 *   2. If you sign it off
 *   3. If you score it
 *   4. If you have to deliver it
 *
 * PLAIN WORDS FIRST (RULE 0-U, QRG fix 4, 2026-10-22). Each panel used to lead
 * with an Act section number ("Procurement Act 2023, s.52", "s.71 duty") that a
 * small business owner does not know. Each now leads with what the rule means
 * for them in everyday words, and the legal reference sits underneath as a
 * small note linked to its entry on /sources/, where the text of the rule and
 * the official link are. The figures are the ones /sources/ records: s.52 at
 * least 3 targets on a contract over 5 million pounds, s.71 a review at least
 * every 12 months, PPN 026 from 1 January 2027 at 1 million pounds inc VAT.
 */
import Band from '../evidenced/Band.astro';

type Mark = 'verified' | 'refused';

interface Role {
  id: string;
  label: string;
  heading: string;
  body: string;
  /** What it means for you, in everyday words. */
  figure: string;
  /** The rule behind it, shown small. */
  source: string;
  sourceHref?: string;
  mark: Mark;
  link?: { href: string; label: string };
}

const ROLES: Role[] = [
  {
    id: 'role-run',
    label: 'If you write the bid',
    heading: 'Promise only what you can show later',
    body: 'Whatever you promise in a bid becomes what the buyer checks you against once you win. So each answer keeps hold of the document that proves it, and still stands up a year later, not just on the day you send it.',
    figure: 'On a public contract over 5 million pounds, the buyer normally publishes at least 3 targets you will be measured on',
    source: 'The rule: Procurement Act 2023, section 52',
    sourceHref: '/sources/#s52',
    mark: 'verified',
  },
  {
    id: 'role-sign',
    label: 'If you sign it off',
    heading: 'You are the one who has to stand behind the numbers',
    body: 'A confident paragraph is not proof. Every figure in a draft either comes from your own records, with the source shown next to it, or is listed as a gap for you to fill. Nothing is rounded to make a gap disappear, so your review is shorter and you can defend what you sign.',
    figure: 'Every figure shows its proof, or is listed as a gap',
    source: 'Our rule: no figure without a source',
    mark: 'refused',
  },
  {
    id: 'role-score',
    label: 'If you score it',
    heading: 'You are deciding whether to believe a stranger',
    body: 'Each claim in a reply sits next to the document it came from. Checking it means comparing two things side by side, rather than guessing who sounds most convincing.',
    figure: 'From 1 January 2027, central government contracts tendered at 1 million pounds or more (inc VAT) must give social value, the good a supplier does locally, at least 10% of the score',
    source: 'The rule: PPN 026, the Social Value Model',
    sourceHref: '/sources/#ppn-026',
    mark: 'verified',
    link: { href: '/glossary/ppn-026', label: 'What PPN 026 means, in plain words' },
  },
  {
    id: 'role-deliver',
    label: 'If you have to deliver it',
    heading: 'You inherit somebody else’s promises',
    body: 'The promises made in the bid become the targets you are measured on. Each one stays linked to the proof behind it, month by month, so the yearly review is put together from a record rather than from memory.',
    figure: 'On those same contracts, the buyer reviews how you are doing against the targets at least once a year',
    source: 'The rule: Procurement Act 2023, section 71',
    sourceHref: '/sources/#s71',
    mark: 'verified',
  },
];
---

<Band tone="light-alt" class="ea-roles" id="roles">
  <div class="ea-wrap">
    <div class="ea-roles__stack">
      {
        ROLES.map((r, i) => (
          <section class="ea-role-row" id={r.id} data-reveal>
            <div class:list={['ea-role-grid', { 'ea-role-grid--mirror': i % 2 === 1 }]}>
              <div class="ea-role-text">
                <span class="ea-label">{r.label}</span>
                <h2 class="ea-h2 ea-role-h">{r.heading}</h2>
                <p class="ea-lead ea-role-p">{r.body}</p>
                {r.link && (
                  <p class="ea-role-link-p">
                    <a class="ea-link" href={r.link.href}>{r.link.label}</a>
                  </p>
                )}
              </div>

              <div class="surface surface--pad ea-role-art">
                <dl class={`ea-art ea-art--${r.mark}`}>
                  <dt class="ea-art__figure">{r.figure}</dt>
                  <dd class="ea-art__source">
                    <span class={`chip__dot chip__dot--${r.mark}`} aria-hidden="true" />
                    {r.sourceHref ? (
                      <a class="ea-link ea-art__ref" href={r.sourceHref}>{r.source}</a>
                    ) : (
                      <span>{r.source}</span>
                    )}
                  </dd>
                </dl>
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Band>

<style>
  .ea-roles__stack {
    display: grid;
    gap: var(--space-16);
  }

  .ea-role-row {
    scroll-margin-top: calc(var(--v3-header-h) + var(--space-8));
  }

  .ea-role-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(var(--space-6), 5vw, var(--space-16));
    align-items: start;
  }

  .ea-role-text {
    display: grid;
    gap: var(--space-4);
  }

  .ea-role-h {
    margin: 0;
  }

  .ea-role-p {
    margin: 0;
    color: var(--ea-muted);
  }

  .ea-role-link-p {
    margin: 0;
  }

  .ea-role-art {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(var(--space-6), 4vw, var(--space-10));
  }

  .ea-art {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .ea-art__figure {
    font-family: var(--font-ui);
    font-size: var(--t-ea-h3);
    font-weight: var(--t-w-ea-strong);
    line-height: 1.25;
    letter-spacing: var(--ls-ea-h3);
    color: var(--ea-ink);
  }

  .ea-art__source {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--t-micro);
    line-height: var(--lh-ea-snug);
    color: var(--ea-muted);
  }

  .ea-art__ref {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .chip__dot {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
  }

  .chip__dot--verified {
    background: var(--c-verified);
    box-shadow: 0 0 10px var(--c-verified-glow);
  }

  .chip__dot--refused {
    background: var(--c-refused);
  }

  @media (min-width: 960px) {
    .ea-role-grid--mirror .ea-role-text {
      grid-column: 2;
      grid-row: 1;
    }
    .ea-role-grid--mirror .ea-role-art {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (max-width: 959px) {
    .ea-role-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
