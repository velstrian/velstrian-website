---
/**
 * AboutVariants: two products on one platform (/about/, strategy section 0, "Two products on one platform").
 *
 * A LIGHT ALT band. Describes both sides of the procurement platform:
 * Velstrian Bid for suppliers and Velstrian Buy for buyers.
 */
import Band from '../evidenced/Band.astro';
import Action from '../evidenced/Action.astro';
import { LIVE_SOURCES } from '../../data/site-facts';

const VARIANTS = [
  {
    heading: 'Velstrian Bid',
    body: `For businesses that bid. It finds public contracts on ${LIVE_SOURCES}, and takes private requests you upload. It drafts your answers from your own documents, covers the social value questions buyers score, helps with the statement on AI use some buyers ask for (PPN 017), and after you win keeps the proof behind each target you are measured on.`,
    href: '/bid/',
    cta: 'See the supplier side',
  },
  {
    heading: 'Velstrian Buy',
    body: 'For buyers. Set out what you need, with clear social value questions, then see where each reply answers it, quoted word for word from the reply or marked as missing. Velstrian Buy puts the replies in order. Your own panel does the scoring.',
    href: '/buy/',
    cta: 'See the buyer side',
  },
];
---

<Band tone="light-alt" class="ea-variants" id="variants" labelledby="variants-title">
  <div class="ea-wrap">
    <div class="ea-head-row" data-reveal>
      <div>
        <span class="ea-label">Two sides of a contract</span>
        <h2 class="ea-h2" id="variants-title">Two products, one platform.</h2>
      </div>
      <p class="ea-lead">
        Velstrian serves both sides of a procurement, and both work in the public sector and the private sector.
      </p>
    </div>

    <div class="variants-pair">
      {
        VARIANTS.map((v) => (
          <div class="surface surface--pad variant-card" data-reveal>
            <h3 class="ea-h3 variant-card__h">{v.heading}</h3>
            <p class="variant-card__body">{v.body}</p>
            <div class="variant-card__action">
              <Action href={v.href} variant="secondary">{v.cta}</Action>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Band>

<style>
  .variants-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .variant-card {
    padding: clamp(var(--space-6), 4vw, var(--space-8));
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .variant-card__h {
    margin: 0;
  }

  .variant-card__body {
    margin: 0;
    font-size: var(--t-ea-body);
    line-height: var(--lh-ea-body);
    color: var(--ea-muted);
  }

  .variant-card__action {
    margin-top: var(--space-2);
  }

  @media (max-width: 767px) {
    .variants-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
