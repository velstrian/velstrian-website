---
/**
 * AboutHero: who Velstrian is and why it exists (/about/, strategy 0.3, 0.4, 0.8).
 *
 * A LIGHT band. Opens with the plain sentence: "Written for the people who write bids. Readable by
 * the people who score them." Lead names the four roles. Two action buttons: Book a
 * 30-minute call (primary) and Send a question (secondary). A note naming the company
 * behind it, linked to its public record so a reader can check it (QRG fix 1, D279: the
 * company, not people, and no claim a reader cannot check). Four navigation chips for the
 * four readers, and an evidenced tender review screen floating on the stage beneath.
 */
import Band from '../evidenced/Band.astro';
import Action from '../evidenced/Action.astro';
import Stage from '../evidenced/Stage.astro';
import Frame from '../evidenced/Frame.astro';
import { WALKTHROUGH_URL } from '../../data/app';
import { LEGAL_ENTITY_NAME, COMPANY_NUMBER } from '../../lib/brand-names';

const COMPANIES_HOUSE = `https://find-and-update.company-information.service.gov.uk/company/${COMPANY_NUMBER}`;

const ROLES = [
  { id: 'role-run', label: 'If you write the bid', mark: 'verified' },
  { id: 'role-sign', label: 'If you sign it off', mark: 'refused' },
  { id: 'role-score', label: 'If you score it', mark: 'verified' },
  { id: 'role-deliver', label: 'If you have to deliver it', mark: 'verified' },
];
---

<Band tone="light" class="ea-hero" labelledby="about-hero-title">
  <div class="ea-wrap ea-hero__head">
    <h1 class="ea-hero__title" id="about-hero-title">
      Written for the people who write bids. <span class="ea-accent">Readable by the people who score them.</span>
    </h1>
    <p class="ea-lead ea-hero__lead">
      Every bid, public or private, passes through four people, and each wants something different. You might write it, sign it off, score it or deliver the work. Pick yours below.
    </p>

    <div class="ea-actions">
      <Action href={WALKTHROUGH_URL} newWindow>Book a 30-minute call</Action>
      <Action href="/contact/#contact-form" variant="secondary">Send a question</Action>
    </div>

    <nav class="about-chips" aria-label="The four readers this page addresses">
      <ul class="about-chips__list">
        {
          ROLES.map((r) => (
            <li>
              <a class="control rolelink" href={`#${r.id}`}>
                <span class={`chip__dot chip__dot--${r.mark}`} aria-hidden="true" />
                <span>{r.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="ea-hero__note">
      Made by {LEGAL_ENTITY_NAME}, a UK company registered in England and Wales, number {COMPANY_NUMBER}.
      <a class="ea-link" href={COMPANIES_HOUSE} target="_blank" rel="noopener noreferrer">Check the public record on Companies House<span class="visually-hidden"> (opens in a new window)</span></a>
    </p>
  </div>

  <div class="ea-wrap">
    <Stage layout="hero">
      <Frame
        title="One answer, four readers"
        status="Proof attached"
        capture="about-hero"
        caption="One answer seen by all four people: where it came from, a figure with no proof flagged, the buyer's score and the promises to deliver."
      >
        <div class="ea-app-split">
          <ol class="ea-app-qs">
            <li class="is-current">
              <span>Section 3.1: What you give back locally (social value)</span>
              <span class="ea-chip ea-chip--ok">Evidenced</span>
            </li>
            <li>
              <span>Section 4.2: Keeping information secure</span>
              <span class="ea-chip ea-chip--ok">Verified</span>
            </li>
            <li>
              <span>Section 5.1: How you will report progress</span>
              <span class="ea-chip ea-chip--ok">Assessed</span>
            </li>
            <li>
              <span>Section 6.3: Delivery timetable</span>
              <span class="ea-chip">On track</span>
            </li>
          </ol>
          <div class="ea-app-answer">
            <p class="ea-label">If you write it: an answer that shows where it came from</p>
            <p>
              We provide two apprenticeships per contract year, recruited from the local borough. Every milestone traces to our existing apprenticeship partnership agreement. <span class="ea-src-chip">Apprenticeship Agreement 2026, clause 3.2</span>
            </p>
            <p class="ea-label">If you sign it off: any figure without proof is flagged</p>
            <p>
              Draft figure "99.8% customer retention" checked against your records: <span class="ea-chip ea-chip--held">No proof found: left as a gap to fill</span>
            </p>
            <p class="ea-label">If you score it: the claim sits next to its proof</p>
            <p>
              The proof matches what the buyer asked for. The score is the buyer's own: <span class="ea-chip ea-chip--ok">Panel score: 95 / 100</span>
            </p>
            <p class="ea-label">If you deliver it: every promise you made, tracked</p>
            <p>
              What you promised, kept ready for the yearly review: <span class="ea-chip ea-chip--ok">3 published targets tracked</span>
            </p>
          </div>
        </div>
      </Frame>
    </Stage>
  </div>
</Band>

<style>
  .ea-hero__head {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .about-chips {
    margin-top: var(--space-6);
  }

  .about-chips__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .rolelink {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.2;
    text-decoration: none;
    color: var(--ea-ink);
  }

  .chip__dot {
    flex: 0 0 auto;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
  }

  .chip__dot--verified {
    background: var(--c-verified);
    box-shadow: 0 0 10px var(--c-verified-glow);
  }

  .chip__dot--refused {
    background: var(--c-refused);
  }

  /* One sentence that wraps as text. The shared .ea-hero__note is inline-flex
     (it puts a tick beside its words on /resources/), and .ea-link is
     inline-flex too, so here the sentence and the link became two flex items
     side by side and the link squeezed into a four line column at 1440. */
  .ea-hero__note {
    display: block;
    max-width: 62ch;
    text-wrap: balance;
    margin-top: var(--space-2);
    font-size: var(--t-micro);
    line-height: var(--lh-ea-snug);
    color: var(--ea-muted);
  }

  .ea-hero__note .ea-link {
    display: inline;
    min-height: 0;
  }

  @media (max-width: 599px) {
    .about-chips__list {
      flex-direction: column;
      align-items: stretch;
    }
    .rolelink {
      justify-content: center;
    }
  }
</style>
