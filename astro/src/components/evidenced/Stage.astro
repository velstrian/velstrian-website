---
import Aurora from './Aurora.astro';

/**
 * Stage: the signature visual of design system version 3.
 *
 * A large rounded panel filled with the brand gradient, indigo into purple
 * (--stage-gradient, never red, D256), with a soft bloom of light and a fine
 * grain over it (::before and ::after in styles/evidenced.css), and an optional
 * texture image read from --stage-texture. Product UI floats on it: the default
 * slot holds the main screen at the raised elevation, and the `float` slot holds
 * a card that overlaps the stage edge at the floating elevation.
 *
 * A panel or centre stage is still. A HERO stage is the aurora
 * (R285-WEB-HERO-BACKDROP-02): its rounded ground is not drawn, and a full
 * bleed slab of living colour (Aurora.astro) runs from just under the hero's
 * reassurance line to the band's foot, so the screen and the sequence card
 * float on moving colour, the one moving light on the page.
 *
 * `layout`:
 *   hero    a wide stage, the screen inset from the top left and running out
 *           of the stage's bottom edge, the floating card over the right edge
 *   panel   the stage beside copy in a feature row, the screen inset and the
 *           floating card over the bottom left edge
 *   centre  one screen centred on the stage, nothing floating
 */
interface Props {
  layout?: 'hero' | 'panel' | 'centre';
  class?: string;
}
const { layout = 'panel', class: cls = '' } = Astro.props;
const hasFloat = Astro.slots.has('float');
---

<div class={`ea-stage ea-stage--${layout} ${hasFloat ? 'ea-stage--has-float' : ''} ${cls}`.replace(/\s+/g, ' ').trim()}>
  {layout === 'hero' && <Aurora place="stage" />}
  <div class="ea-stage__ground band--stage" aria-hidden="true"></div>
  <div class="ea-stage__screen"><slot /></div>
  {hasFloat && <div class="ea-stage__float"><slot name="float" /></div>}
</div>
