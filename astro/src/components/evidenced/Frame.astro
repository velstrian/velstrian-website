---
/**
 * Frame: a product screen, 12px radius, one title bar with the screen's name.
 * No window dots and no tilt. Version 3 (strategy 0.8): the screen is always
 * drawn LIGHT, as the app draws it (`on-light` rebinds the roles), it sits on a
 * Stage at the raised elevation, and its caption is the window's own footer, so
 * the caption reads the same on any stage or band.
 *
 * `capture` is a key in data/product-captures.ts. While that entry is null the
 * slot renders, which is an HTML recreation of the real screen, and the caption
 * opens with "Example data" so the recreation is never read as a customer
 * screenshot. When the entry is set the image replaces the slot.
 *
 * `image` is the third source, for a page that already ships its own drawn
 * product screen (the sector pages' Figma screens): the picture fills the
 * window like a capture, AVIF and WebP first, and `caption` is printed as it
 * is, because those captions already say the screen is a drawing. A `capture`
 * entry, when set, still wins.
 */
import { CAPTURES } from '../../data/product-captures';

interface Props {
  title: string;
  capture: string;
  /** Right side of the title bar, for example a status. */
  status?: string;
  /** What the recreation shows, after "Example data." */
  caption: string;
  class?: string;
  /** Id of the caption, so a section can point aria-describedby at it. */
  captionId?: string;
  /** A page's own drawn screen, used when `capture` has no entry. */
  image?: { src: string; avif?: string; webp?: string; width: number; height: number; alt: string };
}
const { title, capture, status, caption, class: cls = '', captionId, image } = Astro.props;
const captured = CAPTURES[capture] ?? null;
const shot = captured ?? (image ? { ...image, caption, narrow: undefined } : null);
/* A capture with a `view` shows only that region, scaled to the frame's width,
   so a wide screen reads at app size instead of shrinking to a strip. The
   region is data (product-captures.ts), so the CSS here never names a pixel. */
const view = captured?.view ?? null;
const cropStyle = view
  ? [
      `--fw:${shot!.width}`,
      `--fh:${shot!.height}`,
      `--wcx:${view.wide.x}`,
      `--wcy:${view.wide.y}`,
      `--wcw:${view.wide.w}`,
      `--wch:${view.wide.h}`,
      `--pcx:${view.phone.x}`,
      `--pcy:${view.phone.y}`,
      `--pcw:${view.phone.w}`,
      `--pch:${view.phone.h}`,
    ].join(';')
  : undefined;
---

<figure class={`ea-frame ${shot ? 'ea-frame--shot' : ''} ${view ? 'ea-frame--crop' : ''} ${!captured && image ? 'ea-frame--drawn' : ''} ${cls}`.replace(/\s+/g, ' ').trim()} data-capture={capture}>
  <div class="ea-frame__window on-light">
    {/* A real capture carries the app's own header, so the recreated title
        bar is drawn only over a recreation. */}
    {!shot && (
      <div class="ea-frame__bar">
        <span class="ea-frame__title">{title}</span>
        {status && <span class="ea-frame__status">{status}</span>}
      </div>
    )}
    {
      shot && view ? (
        <div class="ea-frame__crop" style={cropStyle}>
          <img
            class="ea-frame__shot"
            src={shot.src}
            width={shot.width}
            height={shot.height}
            alt={shot.alt}
            loading="lazy"
            decoding="async"
          />
        </div>
      ) : shot ? (
        <picture>
          {!captured && image?.avif && <source type="image/avif" srcset={image.avif} />}
          {!captured && image?.webp && <source type="image/webp" srcset={image.webp} />}
          {shot.narrow && <source media="(max-width: 599px)" srcset={shot.narrow.src} width={shot.narrow.width} height={shot.narrow.height} />}
          {/* The picture's proportions as numbers, so its box is sized before
              the lazy file arrives (evidenced.css .ea-frame__shot, CLS). */}
          <img
            class="ea-frame__shot"
            style={`--w0:${shot.width};--h0:${shot.height}` + (shot.narrow ? `;--wn:${shot.narrow.width};--hn:${shot.narrow.height}` : '')}
            src={shot.src}
            width={shot.width}
            height={shot.height}
            alt={shot.alt}
            loading="lazy"
            decoding="async"
          />
        </picture>
      ) : (
        <div class="ea-frame__body">
          <slot />
        </div>
      )
    }
    <figcaption class="ea-frame__caption" id={captionId}>
      {shot ? shot.caption : <><span class="ea-frame__example">Example data.</span> {caption}</>}
    </figcaption>
  </div>
</figure>
