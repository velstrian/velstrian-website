---
/**
 * Action: the one button of the design system.
 *
 * Version 3.1 (owner 2026-10-22). Primary is the BRAND fill, indigo into
 * purple with a white label, and white with indigo ink on a stage. Secondary
 * is white. Both read the --btn-p-* and --btn-s-* tokens (tokens.css, THE
 * BUTTON SYSTEM), which ui/Button.astro reads too, so the site has one button
 * whichever component drew it. One soft light sweep crosses the primary once
 * per hover (styles/evidenced.css .ea-btn--primary::after). 6px radius,
 * 48px tall. The label says what happens, and no arrow glyph is ever appended.
 * A link that opens a new window says so to a screen reader.
 *
 * With `as="button"` it renders a real <button> for an in-page action such as
 * opening the tour dialog, with `data-*` passed through for the script. A
 * form passes `type="submit"` or `type="reset"` and an `id` for its script
 * (the free tools), so a form's buttons are this button too.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  newWindow?: boolean;
  as?: 'a' | 'button';
  /** For `as="button"`: the button's type, `button` unless a form says otherwise. */
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  [key: `data-${string}`]: string | undefined;
}
const { href, variant = 'primary', newWindow = false, as = 'a', type = 'button', id, ...rest } = Astro.props;
const data = Object.fromEntries(Object.entries(rest).filter(([k]) => k.startsWith('data-')));
---

{
  as === 'button' ? (
    <button type={type} id={id} class={`ea-btn ea-btn--${variant}`} {...data}>
      <slot name="icon" />
      <span class="ea-btn__label">
        <slot />
      </span>
    </button>
  ) : (
    <a
      id={id}
      class={`ea-btn ea-btn--${variant}`}
      href={href}
      target={newWindow ? '_blank' : undefined}
      rel={newWindow ? 'noopener noreferrer' : undefined}
      {...data}
    >
      <slot name="icon" />
      <span class="ea-btn__label">
        <slot />
      </span>
      {newWindow && <span class="visually-hidden"> (opens in a new window)</span>}
    </a>
  )
}
