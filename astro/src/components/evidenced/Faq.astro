---
/**
 * Faq: I have questions (strategy section 0.4, row 7)
 *
 * The words a newcomer meets, explained once, after responsive.io's "What is
 * an RFP?". This is the one place on the home page where tender jargon (ITT,
 * RFQ, social value, PPN 026, the Procurement Act) appears, and each term is
 * explained where it appears. Native <details>, closed by default, so it works
 * with no script and every answer is in the document. The open and close mark
 * is the site's one disclosure treatment, summary::after in styles/blocks.css.
 */
import { PLATFORM_SHORT_NAME, PRODUCT_NAME_BUY } from '../../lib/brand-names';
import { FACTS, listJoin } from '../../data/site-facts';
import Band from './Band.astro';

const live = listJoin(FACTS.sources.live.map((s) => s.name));

const QA: { q: string; a: string }[] = [
  {
    q: 'What is a tender?',
    a: 'A tender is how an organisation asks businesses to bid for a piece of work. It explains what they need, asks you questions, and says how the answers will be scored. Public bodies have to advertise most of theirs, and private companies send them too.',
  },
  {
    q: 'What do ITT, RFP and RFQ mean?',
    a: 'They are names for the same idea. An invitation to tender (ITT) or a request for proposal (RFP) is a full set of questions to answer. A request for quote (RFQ) is a shorter request for a price. You can work on any of them here.',
  },
  {
    q: 'I have never written a bid. Is this for me?',
    a: `Yes. ${PLATFORM_SHORT_NAME} is made for businesses that write their own bids, with no bid writer or bid team. It drafts each answer from your past answers, checks every claim against your documents, and you read, change and approve it.`,
  },
  {
    q: 'Does it cover private work as well as public?',
    a: `Yes. Public contracts arrive every morning from ${live}. For private work, upload the tender or request you were sent, or forward the email.`,
  },
  {
    q: 'What is social value?',
    a: 'Many public contracts ask what extra good your business will do in the local area, such as jobs, training or cutting waste. That is social value, and it usually counts towards your score. Government buyers measure it using a guide called PPN 026, and the product helps you answer it from what you already do.',
  },
  {
    q: 'What happens after I win?',
    a: 'The promises in your bid become a checklist with dates, so you can show the customer what you have delivered. Under the Procurement Act 2023, public buyers now check how larger contracts are going against agreed targets, so it helps to have the proof ready.',
  },
  {
    q: 'What is an AI credit?',
    a: 'Drafting and checking answers uses AI credits. Every plan includes a monthly allowance, shown beside its price, and you can buy more if you run out.',
  },
  {
    q: 'Will it write things that are not true?',
    a: 'No. Every claim in an answer is checked against your own documents. If it cannot find proof for something, it tells you rather than guessing, and you decide what to do.',
  },
  {
    q: 'I buy services. Is there something for me?',
    a: `Yes. ${PRODUCT_NAME_BUY} helps you ask for what you need, collect the replies and see the proof behind each one. Your own team does the scoring, never the AI.`,
  },
];
---

<Band tone="light" class="ea-faq" labelledby="ea-faq-title">
  <div class="ea-wrap ea-faq__wrap">
    <h2 class="ea-h2 ea-h2--centre" id="ea-faq-title" data-reveal>New to bidding? Start here.</h2>
    <div class="ea-faq__list" data-reveal>
      {
        QA.map((item) => (
          <details class="ea-qa">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
      <p class="ea-faq__more"><a class="ea-link" href="/faq/">Read every question</a></p>
    </div>
  </div>
</Band>
