---
/**
 * Faq: I have questions (strategy section 0.4, row 7)
 *
 * The words a newcomer meets, explained once, after responsive.io's "What is
 * an RFP?". This is the one place on the home page where tender jargon (ITT,
 * RFQ, social value, PPN 026, the Procurement Act) appears, and each term is
 * explained where it appears. Native <details>, closed by default, so it works
 * with no script and every answer is in the document. The open and close mark
 * is the site's one disclosure treatment, summary::after in styles/blocks.css.
 */
import { HOME_FAQS } from '../../data/home-faq';
import Band from './Band.astro';
---

<Band tone="light" class="ea-faq" labelledby="ea-faq-title">
  <div class="ea-wrap ea-faq__wrap">
    <h2 class="ea-h2 ea-h2--centre" id="ea-faq-title" data-reveal>New to bidding? Start here.</h2>
    <div class="ea-faq__list" data-reveal>
      {
        HOME_FAQS.map((item) => (
          <details class="ea-qa">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
      <p class="ea-faq__more"><a class="ea-link" href="/faq/">Read every question</a></p>
    </div>
  </div>
</Band>
