---
import Aurora from './Aurora.astro';
import Icon from './Icon.astro';

/**
 * Band: one section of a page, at one temperature.
 *
 * Design system version 3 (strategy section 0.8). A page is a run of bands that
 * alternate light and dark, each section its own temperature. The tone is a
 * class from tokens.css (.band--light, .band--light-alt, .band--dark) that
 * REBINDS THE ROLES for everything inside, so a component never asks which band
 * it is on: an Action, a Frame, a TabSwitcher or a FactsBand paints correctly on
 * any of them.
 *
 * Content marked `data-reveal` inside a band settles in on first view
 * (scripts/evidenced.ts initReveal), opacity and a 24px rise, 640ms, 80ms
 * between items, once, never under reduced motion, and never for anything
 * already on screen at load.
 *
 * A band carrying the `ea-hero` class gets the hero's sky behind its content
 * (.ea-hero__sky in styles/evidenced.css): a fine grid fading out from the top
 * centre, and the aurora ribbon at the band's foot (Aurora.astro, place
 * "foot"). A hero whose Stage carries the full aurora hides the ribbon, so one
 * mechanism serves every v3 hero, on the home page, /bid/, /buy/, /about/ and
 * every page hero, without any of them asking for it.
 *
 * The aurora keeps moving (owner decision D293), so the same hero band carries
 * its pause button (.ea-motion in styles/evidenced.css), last in the band so
 * it comes after the hero's own actions in the tab order. A toggle: the name
 * stays "Pause background motion" and aria-pressed says whether it is paused.
 * It ships hidden and scripts/evidenced.ts initAurora shows it only when the
 * loops can run, and one press stops every aurora loop on the page for the
 * rest of the session.
 *
 * Ready for /bid/, /buy/ and the shared page templates: it knows nothing about
 * the home page.
 */
interface Props {
  tone: 'light' | 'light-alt' | 'dark';
  id?: string;
  /** Id of the band's heading. */
  labelledby?: string;
  class?: string;
  /** Tight top, for a band that follows a hero with no gap of its own. */
  flush?: boolean;
}
const { tone, id, labelledby, class: cls = '', flush = false } = Astro.props;
const hero = cls.split(/\s+/).includes('ea-hero');
const MOTION_LABEL = 'Pause background motion';
---

<section
  class={`ea-sec band band--${tone} ${flush ? 'band--flush' : ''} ${cls}`.replace(/\s+/g, ' ').trim()}
  id={id}
  aria-labelledby={labelledby}
  data-band={tone}
>
  {hero && <div class="ea-hero__sky" aria-hidden="true"><Aurora place="foot" /></div>}
  <slot />
  {
    hero && (
      <button class="ea-motion" type="button" data-aurora-pause aria-pressed="false" aria-label={MOTION_LABEL} hidden>
        <Icon name="pause" size={20} class="ea-motion__pause" />
        <Icon name="resume" size={20} class="ea-motion__play" />
      </button>
    )
  }
</section>

{/* The one entry for every v3 behaviour (reveal, sequences, carousels, tour,
    citations, refusal). It lives here because every v3 section is a Band, so
    Astro bundles it ONCE for any page built from them, instead of one entry
    per page (two entries split evidenced.ts into an extra chunk and broke the
    JS budget by 3 bytes, 2026-10-22). A bundled script is a module and runs
    after parse, so no readiness check is needed. */}
<script>
  import { initEvidenced } from '../../scripts/evidenced';

  initEvidenced();
</script>
