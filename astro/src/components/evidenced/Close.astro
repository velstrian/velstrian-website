---
/**
 * Close: what now? (strategy 0.4 row 8, visual 0.8)
 *
 * The gradient close band. A stage gradient panel that sits ACROSS the change
 * from the last light band into the dark footer: the section's own ground is
 * light above the panel's middle and the footer's dark below it, so the panel
 * overlaps the transition, after the reference. One sentence, two actions,
 * white on the gradient.
 *
 * The default speaks to a supplier (home and /bid/). /buy/ passes its own
 * title, lead and primary action, because a buyer is not writing a bid. A page
 * whose second action is not a call (/integrations/: View all pricing) passes
 * `secondary`, which replaces Book a call.
 */
import Action from './Action.astro';
import { SIGNUP_URL, WALKTHROUGH_URL, START_LABEL } from '../../data/app';
import { TRIAL_DAYS } from '../../data/pricing';

interface Props {
  title?: string;
  lead?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string; newWindow?: boolean };
}

const {
  title = 'Your next bid can start today.',
  lead = `Try it free for ${TRIAL_DAYS} days, or talk it through with us first.`,
  primary = { href: SIGNUP_URL, label: START_LABEL },
  secondary = { href: WALKTHROUGH_URL, label: 'Book a call', newWindow: true },
} = Astro.props;
---

<section class="ea-sec ea-close band--light" aria-labelledby="ea-close-title" data-band="close">
  <div class="ea-wrap">
    <div class="ea-close__panel band--stage" data-reveal>
      <div class="ea-close__copy">
        <h2 class="ea-h2 ea-close__title" id="ea-close-title">{title}</h2>
        <p class="ea-lead ea-close__lead">{lead}</p>
        <div class="ea-actions">
          <Action href={primary.href}>{primary.label}</Action>
          <Action href={secondary.href} variant="secondary" newWindow={secondary.newWindow ?? false}>{secondary.label}</Action>
        </div>
      </div>
    </div>
  </div>
</section>
