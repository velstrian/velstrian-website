---
/**
 * Steps: how hard is it to start? (strategy 0.4 row 5)
 *
 * A DARK band. Three steps, a real sequence, so they are numbered, in hairline
 * columns with a gradient icon tile each. Formats and file sizes are read from
 * site-facts.json.
 *
 * The default is the supplier's start (home and /bid/). A page for another
 * reader passes its own `steps` and `action`, for example /buy/ for buyers,
 * so a buyer is never told to download a bid.
 */
import Band from './Band.astro';
import IconTile from './IconTile.astro';
import Action from './Action.astro';
import { SIGNUP_URL, START_LABEL } from '../../data/app';
import { START_FORMATS, START_MAX_MB, PACK_MAX_MB } from '../../data/site-facts';
import FlashCards from '../ui/FlashCards.astro';
import type { IconName } from '../../data/icons';

interface Step { icon: IconName; title: string; body: string }
interface Props {
  steps?: Step[];
  action?: { href: string; label: string };
  /**
   * Show the steps as FlashCards in steps mode (D305 lane C pilot, /bid/ only):
   * the highlight walks the three steps once and rests, with a pause button,
   * and never moves under reduced motion or on a phone. Off by default, so
   * the home page and /buy/ are unchanged until the owner judges the pilot.
   */
  flash?: boolean;
}

const SUPPLIER_STEPS: Step[] = [
  { icon: 'document', title: 'Add what you already have',
    body: `Your past answers, and the policies and case studies that prove them, as ${START_FORMATS} files up to ${START_MAX_MB} MB each.` },
  { icon: 'upload', title: 'Add a contract',
    body: `Pick one from your matches, or upload one you were sent. Whole tender packs can be up to ${PACK_MAX_MB} MB a file.` },
  { icon: 'pen', title: 'Answer the questions',
    body: 'Read each drafted answer, change what you like, then download your bid as a PDF or Word file.' },
];

const {
  steps = SUPPLIER_STEPS,
  action = { href: SIGNUP_URL, label: START_LABEL },
  flash = false,
} = Astro.props;
const cards = steps.map((s, i) => ({ id: `start-${i + 1}`, title: s.title, summary: s.body, icon: s.icon }));
---

<Band tone="dark" class="ea-steps" labelledby="ea-steps-title">
  <div class="ea-wrap">
    <h2 class="ea-h2" id="ea-steps-title" data-reveal>Start in three steps.</h2>
    {flash ? (
      <div class="ea-steps__flash" data-reveal>
        <FlashCards label="The three steps to start" cards={cards} mode="steps" interval={7000} columns={3} />
      </div>
    ) : (
      <ol class="ea-steps__list">
        {steps.map((s, i) => (
          <li class="ea-step" data-reveal>
            <IconTile name={s.icon} />
            <h3 class="ea-h3"><span class="ea-step__n">{i + 1}.</span> {s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    )}
    <div class="ea-actions" data-reveal>
      <Action href={action.href}>{action.label}</Action>
    </div>
  </div>
</Band>
