---
/**
 * PostImage: the cover a blog post shows on /blog/ and at the top of the post.
 *
 * ── THE PHOTOGRAPHS ARE GONE, 2026-10-22, OWNER DECISION D283 ──────────────
 *
 * Until today this component drew a licensed stock photograph per post from
 * /Assets/blog-photos (an AVIF, WebP and JPEG ladder looked up in heroes.ts).
 * The owner judged the stock photography "cheap" (2026-10-21), the website
 * transformation audit (M6) measured all twelve thumbnails as generic office,
 * calendar and Westminster scenes that said nothing about the article, and D283
 * replaced them with a type led cover drawn from the design system. So this is
 * now a thin wrapper over TypeCover: the post's words, its category and a motif
 * for that category, sized by its own box and costing no image bytes.
 *
 * The file and its name are kept so the three call sites (the featured card,
 * the ledger row and Article.astro) stay one import, and so the history of the
 * photograph decision above stays findable from the component that held it.
 * blog/PHOTO-CREDITS.md keeps the provenance record of the retired photographs.
 *
 * NO LAYOUT SHIFT. The cover is a 16:9 (or 3:1 banner) box drawn in CSS, so its height is known
 * before any byte arrives. There is nothing to load.
 *
 * THERE IS DELIBERATELY NO `class` PROP: Astro does not stamp a parent's scope
 * onto a child's root, so a forwarded class renders and does nothing. Callers
 * wrap this component in an element of their own and style that.
 */
import TypeCover from './TypeCover.astro';
import { coverForPost } from './covers';

interface Props {
  /** Post slug, used to look up the short line in covers.json. */
  slug: string;
  /** The post title, the line when covers.json has none for this slug. */
  title: string;
  /** The post category: the label, and the family the cover is drawn in. */
  category: string;
  /** The banner shape for the top of a post (see TypeCover). */
  wide?: boolean;
}

const { slug, title, category, wide = false } = Astro.props;
const cover = coverForPost(slug, title, category);
---

<TypeCover cover={cover} wide={wide} />
