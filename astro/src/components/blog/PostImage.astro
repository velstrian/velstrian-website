---
/**
 * PostImage: the picture a blog post shows on /blog/ and at the top of the post.
 *
 * ── A HYBRID, 2026-10-23, OWNER DIRECTION D305 ─────────────────────────────
 *
 * A post registered in heroes.ts shows its licensed photograph. A post with no
 * entry shows its designed cover (TypeCover, data in covers.json). Every post
 * published before 2026-10-23 has a photograph, so a designed cover appears for
 * a post added from now on until somebody licenses a photograph for it, and
 * that post can never ship with a hole in its row.
 *
 * History, kept because it explains the shape. Until 2026-10-22 this component
 * drew only photographs, through a five layer "treatment" that was removed on
 * 2026-08-04 because it faded every picture (the owner: the pictures "must be
 * clear" and "visible in color"). Commit c4379ba6 (D283, 2026-10-22) replaced
 * every photograph with a type led cover. D305 brings the photographs back for
 * the posts that have one and keeps the cover for the posts that do not. The
 * social card stays the type led cover for every post (D305 decision D5).
 *
 * The photograph is shown with NO filter and NO overlay. The only chrome is a
 * 1px edge drawn ABOVE the picture by a pseudo element, which covers no part
 * of the photograph's interior, so it cannot fade it.
 *
 * SELF HOSTED. Every candidate resolves under /Assets, so the build's zero
 * external origin property holds. scripts/copy-assets.js copies by
 * reachability, so a file nothing references never ships.
 *
 * THERE IS DELIBERATELY NO `class` PROP: Astro does not stamp a parent's scope
 * onto a child's root, so a forwarded class renders and does nothing. Callers
 * wrap this component in an element of their own and style that.
 */
import TypeCover from './TypeCover.astro';
import { coverForPost } from './covers';
import { heroOrNull } from './heroes';

interface Props {
  /** Post slug: looks up the photograph, or the cover's short line. */
  slug: string;
  /** The post title, the cover's line when covers.json has none for this slug. */
  title: string;
  /** The post category: the cover's label and family. */
  category: string;
  /** The `sizes` attribute for a photograph. Required: a wrong one downloads the wrong file. */
  sizes: string;
  /** Above the fold: eager plus a high fetch priority. Default is lazy. */
  priority?: boolean;
  /**
   * Rendered box geometry for the width and height attributes. They describe
   * the BOX the browser reserves, not the source file, which is what stops the
   * page shifting when the picture arrives.
   */
  boxWidth?: number;
  boxHeight?: number;
  /** The banner shape for a designed cover at the top of a post (see TypeCover). */
  wide?: boolean;
  /**
   * The cover sits right beside a headline that already says what its line
   * would say (the featured card on /blog/), so it shows its motif alone.
   */
  quiet?: boolean;
}

const {
  slug,
  title,
  category,
  sizes,
  priority = false,
  boxWidth = 1600,
  boxHeight = 900,
  wide = false,
  quiet = false,
} = Astro.props;

const hero = heroOrNull(slug);
const cover = hero ? null : coverForPost(slug, title, category);
const base = hero ? `/Assets/blog-photos/${hero.file}` : '';

/*
 * The AVIF ladder on disk for every hero, written by scripts/build-blog-photos.mjs
 * and nothing else. Listed rather than derived so adding a width means adding the
 * file first.
 *
 * D455, A-439 (2026-10-26): the WebP tier was retired from this picture. The
 * fallback chain is AVIF, then the JPEG in <img src>, and that covers every
 * browser: AVIF ships in Chrome 85+, Firefox 93+, Edge 121+ and Safari 16.4+,
 * and every other browser takes the JPEG. A third format here bought nothing a
 * reader could see except for the small cohort on Safari 14 to 16.3, who now get
 * the JPEG (at most 245 KB, lazy loaded) instead of a WebP. It removed 48 files
 * and 1,513.9 KB from the build, measured on dist. The WebP files stay on disk
 * under Assets/ and copy-assets.js only copies what a page references.
 */
const WIDTHS = [400, 600, 800, 1200] as const;
const srcset = (ext: 'avif') => WIDTHS.map((w) => `${base}-${w}w.${ext} ${w}w`).join(', ');
---

{
  hero ? (
    <div class="pi">
      <picture>
        <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
        <img
          class="pi__img"
          src={`${base}.jpg`}
          alt={hero.alt}
          width={boxWidth}
          height={boxHeight}
          sizes={sizes}
          loading={priority ? 'eager' : 'lazy'}
          decoding={priority ? 'sync' : 'async'}
          fetchpriority={priority ? 'high' : undefined}
        />
      </picture>
    </div>
  ) : (
    cover && <TypeCover cover={cover} wide={wide} quiet={quiet} />
  )
}

<style>
  .pi {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    /* One ratio for every blog photograph, hero and thumbnail alike. */
    aspect-ratio: 16 / 9;
    /* The colour an unloaded picture shows, so a slow network sees a quiet
       panel and not a white hole. */
    background: var(--cover-mist);
    isolation: isolate;
  }

  /* No filter, and the absence is the decision (see the note above). */
  .pi__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The edge, drawn in the cover ink like TypeCover's, so a photograph and a
     designed cover in the same register share one boundary. Above the picture,
     1px, no fill. */
  .pi::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--cover-ink-on-light) 9%, transparent);
  }

  @media (forced-colors: active) {
    .pi {
      border: 1px solid CanvasText;
    }
  }
</style>
