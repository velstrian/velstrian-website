---
/**
 * BuyDetail: expert detail, lower down (/buy/, strategy 0.4 "expert detail lives on those pages lower down").
 *
 * A LIGHT ALT band. Keeps every capability described in the previous buy page (RULE 0-U),
 * explained in plain words the first time it appears:
 *
 *   1. The rules for public buying (Procurement Act 2023 s.52, s.71, PPN 026, transparency return)
 *   2. How delivery is rated: the 5 fixed bands
 *   3. Alongside your portal, not instead of it (what it does and does not do)
 *   4. The sixteen parts of the buyer workspace
 *
 * ── ONE TAP EACH, NOTHING REMOVED (R285-WEB-TRANSFORMATION-WT-E, audit S2) ──
 *
 * Measured 2026-10-22 /buy/ was 15,275px tall at 1440 and 22,865px at 375, and
 * this band carried twenty open cards a first time buyer does not need to
 * start. Every rule and every workspace part is still here, in the document,
 * behind a native <details> row (the site's one disclosure recipe, `.ea-qa`
 * plus the shared `summary::after` mark in styles/blocks.css), closed by
 * default and with no script. Each row keeps its heading element inside the
 * summary, because check-content-parity.js tracks the headings.
 *
 * 2026-10-23, D305 lane E1: the sixteen workspace parts are now FlashCards
 * (components/ui/FlashCards.astro, manual, no script), as the twelve
 * capabilities on /bid/ are: a one line headline and one plain sentence each,
 * with the same full text behind "Read in full". The rules keep their rows.
 *
 * The five delivery bands stay open because they ARE the structure, a scale
 * read left to right. What it does set against what it does not is one tap,
 * under its heading "Alongside your portal, not instead of it." and the one
 * sentence that carries the point; at 375 the two lists alone were about
 * 1,200px.
 */
import Band from '../evidenced/Band.astro';
import IconTile from '../evidenced/IconTile.astro';
import FlashCards, { type FlashCard } from '../ui/FlashCards.astro';
import { PRODUCT_NAME_BUY, PRODUCT_NAME_BID } from '../../lib/brand-names';
import { BUYER_PLANS } from '../../data/pricing';

const [BUYER_PRO] = BUYER_PLANS;

const RULES = [
  {
    heading: 'Procurement Act 2023, section 52',
    body: `Public contracts with an estimated value above £5m must have at least three published key performance indicators, the targets the contract is measured against. ${PRODUCT_NAME_BUY} flags this threshold, counts your published targets and shows any shortfall.`,
  },
  {
    heading: 'Section 71 performance assessment',
    body: `Performance against those published targets must be assessed and published. ${PRODUCT_NAME_BUY} keeps the targets beside your delivery records, so the assessment comes straight from the record for the life of the contract.`,
  },
  {
    heading: 'PPN 026 and social value',
    body: 'Social value is the extra good your supplier delivers locally. PPN 026, the guidance on the Social Value Model, applies to central government procurements commenced on or after 1 January 2027 at £1m inc VAT or above. Totals are worked out in code from a library of measures aligned to National TOMs conventions. National TOMs (Themes, Outcomes and Measures) is a common UK way to count social value. It is not a full National TOMs implementation.',
  },
  {
    heading: 'Transparency and award notice returns',
    body: 'An award notice return is the public record of who won. It is put together from your recorded contracts for you to review and publish. The reports behind it export cleanly for committee packs or scrutiny requests.',
  },
];

const BANDS = [
  { value: '≥ 95%', label: 'On track', tone: 'on' },
  { value: '80 to 94%', label: 'At risk', tone: 'risk' },
  { value: '< 80%, no deadline passed', label: 'Not yet due', tone: 'none' },
  { value: '< 80%, deadline passed', label: 'Breached', tone: 'breach' },
  { value: 'Nothing committed', label: 'No data, never green', tone: 'none' },
];

const SCOPE_DOES = [
  'Builds and publishes a social value requirement with a scoring guide fixed in advance',
  'Finds the proof for each published question, quoted word for word from the reply',
  'Gives the panel one place to score against the scoring guide you published',
  'Invites suppliers to respond by personal link, with a receipt for every reply and one list of questions and answers for all of them',
  'Runs Quick RFQ for smaller requests: a request for quotes sent by personal link and the quotes collected in one place',
  'Records awarded contracts and the promises made in them',
  'Adds up what was promised against what was delivered, by theme, and flags under delivery',
  'Assembles the Procurement Act 2023 award notice return for you to publish',
];

const SCOPE_DOES_NOT = [
  'Score, rank or recommend a mark on any reply',
  'Replace Jaggaer, Atamis, In-tend, ProContract or Proactis as your system of record',
  'Publish your formal tender notices. Those go on Find a Tender or through your e-sourcing portal',
  'Hold the formal competition audit trail, which stays in your e-sourcing system',
  'Give legal advice. The checks against the rules guide you',
  'Form or publish a view on a supplier standing',
];

const SURFACES = [
  {
    heading: 'Requirements',
    summary: 'Set what you measure and how much it counts.',
    body: 'Social value requirement packs. Set what you will measure and how much each part counts, before any reply arrives.',
  },
  {
    heading: 'Quick RFQ',
    summary: 'A short request for quotes for smaller jobs.',
    body: 'For smaller jobs, describe the work and check the scope. Then download a request for quotes and send it to suppliers by personal link. Each supplier uploads a quote and gets a receipt. You write the scope. The AI does not draft it.',
  },
  {
    heading: 'Supplier invitations and clarifications',
    summary: 'Personal links, and every answer sent to all.',
    body: 'Invite suppliers to respond by personal link. Each reply gets a receipt, and the answer to any supplier question is published to every invited supplier without saying who asked.',
  },
  {
    heading: 'Evaluations',
    summary: 'Your evaluators score against the published guide.',
    body: 'Score supplier bids against the scoring guide for the requirement. Your evaluators set every score. The AI check for uneven scoring only advises and never changes a number.',
  },
  {
    heading: 'Evaluation pre-read',
    summary: 'Finds the proof for each question you asked.',
    body: 'A first read of each reply that finds the proof for each published question. It never scores.',
  },
  {
    heading: 'Prices side by side',
    summary: 'Every bid as one total cost, like for like.',
    body: 'Enter each supplier price schedule to see every bid as one whole life cost, the total over the same term and the same amount of work, then set options side by side and record what your team judges.',
  },
  {
    heading: 'Whole life costs',
    summary: 'Each option costed across its whole life.',
    body: 'Cost each way of delivering a requirement across its whole life, from assumptions you supply.',
  },
  {
    heading: 'Pipeline',
    summary: 'Every purchase you are running, in one list.',
    body: 'Every procurement you are planning, running, scoring, awarding or managing, with dates and value worked out from your own records.',
  },
  {
    heading: 'Supplier screening',
    summary: 'Public register checks, and you decide.',
    body: 'Checked against public registers when a reply arrives or a supplier joins an evaluation. It is not a score and never excludes a supplier. You decide.',
  },
  {
    heading: 'Supplier risk',
    summary: 'Risk signals across your suppliers, in one view.',
    body: 'Risk signals across your suppliers, with platform records kept apart from flags raised by your team.',
  },
  {
    heading: 'Working with your suppliers',
    summary: 'Scorecards, reviews and shared actions.',
    body: 'Supplier relationship management in one place: scorecards, review meetings and shared actions per supplier, every open action in one table, and feedback each quarter.',
  },
  {
    heading: 'Savings you can show',
    summary: 'Savings claimed, and what finance signed off.',
    body: 'Value realisation: the savings and other value claimed against each supplier, and what finance has signed off.',
  },
  {
    heading: 'Contracts',
    summary: 'Each contract and its social value promises.',
    body: 'Awarded contracts and their social value promises, recorded so delivery has something to be measured against.',
  },
  {
    heading: 'Suppliers',
    summary: 'Each supplier’s delivery record, in one list.',
    body: 'Your supplier directory and each supplier’s delivery record across the contracts you have awarded.',
  },
  {
    heading: 'Social value oversight',
    summary: 'Promised against delivered, with an alert.',
    body: 'Social value promised against delivered across your awarded contracts and suppliers, by National TOMs theme, with under delivery raised as an alert.',
  },
  {
    heading: 'Transparency and reports',
    summary: 'The award notice return and committee reports.',
    body: 'A Procurement Act 2023 award notice return across your contracts, plus reports to export for committee and scrutiny.',
  },
];
/* The sixteen as flash cards (D305 lane E1, 2026-10-23, the /bid/ pilot
   carried over): a one line headline and one plain sentence on show, the full
   text one tap away in the card's own <details>, still in the HTML. Manual, so
   no script.
   TRIMMED 2026-10-23 (D305 trim lane): each sentence cut to about eight
   plain words, because the cards raised first view words. The detail it
   dropped is in the card body, word for word. */
const SURFACE_CARDS: FlashCard[] = SURFACES.map((s, k) => ({
  id: `part-${k + 1}`,
  title: s.heading,
  summary: s.summary,
  body: s.body,
}));
---

<Band tone="light-alt" class="ea-detail" labelledby="buy-detail-title" id="procurement-rules">
  <div class="ea-wrap">
    <div class="ea-head-row" data-reveal>
      <h2 class="ea-h2" id="buy-detail-title">The detail, for when you need it.</h2>
      <p class="ea-lead">
        You do not need any of this to start. Open a line when a rule comes up, and read every part of {PRODUCT_NAME_BUY}.
      </p>
    </div>

    {/* Group 1: the rules, one tap each */}
    <div class="buy-group" data-reveal>
      <div class="buy-group__side">
        <p class="ea-label buy-group__label">The rules for public buying</p>
        <p class="buy-group__intro">Four duties and notes that apply to public contracts, each in plain words.</p>
      </div>
      <div class="buy-rows">
        {
          RULES.map((r) => (
            <details class="ea-qa">
              <summary><h3 class="buy-row__h">{r.heading}</h3></summary>
              <p>{r.body}</p>
            </details>
          ))
        }
      </div>
    </div>

    {/* Group 2: the delivery bands, a scale, left open at full width so each
        band's phrase sits on one or two lines */}
    <div class="buy-group buy-group--wide" data-reveal>
      <div class="buy-group__side">
        <p class="ea-label buy-group__label">How delivery is rated</p>
        <p class="buy-group__intro">
          What a supplier delivered against what they promised, worked out in code on five fixed bands, per theme and per contract.
        </p>
      </div>
      <ul class="buy-bands" role="list">
        {
          BANDS.map((b) => (
            <li class={`buy-band buy-band--${b.tone}`}>
              <span class="buy-band__val">{b.value}</span>
              <span class="buy-band__lbl">{b.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Group 3: what it does against what it does not, left open */}
    <div class="buy-section" data-reveal>
      <h3 class="ea-h3">Alongside your portal, not instead of it.</h3>
      <p class="buy-group__intro">
        Your competition keeps running where it runs today. {PRODUCT_NAME_BUY} is the social value and scoring layer beside it.
      </p>
      <details class="ea-qa buy-scope-row">
        <summary><span>What it does, and what it does not do</span></summary>
      <div class="buy-scope">
        <div class="ea-card buy-scope__col buy-scope__col--does">
          <h4 class="ea-h3">What it does</h4>
          <ul class="buy-ticks">
            {SCOPE_DOES.map((d) => <li>{d}</li>)}
          </ul>
        </div>
        <div class="ea-card buy-scope__col buy-scope__col--not">
          <h4 class="ea-h3">What it does not do</h4>
          <ul class="buy-ticks">
            {SCOPE_DOES_NOT.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </div>
      </details>
    </div>

    {/* Group 4: every part of the workspace, one tap each */}
    <div class="buy-section" id="workspace" data-reveal>
      <h3 class="ea-h3">Every part of the buyer workspace</h3>
      <p class="buy-group__intro">All {SURFACES.length} parts, from writing the request to reporting on delivery.</p>
      <div class="buy-surfaces">
        <FlashCards label={`Every part of ${PRODUCT_NAME_BUY}`} cards={SURFACE_CARDS} columns={4} />
      </div>
    </div>

    {/* Onward links */}
    <div class="buy-onward" data-reveal>
      <div class="buy-onward__item">
        <IconTile name="pen" />
        <h4 class="ea-h3">Bidding for contracts instead?</h4>
        <p>If you are a supplier answering tenders, {PRODUCT_NAME_BID} drafts answers from your own past documents.</p>
        <a class="ea-link" href="/bid/">See {PRODUCT_NAME_BID}</a>
      </div>
      <div class="buy-onward__item">
        <IconTile name="document" />
        <h4 class="ea-h3">A free tool, no account needed</h4>
        <p>Paste a tender into the Tender Compliance Matrix and read back what it asks for, each item with the line it came from.</p>
        <a class="ea-link" href="/tools/tender-compliance-matrix/">Open the free tool</a>
      </div>
      <div class="buy-onward__item">
        <IconTile name="checklist" />
        <h4 class="ea-h3">Prices on the page</h4>
        <p>{BUYER_PRO.name} is £{BUYER_PRO.monthly} a month, with every buyer and supplier plan on our pricing page.</p>
        <a class="ea-link" href="/pricing/">See all prices</a>
      </div>
    </div>
  </div>
</Band>

<style>
  .buy-section,
  .buy-group {
    margin-top: var(--ea-head-gap);
  }

  .buy-section > .ea-h3 {
    margin-bottom: var(--space-3);
  }

  /* Label and one sentence on the left, the rows or the scale on the right:
     a reading layout rather than a grid of identical cards. One column below
     960px. */
  .buy-group {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-4) var(--space-8);
    align-items: start;
  }

  .buy-group--wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .buy-group__side {
    display: grid;
    gap: var(--space-3);
  }

  .buy-group__label {
    margin: 0;
    color: var(--ea-accent-ink);
  }

  .buy-group__intro {
    max-width: var(--ea-copy);
    color: var(--ea-sub);
  }

  /* The heading keeps its element for the outline and for content parity, and
     takes the row's own type from `.ea-qa summary`. */
  .buy-row__h {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .buy-surfaces {
    margin-top: var(--space-5);
  }

  .buy-bands {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .buy-band {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    border: 1px solid var(--ea-rule);
    border-radius: var(--radius-md);
    background: var(--ea-card-bg);
  }

  /* A band's name, not a statistic: "< 80%, no deadline passed" is a phrase,
     and at the display size it broke into three lines of giant type beside
     one line figures (measured 2026-10-22). The card heading role keeps all
     five on the same footing. */
  .buy-band__val {
    font-size: var(--t-ea-h3);
    line-height: 1.3;
    font-weight: var(--t-w-ea-strong);
    color: var(--ea-ink);
  }

  .buy-band__lbl {
    font-size: var(--t-micro);
    color: var(--ea-muted);
    margin-top: var(--space-1);
  }

  .buy-scope-row {
    margin-top: var(--space-5);
  }

  .buy-scope {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .buy-scope__col {
    padding: var(--blk-pad);
  }

  .buy-ticks {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .buy-ticks li {
    position: relative;
    padding-inline-start: var(--space-5);
    color: var(--ea-muted);
  }

  .buy-ticks li::before {
    content: "·";
    position: absolute;
    inset-inline-start: var(--space-2);
    font-weight: var(--t-w-ea-strong);
    color: var(--ea-ink);
  }

  .buy-onward {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--ea-head-gap);
    border-block: 1px solid var(--ea-rule);
  }

  .buy-onward__item {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6);
    border-inline-start: 1px solid var(--ea-rule);
  }

  .buy-onward__item:last-child {
    border-inline-end: 1px solid var(--ea-rule);
  }

  .buy-onward__item p {
    color: var(--ea-muted);
  }

  @media (max-width: 1099px) {
    .buy-bands {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 959px) {
    .buy-group,
    .buy-scope,
    .buy-onward {
      grid-template-columns: minmax(0, 1fr);
    }

    .buy-onward__item {
      border-inline-end: 1px solid var(--ea-rule);
    }

    .buy-onward__item + .buy-onward__item {
      border-top: 1px solid var(--ea-rule);
    }
  }

  @media (max-width: 599px) {
    .buy-bands {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
