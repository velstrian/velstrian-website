---
/**
 * BuyWhatItDoes: what can it do for me? (/buy/, strategy 0.4 row 2, visual 0.8).
 *
 * A LIGHT ALT band. The five buyer capabilities in everyday words, in the order
 * the work happens, each beside a product screen on a stage:
 *
 *   1. Write a clear request (rubric in advance, Quick RFQ)
 *   2. Collect the replies in one place (invitations, receipts, clarifications)
 *   3. Read every reply side by side (normalisation, whole life costs)
 *   4. See what each supplier can back up (verbatim evidence location)
 *   5. Record your decision and why (panel scoring, delivery tracking)
 *
 * Alternating sides on wide screens so the eye walks down the page.
 * Keeps every capability the previous buy page described (RULE 0-U).
 *
 * 2026-10-23, A-343 (D305): each paragraph and caption cut to one short plain
 * line, because /buy/ first view words had risen to 1,661. Nothing is lost: the
 * detail each one dropped (Quick RFQ explained, the scope is yours, answers sent
 * without saying who asked, the whole life cost, no proof means nothing shown
 * and delivery alerts) is in the workspace cards and the
 * scope list of BuyDetail, one tap away, and in the Sequence steps beside each.
 */
import Band from '../evidenced/Band.astro';
import Frame from '../evidenced/Frame.astro';
import Stage from '../evidenced/Stage.astro';
import Sequence from '../evidenced/Sequence.astro';
import { PRODUCT_NAME_BUY } from '../../lib/brand-names';
---

<Band tone="light-alt" class="ea-caps" labelledby="buy-what-title" id="what-it-does">
  <div class="ea-wrap">
    <div class="ea-head-row" data-reveal>
      <h2 class="ea-h2" id="buy-what-title">Five steps, from asking to choosing.</h2>
      <p class="ea-lead">
        {PRODUCT_NAME_BUY} keeps it all in one place.
      </p>
    </div>

    {/* 1. Write a clear request */}
    <div class="ea-panel ea-panel--row" data-reveal>
      <div class="ea-panel__copy">
        <h3 class="ea-h3">Write a clear request</h3>
        <p>
          Set your scoring before anyone replies, or send a Quick RFQ.
        </p>
      </div>
      <Stage layout="panel">
        <Frame title="What you need: cleaning and facilities" status="Scoring fixed" capture="buy-cap-request" caption="Scoring fixed before replies arrive.">
          <ul class="ea-mini-list">
            <li><span>Local jobs and training</span><span class="ea-state ea-state--ok">15% weighting</span></li>
            <li><span>Less waste</span><span class="ea-state ea-state--ok">10% weighting</span></li>
            <li><span>Fair pay and working terms</span><span class="ea-state ea-state--ok">10% weighting</span></li>
            <li><span>The service and its staff</span><span class="ea-state">65% weighting</span></li>
          </ul>
        </Frame>
        <Sequence
          slot="float"
          title="Requirement pack"
          steps={[
            { label: 'Questions settled', detail: 'Before any reply arrives' },
            { label: 'Scoring fixed', detail: 'Reuse it next time' },
            { label: 'Quick RFQ ready', detail: 'Written by you' },
          ]}
        />
      </Stage>
    </div>

    {/* 2. Collect the replies in one place */}
    <div class="ea-panel ea-panel--row ea-panel--flip" data-reveal>
      <div class="ea-panel__copy">
        <h3 class="ea-h3">Collect the replies in one place</h3>
        <p>
          Each supplier gets a personal link, a receipt and every answer.
        </p>
      </div>
      <Stage layout="panel">
        <Frame title="Replies and questions" status="4 invited" capture="buy-cap-collect" caption="All replies, one view.">
          <ul class="ea-mini-list">
            <li><span>Apex Infrastructure</span><span class="ea-state ea-state--ok">Uploaded · Receipt 801</span></li>
            <li><span>Beacon Engineering</span><span class="ea-state ea-state--ok">Uploaded · Receipt 802</span></li>
            <li><span>Crestwood Group</span><span class="ea-state ea-state--ok">Uploaded · Receipt 803</span></li>
            <li><span>Question 2 (site access)</span><span class="ea-state">Answer sent to all 4</span></li>
          </ul>
        </Frame>
        <Sequence
          slot="float"
          title="Replies"
          steps={[
            { label: '4 suppliers invited' },
            { label: '3 replies uploaded', detail: 'Each got a receipt' },
            { label: '1 question answered', detail: 'Sent to all, names hidden' },
          ]}
        />
      </Stage>
    </div>

    {/* 3. Read every reply side by side */}
    <div class="ea-panel ea-panel--row" data-reveal>
      <div class="ea-panel__copy">
        <h3 class="ea-h3">Read every reply side by side</h3>
        <p>
          Every bid as one total cost, like for like.
        </p>
      </div>
      <Stage layout="panel">
        <Frame title="Total cost over 3 years" status="3 bids lined up" capture="buy-cap-compare" caption="One 3 year total each.">
          <ul class="ea-mini-list">
            <li><span>Apex Infrastructure</span><span class="ea-state ea-state--ok">£142,500 over 3 years</span></li>
            <li><span>Beacon Engineering</span><span class="ea-state">£156,000 over 3 years</span></li>
            <li><span>Crestwood Group</span><span class="ea-state ea-state--ok">£138,000 over 3 years</span></li>
          </ul>
        </Frame>
        <Sequence
          slot="float"
          title="Prices lined up"
          steps={[
            { label: 'Prices entered' },
            { label: 'Same amount of work', detail: 'Over the same 3 years' },
            { label: 'Totals ready', detail: 'Side by side' },
          ]}
        />
      </Stage>
    </div>

    {/* 4. See what each supplier can back up */}
    <div class="ea-panel ea-panel--row ea-panel--flip" data-reveal>
      <div class="ea-panel__copy">
        <h3 class="ea-h3">See what each supplier can back up</h3>
        <p>
          Each supplier's proof, word for word, with its page.
        </p>
      </div>
      <Stage layout="panel">
        <Frame title="First read: local jobs" status="Proof found" capture="buy-cap-evidence" caption="Section and page shown.">
          <ul class="ea-mini-list">
            <li><span>Apex: 2 apprenticeships, borough recruited</span><span class="ea-state ea-state--ok">Section 4.1, p12</span></li>
            <li><span>Beacon: mentions training, no numbers</span><span class="ea-state ea-state--held">No number, p7</span></li>
            <li><span>Crestwood: 4 accredited apprenticeships</span><span class="ea-state ea-state--ok">Section 5.2, p18</span></li>
          </ul>
        </Frame>
        <Sequence
          slot="float"
          title="Proof, word for word"
          steps={[
            { label: 'Every reply read' },
            { label: 'Quotes found', detail: 'With page and section' },
            { label: 'No proof, nothing shown', detail: 'Nothing is invented', state: 'done' },
          ]}
        />
      </Stage>
    </div>

    {/* 5. Record your decision and why */}
    <div class="ea-panel ea-panel--row" data-reveal>
      <div class="ea-panel__copy">
        <h3 class="ea-h3">Record your decision and why</h3>
        <p>
          Your panel scores and says why, then tracks delivery.
        </p>
      </div>
      <Stage layout="panel">
        <Frame title="After you choose: delivery" status="Contract running" capture="buy-cap-decision" caption="Promised against delivered.">
          <ul class="ea-mini-list">
            <li><span>Local apprenticeships (2 committed)</span><span class="ea-state ea-state--ok">2 hired · On track</span></li>
            <li><span>Carbon reduction target (15% committed)</span><span class="ea-state ea-state--held">12% · At risk</span></li>
            <li><span>Quarterly review meeting</span><span class="ea-state">Completed Q1</span></li>
          </ul>
        </Frame>
        <Sequence
          slot="float"
          title="After you choose"
          steps={[
            { label: 'Panel scores recorded' },
            { label: 'Contract awarded' },
            { label: 'Delivery tracked', detail: 'Alerts if targets fall behind' },
          ]}
        />
      </Stage>
    </div>
  </div>
</Band>
