---
/**
 * BuyWhatItDoes: what can it do for me? (/buy/, strategy 0.4 row 2, visual 0.8).
 *
 * A LIGHT ALT band. The five buyer capabilities in everyday words, in the order
 * the work happens, each beside a product screen on a stage:
 *
 *   1. Write a clear request (rubric in advance, Quick RFQ)
 *   2. Collect the replies in one place (invitations, receipts, clarifications)
 *   3. Read every reply side by side (normalisation, whole life costs)
 *   4. See what each supplier can back up (verbatim evidence location)
 *   5. Record your decision and why (panel scoring, delivery tracking)
 *
 * Alternating sides on wide screens so the eye walks down the page.
 * Keeps every capability the previous buy page described (RULE 0-U).
 *
 * 2026-10-23, A-343 (D305): each paragraph and caption cut to one short plain
 * line, because /buy/ first view words had risen to 1,661. Nothing is lost: the
 * detail each one dropped (Quick RFQ explained, the scope is yours, answers sent
 * without saying who asked, the whole life cost, no proof means nothing shown
 * and delivery alerts) is in the workspace cards and the
 * scope list of BuyDetail, one tap away, and in the Sequence steps beside each.
 *
 * 2026-10-23, R285-WEB-PREMIUM-CARDS-01 (owner: "Stripe style bento card with
 * one side gradient colorful"): the five rows are one bento, all five seen at
 * once. Every heading and paragraph is word for word, and what the Sequence
 * steps said survives as each tile's short points, so nothing is dropped. The
 * request screen is a real staging capture, the other four are the product
 * designs data/product-captures.ts registers, each captioned as such.
 */
import Band from '../evidenced/Band.astro';
import Bento from '../ui/Bento.astro';
import { PRODUCT_NAME_BUY } from '../../lib/brand-names';
---

<Band tone="light-alt" class="ea-caps" labelledby="buy-what-title" id="what-it-does" wedge="left">
  <div class="ea-wrap">
    <div class="ea-head-row" data-reveal>
      <h2 class="ea-h2" id="buy-what-title">Five steps, from asking to choosing.</h2>
      <p class="ea-lead">
        {PRODUCT_NAME_BUY} keeps it all in one place.
      </p>
    </div>

    <Bento
      tiles={[
        {
          size: 'lg',
          flood: 'end',
          kicker: 'Step 1',
          title: 'Write a clear request',
          body: 'Set your scoring before anyone replies, or send a Quick RFQ.',
          capture: 'buy-cap-request',
          points: ['Questions settled before any reply arrives', 'Scoring fixed, reuse it next time', 'A Quick RFQ, written by you'],
        },
        {
          kicker: 'Step 2',
          title: 'Collect the replies in one place',
          body: 'Each supplier gets a personal link, a receipt and every answer.',
          capture: 'buy-cap-collect',
          points: ['A receipt for every reply', 'Questions answered to all, names hidden'],
        },
        {
          kicker: 'Step 3',
          title: 'Read every reply side by side',
          body: 'Every bid as one total cost, like for like.',
          capture: 'buy-cap-compare',
          points: ['The same amount of work over the same 3 years'],
        },
        {
          size: 'half',
          flood: 'end',
          kicker: 'Step 4',
          title: "See what each supplier can back up",
          body: "Each supplier's proof, word for word, with its page.",
          capture: 'buy-cap-evidence',
          points: ['Quotes found with page and section', 'No proof, nothing shown. Nothing is invented'],
        },
        {
          size: 'half',
          flood: 'end',
          kicker: 'Step 5',
          title: 'Record your decision and why',
          body: 'Your panel scores and says why, then tracks delivery.',
          capture: 'buy-cap-decision',
          points: ['Panel scores recorded', 'Alerts if delivery targets fall behind'],
        },
      ]}
    />
  </div>
</Band>
