---
/**
 * PricingHero: hero band for /pricing/ on design system v3.
 *
 * Storyline band 1: what is this, and what does it cost?
 * Follows spec Part 2 (2.3 row 1):
 * - One sentence: "Find contracts that suit you and write strong bids yourself. Public and private work."
 * - Standfirst: "Plans from £49 a month. Start with 7 days free. See the price first. Sized for SMEs."
 * - One button: "Start 7 day trial"
 * - Monthly and annual switch sits here with 10% saving.
 *
 * On the shared PageHero (R285-WEB-GATES-V3-01) so the page title takes the
 * one v3 heading treatment (check-render.js). The switch sits in its `after`
 * row, under the one button. Its styles stay here, scoped to this component's own markup.
 */
import PageHero from '../evidenced/PageHero.astro';
import Action from '../evidenced/Action.astro';
import { SIGNUP_URL, TRIAL_DAYS, PLANS, annualDiscountPct, START_LABEL } from '../../data/pricing';

const [STARTER] = PLANS;
---

<PageHero
  id="pricing-hero-title"
  bandId="hero"
  label="Public and private work · Published pricing"
  title="Find contracts that suit you and write strong bids yourself."
  lead={`Plans from £${STARTER.monthly} a month. Start with ${TRIAL_DAYS} days free. See the price first. Sized for SMEs.`}
>
  <Action href={SIGNUP_URL}>{START_LABEL}</Action>

  <div class="pricing-billing-switch" slot="after">
    <span class="pricing-billing-switch__label pricing-billing-switch__label--m">Monthly</span>
    <label for="billing-toggle" class="pricing-billing-switch__hit">
      <span class="pricing-billing-switch__track">
        <span class="pricing-billing-switch__knob"></span>
      </span>
    </label>
    <span class="pricing-billing-switch__label pricing-billing-switch__label--a">Annual billing · Save {annualDiscountPct(STARTER)}%</span>
  </div>
</PageHero>

<style>
  .pricing-billing-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .pricing-billing-switch__label {
    font-size: var(--t-ea-small);
    font-weight: var(--t-w-ea-medium);
    color: var(--ea-ink);
    transition: color var(--ea-dur-hover) ease-out;
  }

  .pricing-billing-switch__hit {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }

  .pricing-billing-switch__track {
    position: relative;
    display: inline-block;
    width: var(--space-10);
    height: var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--ea-well);
    border: 1px solid var(--ea-rule);
    transition: background-color var(--ea-dur-hover) ease-out;
  }

  .pricing-billing-switch__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(var(--space-6) - 6px);
    height: calc(var(--space-6) - 6px);
    border-radius: var(--radius-pill);
    background: var(--ea-ink);
    transition: transform var(--ea-dur-hover) cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  :global(#billing-toggle:checked) ~ * .pricing-billing-switch__knob {
    transform: translateX(calc(var(--space-10) - var(--space-6)));
  }

  :global(#billing-toggle:checked) ~ * .pricing-billing-switch__label--m {
    color: var(--ea-muted);
  }

  :global(#billing-toggle:checked) ~ * .pricing-billing-switch__label--a {
    color: var(--ea-ink);
    font-weight: var(--t-w-ea-strong);
  }

  :global(#billing-toggle:focus-visible) ~ * .pricing-billing-switch__track {
    outline: var(--ea-focus);
    outline-offset: 2px;
  }
</style>
