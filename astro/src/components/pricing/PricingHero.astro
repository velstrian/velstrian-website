---
/**
 * PricingHero: hero band for /pricing/ on design system v3.
 *
 * Storyline band 1: what is this, and what does it cost?
 * Follows spec Part 2 (2.3 row 1):
 * - One sentence: "Find contracts that suit you and write strong bids yourself. Public and private work."
 * - Standfirst: "Plans from £49 a month. Start with 7 days free. See the price first. Sized for SMEs."
 * - One button: "Start 7 day trial"
 *
 * On the shared PageHero (R285-WEB-GATES-V3-01) so the page title takes the
 * one v3 heading treatment (check-render.js).
 */
import PageHero from '../evidenced/PageHero.astro';
import Action from '../evidenced/Action.astro';
import { SIGNUP_URL, TRIAL_DAYS, PLANS, START_LABEL } from '../../data/pricing';

const [STARTER] = PLANS;
---

<PageHero
  id="pricing-hero-title"
  bandId="hero"
  label="Public and private work · Published pricing"
  title="Simple prices, shown up front."
  accent="shown up front."
  lead={`Plans from £${STARTER.monthly} a month. Start with ${TRIAL_DAYS} days free. See the price first. Sized for SMEs.`}
>
  <Action href={SIGNUP_URL}>{START_LABEL}</Action>
</PageHero>
