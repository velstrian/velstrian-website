---
/**
 * ResourceCard: one card on /resources/, on the site's one card (D424, A-434).
 *
 * THE STRIPE BLOG PATTERN, measured 2026-10-25
 * (docs/design/STRIPE-BLOG-PATTERN-2026-10-25.md): a picture to the card's
 * edges, the category with its accent rule, the title, one summary, Read more.
 * It is the shared `.ea-tcard--media` in evidenced.css, so it is the same card
 * as the blog's related posts, and this file sizes nothing.
 *
 * THE PICTURE. Until 2026-10-25 each card carried a type led cover (D283): a
 * flat Iris panel with a small clip art icon (a checklist, a magnifier, bars,
 * a row of books). Owner decision D424 asks for weak stock style images to be
 * replaced with bespoke on brand art at the quality of the glossary
 * "Statutory spotlight" panel, so each card now draws one of those panels
 * (ui/BrandArt.astro), every colour a token. Decoration only, hidden from
 * assistive technology: the title below is the card's name.
 */
import BrandArt from '../ui/BrandArt.astro';
import type { Art } from '../ui/BrandArt.astro';

interface Props {
  href: string;
  art: Art;
  label: string;
  title: string;
  description: string;
  /** The link's words, Read resource by default. */
  more?: string;
}

const { href, art, label, title, description, more = 'Read resource' } = Astro.props;
const uid = `res-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<a href={href} class="ea-card ea-tcard ea-tcard--media">
  <div class="ea-tcard__media res-card__art" aria-hidden="true">
    <BrandArt art={art} uid={uid} />
  </div>
  <div class="ea-tcard__body">
    <p class="ea-label">{label}</p>
    <h3 class="ea-h3">{title}</h3>
    <p>{description}</p>
    <span class="ea-tcard__more">{more}</span>
  </div>
</a>

<style>
  /* The art panel's box: 16:9 like every card picture on the site, the
     lines and glints in the ink the art is drawn for. */
  .res-card__art {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    color: var(--stage-ink);
    background: var(--ea-raised);
  }
</style>
