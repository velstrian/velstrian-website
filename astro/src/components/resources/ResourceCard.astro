---
/**
 * ResourceCard: one card on /resources/, a type led cover over a label, a
 * title and one line.
 *
 * The cover was a Gemini 3D render per card until 2026-10-22 (a glass book,
 * stacked translucent cards, a tilted grid, rising bars). Owner decision D283
 * replaced the renders with the same type led cover the blog uses, so the hub
 * and the guides read as one set and the cards cost no image bytes. The cover
 * restates the card, so it is hidden from assistive technology and the title
 * below it stays the card's name.
 */
import TypeCover from '../blog/TypeCover.astro';
import type { Cover } from '../blog/covers';

interface Props {
  href: string;
  cover: Cover;
  label: string;
  title: string;
  description: string;
}

const { href, cover, label, title, description } = Astro.props;
---

<a href={href} class="ea-card res-card" data-reveal>
  <div class="res-card__art">
    <TypeCover cover={cover} flush />
  </div>
  <span class="ea-label res-card__label">{label}</span>
  <h3 class="ea-h3 res-card__title">{title}</h3>
  <p class="res-card__desc">{description}</p>
</a>

<style>
  .res-card {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: var(--space-2);
    padding: 0 0 var(--space-6) 0;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .res-card__art {
    overflow: hidden;
  }

  .res-card__label {
    padding-inline: var(--space-6);
    padding-top: var(--space-4);
    color: var(--ea-accent-ink);
  }

  .res-card__title {
    padding-inline: var(--space-6);
    margin: 0;
    color: var(--ea-ink);
    font-size: var(--t-ea-h3);
    font-weight: var(--t-w-ea-strong);
    line-height: 1.3;
  }

  .res-card__desc {
    padding-inline: var(--space-6);
    margin: 0;
    color: var(--ea-muted);
    font-size: var(--t-ea-body);
    line-height: var(--lh-ea-body);
  }
</style>
