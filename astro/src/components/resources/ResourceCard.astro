---
interface Props {
  href: string;
  imageSlug: 'card-tender-finder' | 'card-compliance-matrix' | 'card-guides' | 'card-blog';
  label: string;
  title: string;
  description: string;
}

const { href, imageSlug, label, title, description } = Astro.props;

const ALTS: Record<string, string> = {
  'card-tender-finder':
    'Abstract art of stacked translucent document cards on an indigo to purple gradient, one card outlined in white.',
  'card-compliance-matrix':
    'Abstract art of a tilted grid of small rounded squares on near black, a few filled purple as if checked off.',
  'card-guides':
    'Abstract art of an open book made of frosted glass casting an indigo and purple glow on a white surface.',
  'card-blog':
    'Abstract poster of three tall rounded bars rising in indigo to purple on near black, crossed by a thin white arc.',
};

const alt = ALTS[imageSlug] ?? '';
---

<a href={href} class="ea-card res-card" data-reveal>
  <div class="res-card__art">
    <picture>
      <source
        type="image/avif"
        srcset={`/Assets/images/r285-gemini/${imageSlug}-800.avif 800w, /Assets/images/r285-gemini/${imageSlug}-1600.avif 1600w`}
        sizes="(min-width: 1024px) 280px, (min-width: 640px) 50vw, 100vw"
      />
      <source
        type="image/webp"
        srcset={`/Assets/images/r285-gemini/${imageSlug}-800.webp 800w, /Assets/images/r285-gemini/${imageSlug}-1600.webp 1600w`}
        sizes="(min-width: 1024px) 280px, (min-width: 640px) 50vw, 100vw"
      />
      <img
        src={`/Assets/images/r285-gemini/${imageSlug}-1600.webp`}
        alt={alt}
        width="1600"
        height="1000"
        loading="lazy"
        decoding="async"
        class="res-card__img"
      />
    </picture>
  </div>
  <span class="ea-label res-card__label">{label}</span>
  <h3 class="ea-h3 res-card__title">{title}</h3>
  <p class="res-card__desc">{description}</p>
</a>

<style>
  .res-card {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: var(--space-2);
    padding: 0 0 var(--space-6) 0;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .res-card__art {
    overflow: hidden;
  }

  .res-card__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .res-card__label {
    padding-inline: var(--space-6);
    padding-top: var(--space-4);
    color: var(--ea-accent-ink);
  }

  .res-card__title {
    padding-inline: var(--space-6);
    margin: 0;
    color: var(--ea-ink);
    font-size: var(--t-ea-h3);
    font-weight: var(--t-w-ea-strong);
    line-height: 1.3;
  }

  .res-card__desc {
    padding-inline: var(--space-6);
    margin: 0;
    color: var(--ea-muted);
    font-size: var(--t-ea-body);
    line-height: var(--lh-ea-body);
  }
</style>
