---
import Band from '../evidenced/Band.astro';
import Action from '../evidenced/Action.astro';
import ResourceCard from './ResourceCard.astro';
import { LIVE_SOURCES } from '../../data/site-facts';
import { RECENT_DAYS } from '../../data/tender-finder';

/* D424 (A-434): each card draws its own bespoke art panel (ui/BrandArt.astro)
   in place of the type led cover with a clip art icon. One panel each, so no
   two cards on the hub repeat. */
const PPN_GUIDE_TITLE = 'PPN 026 social value: how the model is scored';
---

<Band tone="light-alt" id="tools" labelledby="tools-title">
  <div class="ea-wrap">
    <div class="ea-head-row" data-reveal>
      <div>
        <p class="ea-label res-eyebrow">Start here</p>
        <h2 class="ea-h2" id="tools-title">Free tools and guides</h2>
      </div>
      <p class="ea-lead">
        Search open UK and EU tenders, read back what a tender requires the same way Velstrian Bid does, and learn the rules in plain words. No account, no email gate, no credit card. Use them, then start Velstrian Bid if you want alerts, fit scores and the full audit trail.
      </p>
    </div>

    <ul class="ea-cards ea-cards--4 res-grid" role="list">
      <li data-reveal>
        <ResourceCard
          href="/tools/tender-compliance-matrix/"
          art="iris-flow"
          more="Use the free tool"
          label="Free tool"
          title="Tender Compliance Matrix"
          description="Paste the text of a tender and read back the requirements its wording states, each one shown with the line it came from. Nothing is uploaded and nothing is generated."
        />
      </li>
      <li data-reveal>
        <ResourceCard
          href="/tools/tender-finder/"
          art="cyan-aurora"
          more="Use the free tool"
          label="Free tool"
          title="Tender Finder"
          description={`Search open notices from ${LIVE_SOURCES}, published in the last ${RECENT_DAYS} days. Filter by keyword, region, value and closing date, and follow each result to its official source.`}
        />
      </li>
      <li data-reveal>
        <ResourceCard
          href="/blog/ppn-026-social-value-guide/"
          art="statutory-horizon"
          more="Read the guide"
          label="PPN 026"
          title={PPN_GUIDE_TITLE}
          description="A minimum 10% social value weighting applies from 1 million pounds inc VAT, rising to 20% at 5 million or above. How the National TOMs measures and National TOMs proxies turn into a defensible, bid-ready score."
        />
      </li>
      <li data-reveal>
        <ResourceCard
          href="/blog/"
          art="protocol-stream"
          more="See all guides"
          label="Guides"
          title="In-depth guides"
          description="Long-form analysis written in-house. Each article cites the policy note, Act or section it rests on, not somebody else's summary of it."
        />
      </li>
    </ul>

    <div class="res-more" data-reveal>
      <div class="ea-actions">
        <Action href="/tools/" variant="secondary">View all tools</Action>
        <Action href="/blog/" variant="secondary">View all articles</Action>
      </div>
    </div>
  </div>
</Band>

<style>
  .res-eyebrow {
    margin-bottom: var(--space-3);
    color: var(--ea-accent-ink);
  }

  /* The shared four across card row (.ea-cards--4, evidenced.css): two
     across below 1100px, one across below 960px. */
  .res-grid {
    margin-top: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
  }

  /* The two buttons sit in the shared .ea-actions row, one width each
     (check-render.js, R285-WEB-GATES-V3-01). This only centres the row. */
  .res-more {
    display: flex;
    justify-content: center;
    margin-top: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
  }

  .res-more .ea-actions {
    margin-top: 0;
  }
</style>
