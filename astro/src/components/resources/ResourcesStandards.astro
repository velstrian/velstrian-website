---
import Band from '../evidenced/Band.astro';
import Action from '../evidenced/Action.astro';
import IconTile from '../evidenced/IconTile.astro';

/* The methodology card's rules, each as /sources/ records it. */
const RULES = [
  {
    name: 'Procurement Act 2023, section 52',
    meaning: 'A public contract over 5 million pounds must have at least 3 published targets.',
    href: '/sources/#s52',
  },
  {
    name: 'Procurement Act 2023, section 71',
    meaning: 'The buyer checks the contract against those targets at least once every 12 months.',
    href: '/sources/#s71',
  },
  {
    name: 'National TOMs',
    meaning: 'The measures our social value totals are aligned to. A way of counting, not a law.',
    href: '/sources/#national-toms',
  },
];

/* The glossary card's examples. Plain one line meanings, each the short form
   of its full entry on /glossary/, and each true of private work as much as
   public except PPN 026, which says plainly that it is for central
   government contracts (data/faq.ts). */
const TERMS = [
  {
    name: 'ITT (invitation to tender)',
    meaning: 'The pack a buyer sends asking you to bid, with the questions to answer.',
    href: '/glossary/',
  },
  {
    name: 'Award criteria',
    meaning: 'How the buyer marks your answers, for example on price, quality and social value.',
    href: '/glossary/',
  },
  {
    name: 'Framework agreement',
    meaning: 'An approved list of suppliers. Once you are on it, you can win work without a full tender each time.',
    href: '/glossary/',
  },
  {
    name: 'PPN 026',
    meaning:
      'The government rules for scoring social value on central government contracts of 1 million pounds or more, from 1 January 2027.',
    href: '/glossary/ppn-026/',
  },
  {
    name: 'Selection Questionnaire (SQ)',
    meaning: 'The first questions a buyer asks to check your business is suitable, before the main tender.',
    href: '/glossary/',
  },
];
---

<Band tone="dark" id="methodology" labelledby="methodology-title">
  <div class="ea-wrap">
    <div class="res-standards-grid" data-reveal>
      <div class="res-col">
        <IconTile name="document" />
        <p class="ea-label res-col__eyebrow">Methodology</p>
        <h2 class="ea-h2" id="methodology-title">How the rules are sourced</h2>
        <p class="ea-lead res-col__lead">
          Every figure on this site is published with the statute, policy note or framework it rests on. No black box.
        </p>

        <div class="ea-card res-panel">
          <h3 class="ea-h3 res-panel__h">
            <a href="/glossary/ppn-026/">PPN 026 in full</a>
          </h3>
          <p class="res-panel__body">
            The 10% minimum weighting, the five missions and eight policy outcomes beneath them, the publication and mandatory dates, and where PPN 06/20 still applies.
          </p>
          {/* The other rules a figure on this site rests on, each with its plain
              meaning and its entry on /sources/, so this card carries as much as
              the Glossary card beside it. Each meaning is the one /sources/
              records. */}
          <dl class="res-terms">
            {
              RULES.map((t) => (
                <div class="res-term">
                  <dt>
                    <a class="ea-link" href={t.href}>{t.name}</a>
                  </dt>
                  <dd>{t.meaning}</dd>
                </div>
              ))
            }
          </dl>
          <div class="res-panel__links">
            <a class="ea-link" href="/sources/">Read every figure and its source</a>
            <a class="ea-link" href="/glossary/ppn-026/">PPN 026 glossary definition</a>
          </div>
        </div>
      </div>

      <div class="res-col">
        <IconTile name="checklist" />
        <p class="ea-label res-col__eyebrow">Glossary</p>
        <h2 class="ea-h2" id="glossary-title">Glossary of procurement terms</h2>
        <p class="ea-lead res-col__lead">
          Plain-English meanings of the words and acronyms you meet when you bid for public and private work.
        </p>

        {/* Five real terms with a one line meaning each, so the card holds as
            much as Methodology beside it rather than one italic line stretched
            to its height (owner report 2026-10-24, the card "looks empty").
            Each meaning is the plain short form of its entry on /glossary/. */}
        <div class="ea-card res-panel">
          <dl class="res-terms">
            {
              TERMS.map((t) => (
                <div class="res-term">
                  <dt>
                    <a class="ea-link" href={t.href}>{t.name}</a>
                  </dt>
                  <dd>{t.meaning}</dd>
                </div>
              ))
            }
          </dl>
          <div class="res-panel__action">
            <Action href="/glossary/" variant="secondary">Browse the glossary</Action>
          </div>
        </div>
      </div>
    </div>

    <div class="res-onward" data-reveal>
      <p class="res-compare">
        Weighing up your options?{' '}
        <a class="ea-link" href="/compare/">See how Velstrian Bid compares to AutogenAI, mytender.io, CleanTender and SwiftBid</a>.{' '}
        <a class="ea-link" href="/pricing/">View all pricing</a>.
      </p>
    </div>
  </div>
</Band>

<style>
  /* The two columns share their ROWS through subgrid, so the icon, eyebrow,
     heading, lead and card of Methodology line up with Glossary's even when
     one heading wraps and the other does not. Without it the two cards
     started at different heights and ended at different heights, owner
     report 2026-10-24 ("looks odd as both are in different sizes"). The row
     gap is zero because each child keeps its own spacing below. */
  .res-standards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(5, auto);
    column-gap: clamp(var(--space-8), 3rem + 2vw, var(--space-12));
    row-gap: 0;
  }

  .res-col {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    align-items: start;
  }

  .res-col > .res-panel {
    align-self: stretch;
  }

  @media (max-width: 899px) {
    .res-standards-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: clamp(var(--space-8), 3rem + 2vw, var(--space-12));
    }

    .res-col {
      display: block;
    }
  }

  .res-col__eyebrow {
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    color: var(--ea-accent-ink);
  }

  .res-col__lead {
    margin-top: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .res-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--blk-pad);
  }

  .res-panel__h {
    margin: 0;
  }

  .res-panel__h a {
    color: var(--ea-ink);
    text-decoration: none;
  }

  .res-panel__h a:hover {
    color: var(--ea-accent-ink);
  }

  .res-panel__body {
    margin: 0;
    color: var(--ea-muted);
    font-size: var(--t-ea-body);
    line-height: var(--lh-ea-body);
  }

  /* The action sits at the foot of each card, whatever the copy above it. */
  .res-panel__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .res-terms {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .res-term > dt {
    font-size: var(--t-ea-body);
    font-weight: var(--t-w-ea-medium);
    line-height: var(--lh-ea-body);
  }

  .res-term > dd {
    margin: var(--space-1) 0 0;
    color: var(--ea-muted);
    font-size: var(--t-ea-body);
    line-height: var(--lh-ea-body);
  }

  .res-panel__action {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .res-onward {
    margin-top: clamp(var(--space-10), 3rem + 3vw, var(--space-16));
    padding-top: var(--space-8);
    border-top: 1px solid var(--ea-rule);
    text-align: center;
  }

  .res-compare {
    margin: 0 auto;
    max-width: 68ch;
    font-size: var(--t-ea-body);
    line-height: var(--lh-ea-body);
    color: var(--ea-muted);
  }

  /* The two links sit inside one sentence, so they flow as text. .ea-link is
     inline-flex for a tap target, which makes each link one unbreakable box:
     at 390 the line broke after the box and the full stop of the first link,
     then ". View all pricing.", started a line. Inline links in a sentence
     are exempt from the 2.5.8 target size (inline exception). */
  .res-compare .ea-link {
    display: inline;
    min-height: 0;
  }

</style>
