---
import Band from '../evidenced/Band.astro';
import Action from '../evidenced/Action.astro';
import Icon from '../evidenced/Icon.astro';
---

<Band tone="light" class="ea-hero" id="resources-hero" labelledby="resources-hero-title">
  <div class="ea-wrap">
    <div class="ea-head-row" data-reveal>
      <div>
        <p class="ea-label res-eyebrow">Hub</p>
        <h1 class="ea-hero__title" id="resources-hero-title">The rules, explained for UK teams.</h1>
        <p class="ea-lead res-hero__lead">
          A free tender compliance matrix, in-depth briefings on UK public-sector bidding, and a plain-English glossary, built around Velstrian Bid.
        </p>
        <div class="ea-actions">
          <Action href="/tools/tender-compliance-matrix/">Run the free tool</Action>
          <Action href="/blog/" variant="secondary">Read the latest briefing</Action>
        </div>
        <p class="res-reassurance">
          <Icon name="done" size={18} />
          <span>No account, no email gate, no credit card.</span>
        </p>
      </div>
    </div>
  </div>
</Band>

<style>
  .res-eyebrow {
    margin-bottom: var(--space-3);
    color: var(--ea-accent-ink);
  }

  .res-hero__lead {
    margin-top: var(--space-4);
  }

  .res-reassurance {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--t-ea-small);
    color: var(--ea-muted);
  }

  .res-reassurance :global(.ea-icon) {
    color: var(--ea-accent-ink);
  }
</style>
