---
/**
 * ResourcesHero: the /resources/ opening band, on the shared PageHero so the
 * page title takes the one v3 heading treatment (check-render.js, one page
 * heading treatment, R285-WEB-GATES-V3-01). It used to draw its own head
 * block, which is the fork that rule exists to stop.
 */
import PageHero from '../evidenced/PageHero.astro';
import Action from '../evidenced/Action.astro';
import Icon from '../evidenced/Icon.astro';
---

<PageHero
  id="resources-hero-title"
  bandId="resources-hero"
  label="Hub"
  title="Plain guides to bidding, public or private."
  lead="A free tool that lists what a tender asks for, short guides to winning public and private work, and a glossary that explains the words buyers use."
>
  <Action href="/tools/tender-compliance-matrix/">Run the free tool</Action>
  <Action href="/blog/" variant="secondary">Read the guides</Action>
  <Fragment slot="note">
    <Icon name="done" size={18} />
    <span>No account, no email gate, no credit card.</span>
  </Fragment>
</PageHero>
