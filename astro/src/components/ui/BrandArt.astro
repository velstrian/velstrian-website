---
/**
 * BrandArt: the bespoke Velstrian art panels, drawn from tokens only (D424,
 * A-434). Moved out of StripeCard.astro unchanged so every card family can
 * use the same art at the quality of the glossary "Statutory spotlight"
 * panel: the feature cards (StripeCard) and the resource cards
 * (ResourceCard), which used to carry type covers with small clip art icons.
 *
 * Decoration only: hidden from assistive technology by the caller. Lines and
 * glints draw in currentColor, which the caller sets (StripeCard sets
 * --stage-ink, the ink on the brand gradient). Gradient and filter ids are
 * document wide, so every panel scopes its ids by `uid`.
 */
export type Art = 'statutory-horizon' | 'iris-flow' | 'cyan-aurora' | 'protocol-stream';

interface Props {
  art: Art;
  /** Unique on the page, stable from build to build. */
  uid: string;
}

const { art, uid } = Astro.props;
---

{
  art === 'statutory-horizon' && (
    <svg
      class="stripe-art-svg"
      viewBox="0 0 520 340"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <linearGradient id={`${uid}-sh-bg`} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--qv-iris)" stop-opacity="0.1" />
          <stop offset="55%" stop-color="var(--qv-violet)" stop-opacity="0.55" />
          <stop offset="100%" stop-color="var(--qv-iris)" stop-opacity="0.9" />
        </linearGradient>
        <linearGradient id={`${uid}-sh-wave-1`} x1="100%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="var(--qv-cyan)" stop-opacity="0.8" />
          <stop offset="50%" stop-color="var(--qv-iris)" stop-opacity="0.85" />
          <stop offset="100%" stop-color="var(--qv-violet)" stop-opacity="0.3" />
        </linearGradient>
        <linearGradient id={`${uid}-sh-wave-2`} x1="10%" y1="100%" x2="90%" y2="0%">
          <stop offset="0%" stop-color="var(--qv-iris)" stop-opacity="0.9" />
          <stop offset="65%" stop-color="var(--qv-violet)" stop-opacity="0.75" />
          <stop offset="100%" stop-color="var(--qv-cyan)" stop-opacity="0.4" />
        </linearGradient>
        <radialGradient id={`${uid}-sh-glow`} cx="80%" cy="35%" r="65%">
          <stop offset="0%" stop-color="var(--qv-iris)" stop-opacity="0.8" />
          <stop offset="50%" stop-color="var(--qv-violet)" stop-opacity="0.45" />
          <stop offset="100%" stop-color="var(--qv-iris)" stop-opacity="0" />
        </radialGradient>
        <filter id={`${uid}-sh-blur`} x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="30" />
        </filter>
      </defs>

      <!-- Atmospheric Iris glow -->
      <rect width="520" height="340" fill={`url(#${uid}-sh-bg)`} />
      <circle cx="410" cy="130" r="180" fill={`url(#${uid}-sh-glow)`} filter={`url(#${uid}-sh-blur)`} />

      <!-- Pure minimal flowing light waves -->
      <path
        d="M120 340 C 230 280, 300 170, 410 70 C 455 30, 495 10, 520 0 L 520 340 Z"
        fill={`url(#${uid}-sh-wave-1)`}
        opacity="0.85"
      />
      <path
        d="M170 340 C 265 270, 340 155, 450 50 C 480 25, 505 12, 520 0 L 520 340 Z"
        fill={`url(#${uid}-sh-wave-2)`}
        opacity="0.75"
      />

      <!-- Precision specular ridge lines -->
      <path d="M100 340 C 210 270, 300 135, 430 35" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.75" />
      <path d="M140 340 C 245 265, 335 130, 465 30" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.5" />
      <path d="M180 340 C 280 260, 370 125, 500 25" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.35" />

      <!-- Luminous focal glint -->
      <circle cx="430" cy="35" r="4" fill="var(--qv-cyan)" stroke="currentColor" stroke-width="1.5" />
      <circle cx="300" cy="135" r="3" fill="currentColor" opacity="0.85" />
    </svg>
  )
}

{
  art === 'iris-flow' && (
    <svg
      class="stripe-art-svg"
      viewBox="0 0 520 340"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <linearGradient id={`${uid}-if-bg`} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--c-floor)" stop-opacity="0.08" />
          <stop offset="55%" stop-color="var(--qv-violet)" stop-opacity="0.5" />
          <stop offset="100%" stop-color="var(--qv-iris)" stop-opacity="0.9" />
        </linearGradient>
        <radialGradient id={`${uid}-if-corner-glow`} cx="85%" cy="20%" r="70%">
          <stop offset="0%" stop-color="var(--qv-iris)" stop-opacity="0.85" />
          <stop offset="45%" stop-color="var(--qv-violet)" stop-opacity="0.55" />
          <stop offset="100%" stop-color="var(--qv-iris)" stop-opacity="0" />
        </radialGradient>
        <filter id={`${uid}-if-blur`} x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="28" />
        </filter>
      </defs>

      <!-- Soft corner atmosphere -->
      <rect width="520" height="340" fill={`url(#${uid}-if-bg)`} />
      <circle cx="440" cy="80" r="190" fill={`url(#${uid}-if-corner-glow)`} filter={`url(#${uid}-if-blur)`} />

      <!-- Elegant minimal diagonal specular light gleams -->
      <line x1="260" y1="340" x2="520" y2="80" stroke="currentColor" stroke-width="1.8" opacity="0.8" stroke-linecap="round" />
      <line x1="310" y1="340" x2="520" y2="130" stroke="currentColor" stroke-width="1.2" opacity="0.55" stroke-linecap="round" />
      <line x1="360" y1="340" x2="520" y2="180" stroke="currentColor" stroke-width="0.8" opacity="0.35" stroke-linecap="round" />
      <line x1="410" y1="340" x2="520" y2="230" stroke="currentColor" stroke-width="0.6" opacity="0.2" stroke-linecap="round" />

      <!-- Refined corner micro glint -->
      <circle cx="440" cy="80" r="3.5" fill="currentColor" opacity="0.95" />
      <circle cx="440" cy="80" r="8" stroke="currentColor" stroke-width="0.8" opacity="0.4" />
    </svg>
  )
}

{
  art === 'cyan-aurora' && (
    <svg
      class="stripe-art-svg"
      viewBox="0 0 520 340"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <linearGradient id={`${uid}-ca-bg`} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--c-floor)" stop-opacity="0.08" />
          <stop offset="50%" stop-color="var(--qv-iris)" stop-opacity="0.45" />
          <stop offset="100%" stop-color="var(--qv-cyan)" stop-opacity="0.85" />
        </linearGradient>
        <radialGradient id={`${uid}-ca-aurora-glow`} cx="85%" cy="20%" r="70%">
          <stop offset="0%" stop-color="var(--qv-cyan)" stop-opacity="0.8" />
          <stop offset="40%" stop-color="var(--qv-iris)" stop-opacity="0.5" />
          <stop offset="100%" stop-color="var(--qv-violet)" stop-opacity="0" />
        </radialGradient>
        <filter id={`${uid}-ca-blur`} x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="28" />
        </filter>
      </defs>

      <!-- Celestial Cyan & Iris corner atmosphere -->
      <rect width="520" height="340" fill={`url(#${uid}-ca-bg)`} />
      <circle cx="440" cy="80" r="190" fill={`url(#${uid}-ca-aurora-glow)`} filter={`url(#${uid}-ca-blur)`} />

      <!-- Minimal concentric orbital light arcs in corner -->
      <path d="M 280 0 A 240 240 0 0 1 520 240" stroke="currentColor" stroke-width="1.8" opacity="0.75" fill="none" stroke-linecap="round" />
      <path d="M 340 0 A 180 180 0 0 1 520 180" stroke="currentColor" stroke-width="1.2" opacity="0.5" fill="none" stroke-linecap="round" />
      <path d="M 400 0 A 120 120 0 0 1 520 120" stroke="currentColor" stroke-width="0.8" opacity="0.35" fill="none" stroke-linecap="round" />

      <!-- Orbital anchor node -->
      <circle cx="450" cy="70" r="4" fill="var(--qv-cyan)" stroke="currentColor" stroke-width="1.5" />
      <circle cx="380" cy="140" r="3" fill="currentColor" opacity="0.8" />
    </svg>
  )
}

{
  art === 'protocol-stream' && (
    <svg
      class="stripe-art-svg"
      viewBox="0 0 520 340"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <linearGradient id={`${uid}-ps-bg`} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--c-floor)" stop-opacity="0.12" />
          <stop offset="50%" stop-color="var(--qv-violet)" stop-opacity="0.6" />
          <stop offset="100%" stop-color="var(--qv-cyan)" stop-opacity="0.88" />
        </linearGradient>
        <linearGradient id={`${uid}-ps-stream-1`} x1="100%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="var(--qv-cyan)" stop-opacity="0.9" />
          <stop offset="50%" stop-color="var(--qv-iris)" stop-opacity="0.7" />
          <stop offset="100%" stop-color="var(--qv-violet)" stop-opacity="0.2" />
        </linearGradient>
        <radialGradient id={`${uid}-ps-glow`} cx="80%" cy="30%" r="65%">
          <stop offset="0%" stop-color="var(--qv-cyan)" stop-opacity="0.65" />
          <stop offset="45%" stop-color="var(--qv-iris)" stop-opacity="0.45" />
          <stop offset="100%" stop-color="var(--qv-violet)" stop-opacity="0" />
        </radialGradient>
        <filter id={`${uid}-ps-blur`} x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="30" />
        </filter>
      </defs>

      <!-- Dynamic Protocol Stream (Integration & Agentic flow) -->
      <rect width="520" height="340" fill={`url(#${uid}-ps-bg)`} />
      <circle cx="420" cy="120" r="180" fill={`url(#${uid}-ps-glow)`} filter={`url(#${uid}-ps-blur)`} />

      <!-- Parallel stream ribbons -->
      <path
        d="M140 340 C 240 280, 310 170, 420 70 C 460 30, 495 10, 520 0 L 520 340 Z"
        fill={`url(#${uid}-ps-stream-1)`}
        opacity="0.8"
      />

      <!-- Stream caustics & pulse lines -->
      <path d="M110 340 C 220 270, 305 135, 435 35" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.75" />
      <path d="M150 340 C 255 265, 345 130, 470 30" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.5" />
      <path d="M190 340 C 290 260, 380 125, 505 25" stroke="currentColor" stroke-width="0.8" opacity="0.35" stroke-linecap="round" />

      <!-- Protocol transmission glints -->
      <circle cx="435" cy="35" r="4.5" fill="var(--qv-cyan)" stroke="currentColor" stroke-width="1.5" />
      <circle cx="310" cy="135" r="3.5" fill="currentColor" opacity="0.9" />
      <circle cx="220" cy="270" r="2.5" fill="var(--qv-cyan)" opacity="0.8" />
    </svg>
  )
}

<style>
  .stripe-art-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
