---
/**
 * OneTenderStages.astro: One tender scenario through five connected stages (R285-WEB-ENTERPRISE-REDESIGN-01).
 *
 * Discover, Qualify, Draft, Review, Deliver.
 * Carries one realistic NHS Estates facilities tender scenario across all five.
 * Marked screenshot slots for Claude's real product captures.
 *
 * R285-WEB-HOME-FORMAT-01 (2026-10-21), THREE CORRECTIONS:
 *
 * 1. THE REFUSAL TRACE LEFT THE REVIEW CARD. RefusalTrace is a full section
 *    (its own head, a five step rail, an app window and a ledger) and it was
 *    rendered inside the right column of the stage 04 card, about 640px wide.
 *    The rail wrapped one word per line, the app window shrank to ~300px, the
 *    ledger overlapped itself and the card ran to ~2,700px. pages/index.astro
 *    renders it as its own full width section directly after this one, and
 *    stage 04 is drawn like the other four.
 *
 * 2. THE FIGURES ARE DRAWINGS, NOT DASHED BOXES. Each one repeated its own
 *    card's text inside a dashed outline. Each stage now draws the thing the
 *    stage does, from one set of pieces in styles/home.css (`.h-draw`): rows,
 *    a source chip, a state, a meter. Labels only, no figures and no claims.
 *    The slot comment stays so a real capture can replace any one of them.
 *
 * 3. THE CARD HAS ITS PADDING. Bare `.surface` carries none, the design system
 *    puts it on `surface--pad` (styles/surfaces.css), and the meta column sat
 *    flush against the card edge.
 */

interface Stage {
  n: string;
  id: string;
  name: string;
  headline: string;
  summary: string;
  fig: string;
  caption: string;
  draw: 'feed' | 'fit' | 'cite' | 'gate' | 'ledger';
}

/* The drawn rows, one list per kind. Labels come from the stage copy, no
   figures. A meter carries its fill as a width and no number, the way the fit
   bars on /bid/ do, and every drawing is aria-hidden behind its caption. */
const FEED = [
  { label: 'NHS Estates facilities notice', cite: 'Official feed', gap: false, state: 'Indexed' },
  { label: 'Evaluation criteria and weightings', cite: 'Tender pack', gap: false, state: 'Indexed' },
  { label: 'Clarification and submission deadlines', cite: 'Tender pack', gap: false, state: 'Indexed' },
];
const FIT = [
  { label: 'Turnover', w: 88, gap: false, state: 'Met' },
  { label: 'Insurance', w: 76, gap: false, state: 'Met' },
  { label: 'Accreditations', w: 52, gap: true, state: 'Check' },
  { label: 'Mandatory exclusions', w: 94, gap: false, state: 'Clear' },
];
const CITE = [
  { w: 96, cite: 'Tender clause' },
  { w: 88, cite: '' },
  { w: 92, cite: 'Bid library' },
  { w: 64, cite: '' },
];
const GATE = [
  { label: 'Claimed figure', cite: 'Source found', gap: false, state: 'Traced' },
  { label: 'Claimed figure', cite: 'Source found', gap: false, state: 'Traced' },
  { label: 'Computed total', cite: 'Source found', gap: false, state: 'Traced' },
  { label: 'Unsupported claim', cite: 'No source', gap: true, state: 'Refused' },
];
const LEDGER = [
  { label: 'Priced promise', cite: 'Contract KPI', gap: false, state: 'Evidenced' },
  { label: 'Priced promise', cite: 'Contract KPI', gap: false, state: 'Evidenced' },
  { label: 'Annual assessment', cite: 'Section 71', gap: true, state: 'Due' },
];

const STAGES: Stage[] = [
  {
    n: '01',
    id: 'stage-discover',
    name: 'Discover',
    headline: 'Tender notice ingested and indexed',
    summary: 'The NHS Estates facilities tender is picked up from the official public feeds on the daily refresh, with criteria and deadlines indexed.',
    fig: 'Fig 02',
    caption: 'Official feed ingestion: NHS Estates notice indexed with deadlines, criteria and evaluation weightings.',
    draw: 'feed',
  },
  {
    n: '02',
    id: 'stage-qualify',
    name: 'Qualify',
    headline: 'Fit and qualification scored',
    summary: 'Deterministic rubrics evaluate turnover, insurance, accreditations and mandatory exclusions before allocating bid resource.',
    fig: 'Fig 03',
    caption: 'Fit and coverage breakdown: turnover, accreditations and exclusions scored with explicit reasons.',
    draw: 'fit',
  },
  {
    n: '03',
    id: 'stage-draft',
    name: 'Draft',
    headline: 'Responses drafted with clause citations',
    summary: 'Method statements are drafted with inline citations to the tender specifications and your own verified bid library.',
    fig: 'Fig 04',
    caption: 'Cited answer drafting: each response paragraph cites the tender clause and verified past bid records.',
    draw: 'cite',
  },
  {
    n: '04',
    id: 'stage-review',
    name: 'Review',
    headline: 'Grounding gate and refusal scan',
    summary: 'Unsupported claims are refused before human review. Every figure must match verified source data before sign-off.',
    fig: 'Fig 05',
    caption: 'The figure refusal gate: unevidenced figures are identified and refused before the draft is released. The worked example follows below.',
    draw: 'gate',
  },
  {
    n: '05',
    id: 'stage-deliver',
    name: 'Deliver',
    headline: 'Contract commitments evidenced',
    summary: 'Priced promises become contract KPIs in the post-award vault, ready for the mandatory annual section 71 assessment.',
    fig: 'Fig 06',
    caption: 'Post-award obligation ledger: delivery actuals recorded against statutory Procurement Act KPIs.',
    draw: 'ledger',
  },
];
---

<section class="h-stages" id="stages" aria-labelledby="stages-title">
  <div class="h-stages__wrap">
    <div class="h-head">
      <p class="eyebrow h-head__eyebrow">One tender, five stages</p>
      <h2 class="h-head__title" id="stages-title">From notice publication to contract delivery.</h2>
      <p class="h-head__standfirst">
        One realistic NHS Estates facilities tender followed through each stage of the lifecycle.
      </p>
    </div>

    <div class="h-stages__list">
      {
        STAGES.map((s) => (
          <article class="h-stage surface surface--pad surface--row" id={s.id}>
            <div class="h-stage__meta">
              <span class="h-stage__n" aria-hidden="true">{s.n}</span>
              <p class="meta h-stage__step">{s.name}</p>
              <h3 class="h-stage__h">{s.headline}</h3>
              <p class="h-stage__summary">{s.summary}</p>
            </div>

            <div class="h-stage__display">
              <figure class="h-stage__frame sv-raised">
                <div class="h-stage__chrome">
                  <span class="h-stage__dots" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </span>
                  <span class="h-stage__label">{s.name} · {s.fig}</span>
                </div>
                <div class="h-stage__slot">
                  <!-- slot: R285-WEB-PRODUCT-SCREENSHOTS-01 -->
                  {s.draw === 'feed' && (
                    <ul class="h-draw" role="list" aria-hidden="true">
                      {FEED.map((r) => (
                        <li class={`h-draw__row surface--row ${r.state === 'Refused' ? 'h-draw__row--refused' : ''}`}>
                          <span class="h-draw__label">{r.label}</span>
                          <span class="h-draw__cite">{r.cite}</span>
                          <span class={`h-draw__state meta ${r.gap ? 'h-draw__state--gap' : 'h-draw__state--ok'}`}>{r.state}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {s.draw === 'fit' && (
                    <ul class="h-draw" role="list" aria-hidden="true">
                      {FIT.map((r) => (
                        <li class="h-draw__row h-draw__row--meter surface--row">
                          <span class="h-draw__label">{r.label}</span>
                          <span class="h-draw__track">
                            <i class={`h-draw__fill ${r.gap ? 'h-draw__fill--gap' : ''}`} style={`--w: ${r.w}%`}></i>
                          </span>
                          <span class={`h-draw__state meta ${r.gap ? 'h-draw__state--gap' : 'h-draw__state--ok'}`}>{r.state}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {s.draw === 'cite' && (
                    <ul class="h-draw h-draw--prose surface--row" role="list" aria-hidden="true">
                      {CITE.map((r) => (
                        <li class="h-draw__para">
                          <i class="h-draw__line" style={`--w: ${r.w}%`}></i>
                          {r.cite && <span class="h-draw__cite">{r.cite}</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                  {s.draw === 'gate' && (
                    <ul class="h-draw" role="list" aria-hidden="true">
                      {GATE.map((r) => (
                        <li class={`h-draw__row surface--row ${r.state === 'Refused' ? 'h-draw__row--refused' : ''}`}>
                          <span class="h-draw__label">{r.label}</span>
                          <span class="h-draw__cite">{r.cite}</span>
                          <span class={`h-draw__state meta ${r.gap ? 'h-draw__state--gap' : 'h-draw__state--ok'}`}>{r.state}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {s.draw === 'ledger' && (
                    <ul class="h-draw" role="list" aria-hidden="true">
                      {LEDGER.map((r) => (
                        <li class={`h-draw__row surface--row ${r.state === 'Refused' ? 'h-draw__row--refused' : ''}`}>
                          <span class="h-draw__label">{r.label}</span>
                          <span class="h-draw__cite">{r.cite}</span>
                          <span class={`h-draw__state meta ${r.gap ? 'h-draw__state--gap' : 'h-draw__state--ok'}`}>{r.state}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <figcaption class="h-stage__cap">
                  {s.fig}. {s.caption}
                </figcaption>
              </figure>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
