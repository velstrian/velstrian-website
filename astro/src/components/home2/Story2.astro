---
/**
 * HOME 2.0: ONE TENDER, FROM NOTICE TO EVIDENCE.
 *
 * Linear-style Fig 0.x cropped product frames with captions, retired the
 * sticky scroll story per owner-approved premium direction (D1, D250).
 */
import Section from '../layout/Section.astro';
import DeviceChrome from './DeviceChrome.astro';
import { SUPPLIER_SCREENS, BUYER_SCREENS, VARIANT, avifSrcset } from '../../data/crowmark-screens';
import type { Slide } from '../ui/Carousel.astro';

const ALL: Slide[] = [...SUPPLIER_SCREENS, ...BUYER_SCREENS];

function screen(name: string): Slide {
  const hit = ALL.find((s) => s.src.includes(`/${name}${VARIANT}.png`));
  if (!hit) throw new Error(`Story2: no drawn screen named "${name}${VARIANT}" in crowmark-screens.ts`);
  return hit;
}

interface Stage {
  id: string;
  path: string;
  slide: Slide;
  kicker: string;
  title: string;
  body: string;
  banner?: { text: string; src: string };
  note?: string;
}

const STAGES: Stage[] = [
  {
    id: 'screen-discover',
    path: 'mark/discover',
    slide: screen('sup-1-discover'),
    kicker: '01 · Supplier · Discover',
    title: 'Notices you could actually win the argument on.',
    body:
      'Both UK registers are read: Find a Tender and Contracts Finder. Relevance is scored against the evidence you already hold rather than against the words in the notice, and the register a notice came from is named on the notice, so the trail out to the source is one click and not a search.',
    note: 'Relevance is a sorting aid. It is not a forecast of anything.',
  },
  {
    id: 'screen-qualify',
    path: 'mark/qualify',
    slide: screen('sup-3-bid-no-bid'),
    kicker: '02 · Supplier · Bid or no bid',
    title: 'Fit, broken into its parts, with the reason attached.',
    body:
      'The score is decomposed component by component, each with a band, a points total and a one-line reason you can argue with. What it is not is stated on the screen itself, in the product, where a reader cannot miss it.',
    banner: {
      text: 'This is FIT context. It is not a probability of award, and Velstrian Bid does not produce one.',
      src: 'The data confidence panel',
    },
  },
  {
    id: 'screen-draft',
    path: 'mark/draft',
    slide: screen('sup-2-tender-questions'),
    kicker: '03 · Supplier · Draft',
    title: 'The drafter is told where a figure may come from.',
    body:
      'The tender is split into its scored questions, each with its category, word limit and weighting. The boundary the drafter works inside runs across the top of the screen and is not a setting anyone can turn off.',
    banner: {
      text:
        'Answers are AI-assisted and grounded only in your own answer library, the published requirement and your confirmed commitments. Every £ and % comes from your engine-computed commitments and is never invented. A named human reviews, edits and approves every answer before you submit it.',
      src: 'The grounding banner',
    },
  },
  {
    id: 'screen-evaluate',
    path: 'mark/evaluate',
    slide: screen('buy-2-response-review'),
    kicker: '04 · Buyer · Evaluate',
    title: 'It finds the passage. It does not set the band.',
    body:
      'One criterion against one response. The supplier is quoted verbatim and the quote is cited to a section and a page of the response document, so an evaluator checks a reference rather than trusting a summary. The band, and the audit line under it, belong to a named person.',
    banner: {
      text:
        'Velstrian Buy locates the passage that answers this criterion and shows you where it came from. It does not score, rank or recommend. The band is yours to set.',
      src: 'The evaluation banner',
    },
  },
  {
    id: 'screen-evidence',
    path: 'mark/delivery',
    slide: screen('buy-4-delivery-oversight'),
    kicker: '05 · Buyer · After award',
    title: 'A commitment is only worth the evidence filed against it.',
    body:
      'Promises made at award are carried forward as measures, and each measure collects dated evidence against it month by month. The same view carries the next assessment date for each contract, which is the part of the duty that is easiest to lose track of and the hardest to explain later.',
    note:
      'Each contract reads on track, at risk or behind against the evidence received, not against a projection. Suppliers see the other half of this: the same commitments, with the upload that proves each one.',
  },
];

const HOSTNAME = 'app.crowagent.ai';
---

<Section
  eyebrow="The product"
  title="One tender, from notice to evidence."
  standfirst="Five screens along the same contract: finding the notice, deciding whether to bid, drafting the answers, evaluating the responses, and proving delivery afterwards. The wording each screen carries is on the screen, where a reader cannot miss it."
  id="product"
  class="h2st"
  cascade
>
  <div class="h2st__editorial">
    {
      STAGES.map((s, i) => (
        <article class="h2st__item" id={s.id}>
          <div class="h2st__content">
            <p class="meta h2st__kicker">Fig 0{i + 1} · {s.kicker.split('·').slice(1).join('·').trim()}</p>
            <h3 class="h2st__h">{s.title}</h3>
            <p class="h2st__p">{s.body}</p>
            {s.banner && (
              <blockquote class="h2st__quote">
                <p class="h2st__quote-text">&ldquo;{s.banner.text}&rdquo;</p>
                <cite class="meta h2st__quote-cite">{s.banner.src}</cite>
              </blockquote>
            )}
            {s.note && <p class="h2st__p h2st__note">{s.note}</p>}
          </div>

          <!-- slot: R285-WEB-PRODUCT-SCREENSHOTS-01 -->
          <figure class="surface surface--frame surface--row h2st__frame" aria-label={`Fig 0${i + 1}: ${s.title}`}>
            <DeviceChrome host={`${HOSTNAME}/`} path={s.path} />
            <picture class="h2st__screen">
              <source
                type="image/avif"
                srcset={avifSrcset(s.slide.src, s.slide.width)}
                sizes="(min-width: 62rem) 50vw, 100vw"
              />
              <img
                src={s.slide.src}
                width={s.slide.width}
                height={s.slide.height}
                alt={s.slide.alt}
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption class="meta h2st__caption">Fig 0{i + 1} &mdash; {s.slide.caption || s.title}</figcaption>
          </figure>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .h2st__editorial {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-10), 6vw, var(--space-16));
  }

  .h2st__item {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .h2st__item {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: clamp(var(--space-8), 4vw, var(--space-12));
    }

    .h2st__item:nth-child(even) .h2st__content {
      order: 2;
    }

    .h2st__item:nth-child(even) .h2st__frame {
      order: 1;
    }
  }

  .h2st__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .h2st__kicker {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-teal);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .h2st__h {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--t-w-h3);
    line-height: var(--lh-snug);
    color: var(--c-text);
  }

  .h2st__p {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-relaxed);
    color: var(--c-text-sub);
  }

  .h2st__quote {
    margin: var(--space-2) 0 0;
    padding: var(--space-3) var(--space-4);
    border-inline-start: 2px solid var(--c-teal-dark);
    background-color: color-mix(in srgb, var(--c-floor) 60%, transparent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .h2st__quote-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.55;
    color: var(--c-text);
  }

  .h2st__quote-cite {
    display: block;
    margin-block-start: var(--space-2);
    font-style: normal;
    font-size: var(--t-micro);
    color: var(--c-text-muted);
  }

  .h2st__note {
    font-size: var(--t-caption);
    color: var(--c-text-muted);
  }

  .h2st__frame {
    margin: 0;
    overflow: hidden;
    background-color: var(--c-panel);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
  }

  .h2st__screen {
    display: block;
    aspect-ratio: 16 / 10;
    background-color: var(--c-lit);
    overflow: hidden;
  }

  .h2st__screen img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .h2st__caption {
    display: block;
    padding: var(--space-2) var(--space-4);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
    border-block-start: 1px solid var(--c-border);
    background-color: var(--c-raised);
  }
</style>
