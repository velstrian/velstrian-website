---
/**
 * HomeTrustSummary.astro: Concise enterprise trust summary (R285-WEB-ENTERPRISE-REDESIGN-01).
 *
 * Sits directly on the main buying path:
 * - Company registration: Velstrian Systems Ltd, 17076461, England and Wales
 * - Data storage: EU (Dublin, Ireland)
 * - Model privacy: Named enterprise providers, zero customer data training
 * - Refusal gate: Figures without direct evidence are refused
 * - Human governance: Human approval required for all submissions
 * - Status: https://status.velstrian.com
 * - Security link: /security/
 * - ZERO certification badges (company holds none).
 */
import { STATUS_URL } from '../../lib/brand-names';

interface TrustPoint {
  title: string;
  detail: string;
}

const TRUST_POINTS: TrustPoint[] = [
  {
    title: 'Company registration',
    detail: 'Velstrian Systems Ltd, Company No. 17076461, incorporated and registered in England and Wales.',
  },
  {
    title: 'Data residency',
    detail: 'Customer data is hosted in the European Union (Dublin, Ireland) on secure enterprise cloud infrastructure.',
  },
  {
    title: 'Model privacy',
    detail: 'AI drafting uses named enterprise providers. Customer data is never used to train foundation models.',
  },
  {
    title: 'Figure refusal gate',
    detail: 'Deterministic grounding engine. Any figure in generated text without direct source evidence is refused.',
  },
  {
    title: 'Human governance',
    detail: 'Human in the loop on every submission. The platform assists drafting but never signs off or submits.',
  },
  {
    title: 'Platform availability',
    detail: 'Real-time uptime and incident tracking published independently at status.velstrian.com.',
  },
];
---

<section class="h-trust" id="trust" aria-labelledby="trust-title">
  <div class="h-trust__wrap">
    <div class="h-head">
      <p class="eyebrow h-head__eyebrow">Security and governance</p>
      <h2 class="h-head__title" id="trust-title">Architected for audit and compliance.</h2>
      <p class="h-head__standfirst">
        Clear data boundaries, European hosting, and deterministic verification on every draft.
      </p>
    </div>

    <div class="h-trust__grid">
      {
        TRUST_POINTS.map((tp) => (
          <article class="h-trust__card surface surface--pad">
            <h3 class="h-trust__h">{tp.title}</h3>
            <p class="h-trust__p">{tp.detail}</p>
          </article>
        ))
      }
    </div>

    <div class="h-trust__footer">
      <p class="h-trust__note">
        For complete technical architecture, encryption protocols and tenant isolation, read our <a href="/security/">Security Architecture</a>. System status is monitored live at <a href={STATUS_URL} target="_blank" rel="noopener noreferrer">status.velstrian.com</a>.
      </p>
    </div>
  </div>
</section>
