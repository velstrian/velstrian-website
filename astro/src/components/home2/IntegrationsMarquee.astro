---
/**
 * HOME 2.0: YOUR EVIDENCE ALREADY EXISTS. WE READ IT WHERE IT LIVES.
 *
 * The live homepage's Integrations section: the same heading, the same chips
 * with the same scopes, the same read-only statement, the same link. The chips
 * come from src/data/integrations.ts, the one file the /integrations page and
 * the live homepage both read, so a connector added there appears here.
 *
 * ── TEXT CHIPS, NOT LOGO FILES ─────────────────────────────────────────────
 *
 * scripts/check-vendor-logos.js fails the build on any mark served without a
 * provenance row. Setting a name in the site's own type asserts nothing about
 * a trade mark and needs no such row.
 *
 * ── THE LOOP IS ONE KEYFRAME ON translateX AND NO JAVASCRIPT ───────────────
 *
 * The track is duplicated once and travels exactly its own width, so the copy
 * arrives where the original left and the seam never shows. The gap lives on
 * the chip's trailing margin so one track's width includes its own trailing
 * space and the travel is a plain -100%, which is what lets check-motion.js
 * read it as the loop it is. The duplicate half is aria-hidden so the list is
 * announced once. Pause on hover and focus-within is CSS. Under reduced motion
 * the animation does not exist and the chips wrap into a static grid.
 */
import Section from '../layout/Section.astro';
import { HOME_CHIPS, IDENTITY } from '../../data/integrations';

/* The six the live homepage shows, plus the two identity providers it does
   not, so the loop is long enough to travel at every width. Ping and OneLogin
   are on /integrations with the same scope line. */
const CHIPS = [...HOME_CHIPS, ...IDENTITY.filter((c) => /Ping|OneLogin/.test(c.name))];
---

<Section
  eyebrow="Plugged in, read only"
  title="Your evidence already exists. We read it where it lives."
  id="integrations"
  class="h2mq"
  bleed
  cascade
>
  <div class="h2mq__viewport">
    <ul class="h2mq__track">
      {
        CHIPS.map((c) => (
          <li class="h2mq__chip">
            <span class="h2mq__name">{c.name}</span>
            <span class="h2mq__scope">{c.scope}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="h2mq__note">
    Every source above is read only. We do not write to your files, change a setting in your
    tenant, or create an account.
  </p>
  <p class="h2mq__more">
    <a href="/integrations/">Every connector, with the exact scope it is granted.</a>
  </p>
</Section>

<style>
  .h2mq__viewport {
    display: flex;
    justify-content: center;
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-4);
  }

  .h2mq__track {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A chip, at --radius-chip: not the card recipe. */
  .h2mq__chip {
    display: grid;
    justify-items: center;
    gap: 2px;
    flex: 0 0 auto;
    min-inline-size: 11.5rem;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-chip);
    background-color: var(--c-card);
    text-align: center;
    white-space: nowrap;
  }

  .h2mq__name {
    font-family: var(--font-display);
    font-size: var(--t-body);
    font-weight: var(--t-w-h3);
    line-height: var(--lh-tight);
    color: var(--c-text);
  }

  .h2mq__scope {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-tight);
    color: var(--c-text-muted);
  }

  .h2mq__note {
    margin: var(--space-8) auto 0;
    padding-inline: var(--gutter);
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.55;
    color: var(--c-text-sub);
    text-align: center;
    max-width: 52ch;
    text-wrap: balance;
  }

  .h2mq__more {
    margin: var(--space-3) 0 0;
    padding-inline: var(--gutter);
    font-family: var(--font-body);
    font-size: var(--t-caption);
    color: var(--c-text-muted);
    text-align: center;
  }
</style>
