---
/**
 * HomeWalkthrough.astro: the tender walkthrough, as a stepped index
 * (R285-WEB-ENTERPRISE-REDESIGN-01, corrected under R285-WEB-HOME-FORMAT-01).
 *
 * WHAT IT WAS, AND WHY IT CHANGED (2026-10-21). It shipped as a video window
 * with a play button that played nothing, and a footer that showed visitors two
 * internal tracker row IDs. A play control with no video is a broken promise
 * on the first click, so the affordance is gone. What stays is honest: the same
 * four steps the video caption named, each one a link to the stage above where
 * it is drawn, so the walkthrough is the one tender on this page.
 *
 * The slot comment stays, so the real capture replaces this list when it
 * exists. No figures and no claims are added here.
 *
 * The links are direct children of a <nav>, not of an <li>: links.css gives
 * `li > a` 4px of block padding for inline target size, which overrode
 * `surface--pad` on a link that is itself the card.
 */

const STEPS = [
  { n: '01', name: 'Notice retrieval', href: '#stage-discover' },
  { n: '02', name: 'Criteria matching', href: '#stage-qualify' },
  { n: '03', name: 'Clause citations', href: '#stage-draft' },
  { n: '04', name: 'The figure refusal gate', href: '#reasoning' },
];
---

<section class="h-walkthrough" id="walkthrough" aria-labelledby="walkthrough-title">
  <div class="h-walkthrough__wrap">
    <div class="h-head">
      <p class="eyebrow h-head__eyebrow">Product walkthrough</p>
      <h2 class="h-head__title" id="walkthrough-title">See a real tender walkthrough.</h2>
      <p class="h-head__standfirst">
        Follow how a tender moves from initial notice ingestion through cited drafting to verified evidence assembly.
      </p>
    </div>

    <!-- slot: R285-WEB-PROMO-VIDEOS-01 -->
    <nav class="h-walkthrough__steps" aria-label="Walkthrough steps">
      {
        STEPS.map((s) => (
          <a class="h-walkthrough__link surface surface--pad" href={s.href}>
            <span class="meta h-walkthrough__n">Step {s.n}</span>
            <span class="h-walkthrough__name">{s.name}</span>
          </a>
        ))
      }
    </nav>
  </div>
</section>
