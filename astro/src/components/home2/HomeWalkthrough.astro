---
/**
 * HomeWalkthrough.astro — Real tender walkthrough slot (R285-WEB-ENTERPRISE-REDESIGN-01).
 *
 * Points from hero action. Marked slot for Claude's real product video (V1).
 * Never fake UI.
 */
---

<section class="h-walkthrough" id="walkthrough" aria-labelledby="walkthrough-title">
  <div class="h-walkthrough__wrap">
    <div class="h-head">
      <p class="eyebrow h-head__eyebrow">Product walkthrough</p>
      <h2 class="h-head__title" id="walkthrough-title">See a real tender walkthrough.</h2>
      <p class="h-head__standfirst">
        Watch how a tender moves from initial notice ingestion through cited drafting to verified evidence assembly.
      </p>
    </div>

    <div class="h-walkthrough__box surface">
      <div class="h-walkthrough__bar">
        <span class="h-walkthrough__dots" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
        <span class="h-walkthrough__title">Velstrian Bid · Complete Workflow Video Walkthrough</span>
      </div>
      <div class="h-walkthrough__stage">
        <!-- slot: R285-WEB-PROMO-VIDEOS-01 -->
        <div class="h-walkthrough__slot">
          <div class="h-walkthrough__play" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
              <circle cx="24" cy="24" r="23" stroke="var(--c-border)" stroke-width="2" />
              <polygon points="20,16 32,24 20,32" fill="var(--c-interactive-fill)" />
            </svg>
          </div>
          <p class="h-walkthrough__kicker">Velstrian Bid Workflow Demonstration (V1)</p>
          <p class="h-walkthrough__caption">
            Comprehensive product walkthrough showing notice retrieval, criteria matching, clause citations and the figure refusal gate.
          </p>
        </div>
      </div>
      <p class="h-walkthrough__foot">
        Video capture in progress (R285-WEB-PROMO-VIDEOS-01). Interactive walkthrough scheduled under row R285-WEB-INTERACTIVE-WALKTHROUGH-01.
      </p>
    </div>
  </div>
</section>
