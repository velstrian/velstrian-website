---
/**
 * Sector.astro: layout for /sectors/construction, education, facilities and
 * highways.
 *
 * ── 2026-10-22: ON DESIGN SYSTEM VERSION 3 ──────────────────────────────────
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy 0.7: the four pages keep every
 * word of their Markdown and frontmatter, and move onto the v3 bands.
 *
 *   1. PageHero   light      is this for my sector?   trail, sector, lead, two actions
 *   2. Context    light      who asks, what is hard?  the Markdown, beside its heading
 *   3. Helps      light alt  how does it help?        numbered steps beside the screen
 *   4. Detail     light      for when you need it     the rules and terms, one tap each
 *   5. Questions  light alt  what do people ask?      the FAQ, the same list as the FAQPage data
 *   6. Close      gradient   what now?                into the footer
 *
 * ── PLAIN WORDS FIRST, PUBLIC AND PRIVATE (R285-WEB-TRANSFORMATION-WT-B) ────
 * Audit M7 and S12, 2026-10-22: the four pages opened on public works only and
 * on jargon (CPV codes, TOMs, PPN 017, frameworks) in a 130 word paragraph, and
 * repeated "advisory and not legal advice" in every step. RULE 0-U: the reader
 * is a small firm bidding for public AND private work. The Markdown now names
 * both kinds of client in plain words. Every rule and term the old copy carried
 * is still on the page, in the Detail band, closed by default (the native
 * <details> recipe /bid/ uses), each one explained where it appears. The first
 * Detail row is built here from site-facts.ts, so the live source list and the
 * refresh time are never typed into four Markdown files. The steps were a 2 by
 * 2 grid of identical cards and are now a numbered sequence beside the screen.
 *
 * The FAQ list is also the FAQPage JSON-LD source, so its wording cannot drift
 * between the page and the data. The visible trail is drawn by the one
 * Breadcrumb component from the same array the BreadcrumbList is built from.
 * The product screen (ProductScreen, by the `screen` name in the Markdown)
 * sits in a Frame on a Stage like every other
 * product view on the site, its own caption saying it is a drawing.
 */
import Base from './Base.astro';
import PageHero from '../components/evidenced/PageHero.astro';
import Band from '../components/evidenced/Band.astro';
import Action from '../components/evidenced/Action.astro';
import ProductScreen, { type ScreenName } from '../components/evidenced/ProductScreen.astro';
import Close from '../components/evidenced/Close.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { SIGNUP_URL, START_LABEL } from '../data/app';
import { TRIAL_NOTE } from '../data/pricing';
import { PRODUCT_NAME_BID } from '../lib/brand-names';
import { breadcrumbs } from '../lib/schema';
import { LIVE_SOURCES, ON_REQUEST_SENTENCE, REFRESH_TIME } from '../data/site-facts';
import '../styles/evidenced.css';
import '../styles/prose.css';

interface Step {
  accent: 'teal' | 'violet' | 'sky';
  verb: string;
  say: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface DetailItem {
  heading: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  ogDescription: string;
  ogImageAlt: string;
  path: string;
  sectorLabel: string;
  heroTitleAccent: string;
  heroDescription: string;
  contextEyebrow: string;
  contextHeading: string;
  helpsHeading: string;
  steps: Step[];
  helpsIntro: string;
  screen: ScreenName;
  faqHeading: string;
  finalCtaSub: string;
  faq: FaqItem[];
  detail: DetailItem[];
}

const {
  title,
  description,
  ogDescription,
  ogImageAlt,
  path,
  sectorLabel,
  heroTitleAccent,
  heroDescription,
  contextEyebrow,
  contextHeading,
  helpsHeading,
  steps,
  helpsIntro,
  screen,
  faqHeading,
  finalCtaSub,
  faq,
  detail,
} = Astro.props;

/* The one row every sector shares, from site-facts.ts, never typed. */
const sourcesRow: DetailItem = {
  heading: 'Where public contracts come from',
  body: `Public buyers must advertise most contracts on official listing sites. ${PRODUCT_NAME_BID} reads ${LIVE_SOURCES} every morning at ${REFRESH_TIME} and names the site on every notice. ${ON_REQUEST_SENTENCE} Private clients rarely advertise, so you upload the tender they send you.`,
};
const rows = [sourcesRow, ...detail];

const ogImage = '/Assets/og/crowmark.png';
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Sectors', path: '/sectors/' },
];
const schema: Record<string, unknown>[] = [breadcrumbs([...trail, { name: sectorLabel, path }])];
if (faq.length) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
---

<Base
  title={title}
  description={description}
  ogDescription={ogDescription}
  twitterTitle={title}
  twitterDescription={ogDescription}
  path={path}
  image={ogImage}
  imageAlt={ogImageAlt}
  schema={schema}
  typeface="evidenced"
  headerTone="light"
>
  <PageHero id="sector-title" label={sectorLabel} title={`Stronger bids for ${heroTitleAccent}`} lead={heroDescription}>
    <div slot="before" class="ea-trail"><Breadcrumb trail={trail} current={sectorLabel} /></div>
    <Action href={SIGNUP_URL}>{START_LABEL}</Action>
    <Action href="/bid/" variant="secondary">Explore {PRODUCT_NAME_BID}</Action>
    <Fragment slot="note">{TRIAL_NOTE}</Fragment>
  </PageHero>

  <Band tone="light" labelledby="sector-context-title">
    <div class="ea-wrap ea-split">
      <div class="ea-split__head" data-reveal>
        <p class="ea-label">{contextEyebrow}</p>
        <h2 class="ea-h2" id="sector-context-title">{contextHeading}</h2>
      </div>
      <div class="ea-split__body prose" data-reveal>
        <slot />
      </div>
    </div>
  </Band>

  <Band tone="light-alt" labelledby="sector-helps-title">
    <div class="ea-wrap">
      <div class="ea-head-row" data-reveal>
        <div class="ea-split__head">
          <p class="ea-label">How {PRODUCT_NAME_BID} helps</p>
          <h2 class="ea-h2" id="sector-helps-title">{helpsHeading}</h2>
        </div>
        <p class="ea-lead">{helpsIntro}</p>
      </div>

      <div class="ea-panel sector-helps">
        <ol class="sector-steps" role="list">
          {
            steps.map((step, i) => (
              <li class="sector-step" data-reveal>
                <p class="sector-step__n ea-num" aria-hidden="true">{i + 1}</p>
                <div class="sector-step__body">
                  <h3 class="ea-h3">{step.verb}</h3>
                  <p>{step.say}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="sector-screen" data-reveal>
          <ProductScreen name={screen} />
        </div>
      </div>
    </div>
  </Band>

  <Band tone="light" labelledby="sector-detail-title">
    <div class="ea-wrap ea-split">
      <div class="ea-split__head" data-reveal>
        <p class="ea-label">For when you need it</p>
        <h2 class="ea-h2" id="sector-detail-title">The rules and words, explained.</h2>
        <p class="sector-detail__intro">You do not need any of this to start. Open a line when a rule or a word comes up in a tender.</p>
      </div>
      <div class="ea-split__body" data-reveal>
        {
          rows.map((r) => (
            <details class="ea-qa">
              <summary><h3 class="sector-row__h">{r.heading}</h3></summary>
              <p>{r.body}</p>
            </details>
          ))
        }
      </div>
    </div>
  </Band>

  <Band tone="light-alt" class="ea-faq" labelledby="faq-h">
    <div class="ea-wrap ea-faq__wrap">
      <p class="ea-label sector-faq__label" data-reveal>Questions</p>
      <h2 class="ea-h2 ea-h2--centre" id="faq-h" data-reveal>{faqHeading}</h2>
      <div class="ea-faq__list" data-reveal>
        {
          faq.map((f) => (
            <details class="ea-qa">
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))
        }
        <p class="ea-faq__more"><a class="ea-link" href="/sectors/">All sectors</a></p>
      </div>
    </div>
  </Band>

  <Close
    title="Find the work. Win it. Prove you delivered."
    lead={finalCtaSub}
  />
</Base>

<style>
  /* The steps beside the screen: a numbered sequence on hairlines, not a grid
     of identical cards. The panel is the shared .ea-panel row, one column
     below 960px (styles/evidenced.css). */
  .sector-helps {
    align-items: start;
    margin-top: var(--ea-head-gap);
  }

  .sector-steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ea-rule);
  }

  .sector-step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--ea-rule);
  }

  .sector-step__n {
    min-width: 2ch;
    font-size: var(--t-ea-h3);
    font-weight: var(--t-w-ea-medium);
    line-height: 1.3;
    color: var(--ea-accent-ink);
    font-variant-numeric: tabular-nums;
  }

  .sector-step__body {
    display: grid;
    gap: var(--space-2);
  }

  .sector-step__body p {
    color: var(--ea-sub);
  }

  .sector-detail__intro {
    color: var(--ea-sub);
  }

  /* A heading inside a summary reads as the summary line. */
  .sector-row__h {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .sector-faq__label {
    text-align: center;
    margin-bottom: var(--space-3);
  }
</style>
