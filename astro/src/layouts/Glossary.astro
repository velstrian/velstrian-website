---
/**
 * Glossary.astro: layout for /glossary/ppn-026 and /glossary/toms-framework.
 *
 * ── 2026-10-22: ON DESIGN SYSTEM VERSION 3 ──────────────────────────────────
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy 0.7. Every word of each entry is
 * kept, on the v3 bands: a compact PageHero (trail, the expansion as the
 * label, the term as the h1, the lead), the definition beside its two rail
 * cards on a light band, and the Close with the entry's own heading. The
 * "Back to glossary" link is now the visible trail, which links the glossary
 * the same way and is fed from the same array as the BreadcrumbList.
 * The article keeps its own rules below and carries `ea-longform`, so the v3
 * reset leaves its spacing and lists alone.
 *
 * The main definition (TL;DR box, lead paragraphs, the facts list, "How
 * CrowAgent uses this term") is the <slot/>, sourced verbatim as HTML from
 * the term's Markdown file. The two sidebar cards and the "Read more" link
 * are structured props instead, because their shape (kicker + title + body
 * + CTA) repeats identically across both pages and typing it catches a
 * missing field at build time rather than a silent blank card.
 */
import Base from './Base.astro';
import PageHero from '../components/evidenced/PageHero.astro';
import Band from '../components/evidenced/Band.astro';
import Action from '../components/evidenced/Action.astro';
import Close from '../components/evidenced/Close.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { PRODUCT_NAME_BID } from '../lib/brand-names';
import '../styles/evidenced.css';
import { breadcrumbs } from '../lib/schema';
import { routeUrl } from '../lib/route-url';

interface Props {
  title: string;
  description: string;
  ogTitle: string;
  ogDescription: string;
  ogImage: string;
  ogImageAlt: string;
  path: string;
  termName: string;
  termTagline: string;
  heroDescription: string;
  definedTermDescription: string;
  sidebarKicker: string;
  sidebarTitle: string;
  sidebarBody: string;
  sidebarHref: string;
  sidebarCta: string;
  productCardBody: string;
  readMoreHref: string;
  readMoreLabel: string;
  readMoreBody: string;
  ctaHeading: string;
  ctaSub: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogImageAlt,
  path,
  termName,
  termTagline,
  heroDescription,
  definedTermDescription,
  sidebarKicker,
  sidebarTitle,
  sidebarBody,
  sidebarHref,
  sidebarCta,
  productCardBody,
  readMoreHref,
  readMoreLabel,
  readMoreBody,
  ctaHeading,
  ctaSub,
} = Astro.props;

/*
 * EVERY URL HERE IS DERIVED, AND THE TRAIL IS BUILT BY THE HELPER.
 *
 * This file used to hold its own `new URL(path, SITE.origin).href` and then
 * hand-write three ListItems with three more origin-plus-string templates. All
 * four omitted the trailing slash, which is the 308 source on a
 * directory-format build, so /glossary, /glossary/ppn-002 and
 * /glossary/toms-framework each advertised a redirect from inside their own
 * structured data. lib/route-url.ts carries the measurement.
 *
 * The hand-written BreadcrumbList is gone for the reason layouts/Compare.astro
 * records against the same shape: a trail written out item by item is a second
 * statement of the ancestry, kept in step by whoever remembers. One array
 * through breadcrumbs() makes the positions, the shape and now the URL form a
 * property of the helper rather than of this file. scripts/check-breadcrumbs.js
 * fails the build if the graph and the visible nav diverge.
 */
const canonical = routeUrl(path);

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Glossary', path: '/glossary/' },
];

const schema: Record<string, unknown>[] = [
  {
    '@type': 'DefinedTerm',
    name: termName,
    description: definedTermDescription,
    url: canonical,
    inDefinedTermSet: {
      '@type': 'DefinedTermSet',
      name: 'Velstrian UK Public Procurement and Bid Glossary',
      url: routeUrl('/glossary'),
    },
  },
  breadcrumbs([...trail, { name: termName, path }]),
];
---

<Base
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  twitterTitle={ogTitle}
  twitterDescription={ogDescription}
  path={path}
  image={ogImage}
  imageAlt={ogImageAlt}
  type="article"
  schema={schema}
  typeface="evidenced"
  headerTone="light"
>
  <PageHero id="gl-title" size="compact" label={termTagline} title={termName} lead={heroDescription}>
    <div slot="before" class="ea-trail"><Breadcrumb trail={trail} current={termName} /></div>
  </PageHero>

  <Band tone="light" class="gl-content">
    <div class="ea-wrap gl-grid">
      <article class="gl-article ea-longform">
        <slot />
        <h2>Read more</h2>
        <p><a href={readMoreHref}>{readMoreLabel}</a> {readMoreBody}</p>
      </article>
      <aside class="gl-rail" aria-label="Related links">
        <div class="ea-card ea-tcard">
          <p class="ea-label">{sidebarKicker}</p>
          <h3 class="ea-h3">{sidebarTitle}</h3>
          <p>{sidebarBody}</p>
          <div class="ea-actions gl-rail__act">
            <Action href={sidebarHref}>{sidebarCta}</Action>
          </div>
        </div>
        <div class="ea-card ea-tcard">
          <p class="ea-label">Full product</p>
          <h3 class="ea-h3">{PRODUCT_NAME_BID}</h3>
          <p>{productCardBody}</p>
          <div class="ea-actions gl-rail__act">
            <Action href="/bid/" variant="secondary">See how {PRODUCT_NAME_BID} works</Action>
          </div>
        </div>
      </aside>
    </div>
  </Band>

  <Close title={ctaHeading} lead={ctaSub} />
</Base>

<style>
  .gl-grid {
    display: grid;
    gap: var(--sec-gap);
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .gl-grid {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }

  /* --t-h2. These are the definition's own sections ("Key facts", "How
     CrowAgent uses this term", "Read more") and the page's closing CTA renders
     an h2 at --t-h2 a few hundred pixels below them. Two h2 sizes on one page
     was the visible half of the sitewide heading drift. */
  .gl-article :global(h2) {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: var(--t-w-h2);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-text);
    margin: var(--sec-gap) 0 var(--stack-2);
  }
  .gl-article :global(p) {
    font-size: var(--t-lede);
    line-height: 1.7;
    color: var(--c-text-sub);
    margin: 0 0 1.25rem;
  }
  .gl-article :global(ul) {
    margin: 0 0 1.25rem;
    padding-inline-start: 1.4rem;
  }
  .gl-article :global(li) {
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--c-text-sub);
    margin: 0 0 0.6rem;
  }
  .gl-article :global(a) {
    color: var(--c-interactive);
    font-weight: 700;
  }
  /* 800 -> --t-w-h3, 2026-08-31, SAME OWNER REPORT. An inline `strong` was set
     heavier than every heading on the page and heavier than anything the
     display scale reaches: G15 in tokens.css took the h1 off 800 in 2026-08-03
     on nine measured comparators, none of which exceeds 700, and this rule
     quietly kept the weight G15 removed and spent it on body copy. The glossary
     entries lean on `strong` hard, twelve to twenty per page, so at 800 a
     paragraph read as a paragraph of headings. It is a token now rather than a
     literal, and it is the same 700 the headings above it use, which is the
     ceiling this scale has. */
  .gl-article :global(strong) {
    color: var(--c-text);
    font-weight: var(--t-w-h3);
  }
  /* THE FILL AND THE EDGE COME FROM styles/surfaces.css, WHICH ALREADY GIVES
     THIS BLOCK A CARD.
     They were `rgba(45, 212, 191, 0.08)` and `rgba(45, 212, 191, 0.2)`, raw
     teal, written twice, and the only two colour literals left in a layout on
     this site. check-palette-roles.js could not see them: it read hue-named
     TOKENS, and a hex or an rgb() is the same decision written one step closer
     to the pixel. check-design-system.js rule 4 could not see them either. It
     matches `#hex` and these were rgb(). Two gates about colour, one blind spot
     between them, which is the shape every finding in this pass had. Rule 3 of
     the palette gate now reads literals, and it fails on this line if it comes
     back.
     THE FIX IS NOT A TOKEN, IT IS DELETING THE FORK. surfaces.css already sets
     `border: 1px solid var(--c-border)` and `background: var(--c-card)` on
     .gl-tldr alongside .prose-card, .gl-fact and the rest, and this rule was
     overriding both from an unlayered scoped block. What the tint claimed is
     also wrong now: teal on this site is --c-verified, evidence, and a summary
     of a definition is not evidence of anything. Under V6 the owner moved even
     the lit edge off teal for the same reason. So the block keeps its padding,
     its radius and its margin, which are its own, and takes its surface from
     the one place a surface is decided. */
  /* ── ONE ENTRY DROPPED ITS TL;DR ON 2026-08-31, AND WHY IT IS NOT A BUG ───
   *
   * The owner asked what the TL;DR on /glossary/ppn-026 was for. It was for
   * nothing, on that page, and it is gone from that entry's markdown. The
   * recipe stays here and stays in use on /glossary/toms-framework, so the next
   * reader who finds one entry with a summary and one without has this note
   * rather than a guess.
   *
   * THE TEST IS WHETHER IT COMPRESSES OR REPEATS, and the two entries answer it
   * differently because they are different lengths. toms-framework runs to four
   * sections and its summary is three ABSTRACTIONS of them, none longer than a
   * dozen words ("themes, then outcomes, then measures"), so a reader who stops
   * at the box still leaves with the shape of the thing.
   *
   * ppn-026 IS DELIBERATELY THIN. It is a policy note with five cited facts and
   * an explicit section saying it will not state anything beyond them. Its
   * TL;DR was four FULL SENTENCES carrying the publication date, the
   * application date, the threshold and both weightings, sitting directly above
   * a standfirst and two paragraphs carrying the publication date, the
   * application date, the threshold and both weightings, under a hero
   * description that had already carried all four. Three statements of the same
   * facts inside about 250 vertical pixels. A summary the same length as its
   * source is not a summary, it is the page said twice, and on a compliance
   * page it doubles the surface that has to be corrected when an instrument
   * moves.
   *
   * NOTHING WAS LOST. Three of its four bullets duplicated the body outright.
   * The fourth, why the edition matters to a bid being drafted now, appeared
   * nowhere else on the page and is now a sentence in the third paragraph.
   *
   * SO THE RULE FOR A NEW ENTRY: a summary earns its place when a reader would
   * otherwise have to read several sections to get the shape. On an entry short
   * enough to read whole, it is duplication with an arrow in front of it. */
  .gl-article :global(.gl-tldr) {
    padding: var(--blk-pad);
    border-radius: var(--radius-card);
    margin: 0 0 2.5rem;
  }
  /* THE TL;DR BOX IS A CARD, SO ITS HEADING IS A CARD HEADING: --t-h4, the
     tier tokens.css defines as "a heading inside a card".
     It was --t-micro, a 13px h2, the smallest heading on the site and half
     the size of the body text under it. That is a label wearing a heading tag,
     and the treatment said so: uppercase, letter-spaced, muted.
     The <h2> tag itself is correct and stays. "TL;DR" is a top-level section of
     the definition, alongside "Key facts" and "Read more", so demoting it to h3
     would skip a level; and its structural depth is not what decides its size.
     See the report note about retagging it in src/content/glossary/*.md. That
     is not needed, and would be wrong. */
  .gl-article :global(.gl-tldr h2) {
    font-size: var(--t-h4);
    font-weight: var(--t-w-h3);
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--c-text);
    margin: 0 0 var(--stack-2);
  }
  .gl-article :global(.gl-tldr ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  /* ── THE EMPHASIS WAS NESTED THREE DEEP AND NOTHING RECEDED ──────────────
   *
   * Owner, 2026-08-31, on /glossary/ppn-026: the type is oversized and over
   * bolded. Measured on the built page, 37 elements on that route were at
   * weight 600 or heavier, and the TL;DR was the densest of them:
   *
   *     li     600   the whole line, every word of it
   *     span   600   inherited, and the markup wraps each line in one
   *     strong  800   the label inside that
   *     ::before 800  the arrow marker as well
   *
   * A "bold" label inside a line that is already semibold is not emphasis, it
   * is two weights that a reader cannot tell apart, and a summary block set
   * entirely in semibold shouts its way past the definition it is summarising.
   * Emphasis only exists relative to something that is NOT emphasised.
   *
   * SO THE LINE RECEDES TO THE BODY WEIGHT AND ONLY THE LABEL IS STRONG. The
   * `strong` in each bullet is the label ("What it is:", "How it works:") and
   * that is genuinely the scannable half, so it keeps its emphasis and now has
   * something to be emphatic against. --t-w-body rather than a literal 400,
   * because the weight of body copy is a token this site already owns.
   *
   * THE ARROW COMES DOWN WITH IT. It is a marker, not a word: at 800 it was
   * heavier than every heading on the page, including the h1. --t-w-h3 is the
   * display weight the rest of the scale tops out at, and a 700 arrow beside a
   * 400 line is still unmistakably a marker. */
  .gl-article :global(.gl-tldr li) {
    display: flex;
    gap: 0.75rem;
    font-size: var(--t-body);
    font-weight: var(--t-w-body);
    color: var(--c-text);
    margin: 0;
  }
  .gl-article :global(.gl-tldr li::before) {
    content: '\2192';
    color: var(--c-verified);
    font-weight: var(--t-w-h3);
  }
  /* THE STANDFIRST IS A SENTENCE, NOT A HEADING, AND 700 WAS MAKING IT ONE.
     Same owner report. It is set at --t-h4 over body copy at --t-lede, so the
     size alone already separates it by 1.04 and the weight was carrying the
     rest of the distinction at the same 700 the h2 above it uses. A standfirst
     that matches its own heading's weight reads as a second heading. --t-w-body
     leaves the size and the --c-text fill doing the work, which is what every
     other lede on this site does. */
  .gl-article :global(.gl-lead) {
    font-size: var(--t-h4);
    font-weight: var(--t-w-body);
    color: var(--c-text);
    line-height: 1.5;
  }
  /* Card treatment from `surface`, which names .gl-fact because this markup is
     authored in src/content/glossary and cannot carry the class. */
  .gl-article :global(.gl-fact) {
    padding: var(--blk-pad);
    margin: 0 0 var(--sec-gap);
  }
  .gl-article :global(.gl-fact ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .gl-article :global(.gl-fact li) {
    margin: 0;
  }


  .gl-rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 1024px) {
    .gl-rail {
      position: sticky;
      top: calc(var(--v3-header-h) + var(--space-8));
    }
  }

  .gl-rail__act {
    display: grid;
    margin-top: var(--space-2);
  }
</style>
