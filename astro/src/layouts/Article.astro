---
/**
 * Article.astro: the blog post layout.
 *
 * A1 "Dark hero to light reading pane", Figma `183:3` on page
 * `Page — Blog article` (`183:2`), chosen by the owner from the six article
 * renders on 2026-08-02. See specs/DESIGN-DECISIONS.md section 6.
 *
 * THE HARD CUT IS THE WHOLE IDEA. A dark band carries the breadcrumb, the
 * headline and the byline; at a fixed point it stops dead and a light reading
 * pane begins, with a 1px teal hairline on the seam so the change reads as an
 * edit rather than as a rendering fault. It is not a gradient and must never
 * become one: a soft transition is what a mistake looks like.
 *
 * WHY A LIGHT PANE AT ALL, quoting the frame: long-form prose on a near-black
 * ground is the one place the dark theme costs the reader real comprehension,
 * and a light pane is the honest fix. The cost is that the page stops matching
 * the rest of the site below the fold, which is the trade the owner judged
 * from the render.
 *
 * THE BAND REVERSES AT THE FOOT. The related-articles rail below the pane is
 * dark, so the light pane is bracketed by the site rather than terminating it.
 * That reversal is what stops the pane reading as a different website; it is
 * load-bearing, not decoration.
 *
 * THE HERO STRADDLES THE CUT. 1000 x 562, a true 16:9, with 200px of it in the
 * dark band and 362px in the light pane. Bridging the cut is what ties the two
 * grounds together, and a hero that sits entirely inside either one loses the
 * effect. The straddle is expressed as a proportion of the hero's own width
 * (20%), so it holds at every viewport instead of only at 1440.
 *
 * ONE H1, the article headline. Heading hierarchy is h1 here, h2/h3 inside the
 * rendered Markdown body, and h2/h3 in the related rail, so no post emits two
 * h1s or skips a level.
 */
import Base from './Base.astro';
import PageHero from '../components/evidenced/PageHero.astro';
import Band from '../components/evidenced/Band.astro';
import Close from '../components/evidenced/Close.astro';
import '../styles/evidenced.css';
import ShareRow from '../components/blog/ShareRow.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import PostImage from '../components/blog/PostImage.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { blogPosting, breadcrumbs, faqPage } from '../lib/schema';
import type { FaqEntry } from '../lib/schema';
import { routeUrl } from '../lib/route-url';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  readingTime?: number;
  /*
   * A named human byline, where the post carries one. Optional because ten of
   * the eleven posts do not, and the meta row simply omits the segment rather
   * than printing an empty separator.
   */
  author?: string;
  /** The author's role, printed after their name and carried as `jobTitle`. */
  authorRole?: string;
  /** Person for a human byline, Organization for a standing team. */
  authorType?: 'Person' | 'Organization';
  /*
   * Question/answer pairs from the post's frontmatter. Optional because only
   * 5 of the 8 posts carry them; faqPage() returns an empty array for the
   * rest rather than an FAQPage with zero questions, which is a structured
   * data error rather than a neutral omission.
   */
  faq?: FaqEntry[];
  /*
   * The `<title>`, where it cannot be the headline. Defaults to `title`, so a
   * post that fits inside 60 characters with the " | CrowAgent" suffix carries
   * one string and not two. See the note on `seoTitle` in content.config.ts for
   * why a headline and a search-result line are different objects.
   */
  seoTitle?: string;
  /*
   * "In short", the summary first block (D305 lane E3, 2026-10-23). Three to
   * five plain sentences from the post's frontmatter, shown above the body.
   * The body is never hidden: guides are for reading and for search.
   */
  keyPoints?: string[];
  /* The rendered Markdown's headings, for the "Jump to a section" contents. */
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  path,
  image,
  publishedAt,
  updatedAt,
  category,
  readingTime,
  author,
  authorRole,
  authorType,
  faq,
  seoTitle,
  keyPoints,
  headings = [],
} = Astro.props;

/* The contents list is the post's own h2 sections, read from the rendered
   Markdown, so it cannot drift from the body.
   R285-WEB-GEMINI-UIUX P2-8: it was shown only beside key points, so a nine
   section post with none had no contents at all. Now any post of four or more
   sections carries it, and a post with key points keeps it from three. */
/* The list is an <ol>, so it numbers itself. A post whose headings carry their
   own number ("1. Which edition applies") read "1. 1. Which edition" in the
   contents, so the heading number is dropped from the entry, not the body. */
const sections = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ ...h, text: h.text.replace(/^\d+\.\s+/, '') }));
const showToc = sections.length >= 4 || (!!keyPoints && keyPoints.length > 0 && sections.length > 2);

/*
 * THE SLUG AND THE SOCIAL CARD, worked out before anything uses them.
 *
 * `path` is the route ("/blog/some-post"), so the slug is its last segment.
 * Every post's social card is its own type led cover (D283), drawn by
 * scripts/generate-og-images.js from components/blog/covers.json into
 * /Assets/og/blog-<slug>.png. That generator renders a card only when a built
 * page references it, so this reference is what asks for the card. A post may
 * still pass its own `image`.
 */
const slug = path.replace(/^\/blog\//, '').replace(/\/$/, '');
const cardImage = image ?? `/Assets/og/blog-${slug}.png`;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/*
 * Structured data is DERIVED here, not passed in by each route.
 *
 * This layout is the thing that knows a page is an article, so it is the thing
 * that should say so in JSON-LD. Every /blog entry gets BlogPosting and a
 * breadcrumb trail with no per-post work and nothing for an author to remember.
 *
 * A parity run against the legacy site caught all 8 ported posts emitting only
 * an Organization node where legacy emitted BlogPosting. That is live SEO
 * surface which would have been destroyed silently at cutover. Fixing it in the
 * layout rather than in 8 files is the difference between closing the gap and
 * closing it in a way that cannot reopen.
 */
/*
 * THE ANCESTORS, DECLARED ONCE AND USED TWICE.
 *
 * This array feeds both the BreadcrumbList below and the <Breadcrumb> a reader
 * sees. Before 2026-08-04 there were two lists: this one said "Home > Blog >
 * <title>" and the markup below said "Blog / <category>", so eight routes showed
 * a reader a trail that started one level in from the one they published. Nobody
 * changed anything; there was simply no reason for two hand-maintained lists to
 * agree. scripts/check-breadcrumbs.js now fails the build if they ever do not.
 */
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const schema = [
  blogPosting({
    title,
    description,
    path,
    publishDate: publishedAt,
    updatedDate: updatedAt,
    image: cardImage,
    author,
    authorRole,
    authorType,
  }),
  breadcrumbs([
    ...trail,
    { name: title, path },
  ]),
  /*
   * FAQPage. Five legacy posts published one and the port dropped all five,
   * which a structured-data parity run caught (OA-24). The helper and the
   * frontmatter field both already existed; nothing ever connected them, so
   * the site kept passing every check while losing five rich results.
   */
  ...faqPage(faq),
];

/*
 * The share row and the related-articles rail are OWNED BY THIS LAYOUT, not by
 * the eight markdown files. Both existed on every legacy post and both were
 * lost by the port (OA-28); putting them here is what stops the next post from
 * shipping without them, and it is the same reasoning as the JSON-LD above.
 *
 * `path` is the route ("/blog/some-post"), so the slug is its last segment and
 * the canonical URL is the origin plus the path. Neither is passed in
 * separately: two sources for one identity is how a share link ends up
 * pointing at the wrong post.
 */
/* routeUrl rather than origin-plus-path: the concatenated form drops the
   trailing slash, which on a directory-format build is the 308 source, so every
   share link this page hands a reader pointed at a redirect. lib/route-url.ts
   carries the measurement. */
const canonicalUrl = routeUrl(path);
---

<Base
  title={`${seoTitle ?? title} | Velstrian`}
  description={description}
  path={path}
  image={cardImage}
  imageAlt={image ? undefined : title}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  schema={schema}
  typeface="evidenced"
  headerTone="light"
>
  <article class="art">
    {/*
      2026-10-22, ON DESIGN SYSTEM VERSION 3 (R285-WEB-ENTERPRISE-REDESIGN-01).
      The post opens on the compact PageHero, the reading pane is a light band,
      and the related posts and the Close follow. Every word, the byline, the
      picture, both share rows and the related posts are kept.

      THE PILL AND THE TRAIL. "All guides" goes back to /blog/, and the trail is
      the one Breadcrumb component fed the same ancestors as the JSON-LD. Its
      leaf is the CATEGORY, not the headline: the published leaf must name the
      page, this one is set in the mono micro-label where a long headline is a
      shout. check-breadcrumbs.js compares the links. The wrapper is a div this
      file owns, because Astro's scoping never reaches a child component's root,
      and below 720px the trail hides (the pill already goes back). The chevron
      is drawn, because JetBrains Mono has no arrow glyph.
    */}
    <PageHero id="art-title" size="compact" label={category} title={title}>
      <div slot="before" class="art__nav ea-trail">
        <a class="control chip art__pill" href="/blog/">
          <svg
            class="art__chev"
            viewBox="0 0 6 10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 1 1 5l4 4" />
          </svg>
          All guides
        </a>
        <div class="art__crumb">
          <Breadcrumb trail={trail} current={category} />
        </div>
      </div>
      <p slot="after" class="meta art__meta">
        <time datetime={publishedAt.toISOString()}>{dateFormatter.format(publishedAt)}</time>
        {author && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>By {author}{authorRole ? `, ${authorRole}` : ''}</span>
          </>
        )}
        {readingTime && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>{readingTime} min read</span>
          </>
        )}
        {updatedAt && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>Updated {dateFormatter.format(updatedAt)}</span>
          </>
        )}
      </p>
    </PageHero>

    <Band tone="light" class="art__pane">
      <div class="art__hero">
        {/* The post's photograph, or its designed cover when none is
            registered (D305 hybrid). No credit prop: the Pexels Licence needs
            none and the owner asked for none, provenance stays in
            blog/PHOTO-CREDITS.md. The social card is the type led cover either
            way (D305 decision D5). */}
        <PostImage
          slug={slug}
          title={title}
          category={category}
          wide
          priority
          sizes="(min-width: 1100px) 1104px, calc(100vw - 2.5rem)"
        />
      </div>
      <div class="art__col">
        {/* SUMMARY FIRST (D305 lane E3, 2026-10-23). A first time reader from
            a small firm meets the answer in a few lines before the long read,
            and a contents list lets them jump to the one section they need.
            The article body below is unchanged and fully open. The contents
            sit behind the site's one disclosure recipe, a native <details>. */}
        {keyPoints && keyPoints.length > 0 && (
          <aside class="art__short" aria-labelledby="art-short-title">
            <h2 class="ea-h3 art__short-h" id="art-short-title">In short</h2>
            <ul class="art__short-list">
              {keyPoints.map((k) => (
                <li>{k}</li>
              ))}
            </ul>
          </aside>
        )}
        {/* R285-WEB-GEMINI-UIUX P2-8. TWO FORMS OF ONE LIST, ONE SHOWN AT A TIME.
            In the reading column it is the site's one disclosure recipe, a
            native <details>, closed, so it costs a phone one line. On a wide
            screen the gutter beside the 36.8em measure is wide enough to hold
            it, so it stands open there and stays in view while the reader
            scrolls. A <details> cannot be held open by CSS, so the wide form is
            its own <nav>. Each is display:none outside its width, which keeps
            exactly one of them in the accessibility tree. */}
        {showToc && (
          <details class="art__toc art__toc--inline">
            <summary>
              <span>Jump to a section</span>
            </summary>
            <nav aria-label="Sections of this guide">
              <ol class="art__toc-list">
                {sections.map((h) => (
                  <li>
                    <a class="ea-link" href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )}
        {showToc && (
          <nav class="art__toc art__toc--side" aria-labelledby="art-toc-side-h">
            <p class="art__toc-h" id="art-toc-side-h">On this page</p>
            <ol class="art__toc-list">
              {sections.map((h) => (
                <li>
                  <a class="ea-link" href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <ShareRow title={title} url={canonicalUrl} position="top" />
        <div class="article-body ea-longform">
          <slot />
        </div>
        <ShareRow title={title} url={canonicalUrl} position="end" />
      </div>
    </Band>
  </article>
  <RelatedPosts slug={slug} />
  <Close />
</Base>

<style>
  /* ── IN SHORT (D305 lane E3) ────────────────────────────────────────────
     A calm box on the reading column: the one card's edge and ground, no
     hover, because it is not a control. Tokens only (RULE 0-C). */
  .art__short {
    display: grid;
    gap: var(--space-3);
    margin-block-end: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--ea-rule);
    border-inline-start: 3px solid var(--ea-accent);
    border-radius: var(--v3-radius-card);
    background: var(--ea-raised);
  }

  .art__short-h {
    margin: 0;
    color: var(--ea-ink);
  }

  .art__short-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-inline-start: 1.25em;
    list-style: disc;
    color: var(--ea-sub);
  }

  .art__toc {
    border-top: 1px solid var(--ea-rule);
  }

  /* On its own, with no In short box around it, the inline list keeps the same
     gap below it as that box. */
  .art__toc--inline {
    margin-block-end: var(--space-8);
    border-bottom: 1px solid var(--ea-rule);
  }

  .art__toc--side {
    display: none;
  }

  .art__toc-h {
    margin: 0 0 var(--space-3);
    font-size: var(--t-ea-small);
    font-weight: var(--t-w-ea-strong);
    color: var(--ea-ink);
  }

  /* Wide enough that the gutter holds a 15rem list beside the reading column
     with room either side. The column keeps its own width (the max-width
     above less its padding, which stays on the grid): it becomes the middle
     track of three, the outer two share what is left, and the list sits
     in the first, stuck under the header while the article scrolls past. */
  @media (min-width: 80rem) {
    .art__col:has(.art__toc--side) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) min(100%, calc(var(--measure) * 0.47)) minmax(0, 1fr);
      max-width: none;
    }

    .art__col:has(.art__toc--side) > * {
      grid-column: 2;
    }

    .art__col:has(.art__toc--side) > .art__toc--side {
      display: block;
      grid-column: 1;
      grid-row: 1 / span 8;
      align-self: start;
      justify-self: end;
      position: sticky;
      top: calc(var(--v3-header-h) + var(--space-6));
      inline-size: min(15rem, 100% - var(--space-8));
      max-block-size: calc(100vh - var(--v3-header-h) - var(--space-12));
      overflow-y: auto;
      margin-inline-end: var(--space-8);
      padding-block-start: var(--space-3);
      font-size: var(--t-ea-small);
    }

    .art__toc--side .art__toc-list {
      padding-block-end: 0;
    }

    .art__toc--inline {
      display: none;
    }
  }

  .art__toc summary {
    font-size: var(--t-ea-small);
    font-weight: var(--t-w-ea-medium);
    color: var(--ea-ink);
  }

  .art__toc summary:focus-visible {
    outline: var(--ea-focus);
    outline-offset: 2px;
  }

  .art__toc-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0 0 var(--space-3) 1.5em;
    list-style: decimal;
  }

  .art {
    --art-hero-w: min(100% - 2 * var(--gutter), calc(var(--measure) * 25 / 29));
  }

  .art__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--stack-1);
    margin-bottom: var(--sec-gap);
  }

  /* The wash, the hairline and the hover are `.control` in styles/controls.css
     (A-52). The 36px target comes from `:where(a, button, …).chip` in
     styles/labels.css and is untouched by that move, which is the point: the
     shared response owns no geometry, so consolidating a hover cannot shrink a
     control. */
  .art__pill {
    justify-self: start;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    box-shadow: var(--gloss-inset);
    text-decoration: none;
  }

  /*
   * WCAG 2.2 target size without changing the drawn capsule. The frame's pill
   * is 158 x 38; growing it to 44 would break the composition, so the HIT AREA
   * is extended past the visible box instead. The pseudo-element is the target,
   * the capsule is the picture of it.
   */
  .art__pill::after {
    content: '';
    position: absolute;
    top: 50%;
    inset-inline: 0;
    height: 44px;
    transform: translateY(-50%);
  }

  .art__chev {
    width: 6px;
    height: 10px;
    flex: none;
  }

  /*
   * THE BREADCRUMB'S OWN RULES ARE GONE FROM HERE, 2026-08-04. Nine declarations
   * (the flex row, the generated "/" separator, the link colour, the hover and
   * the focus ring) were a hand-copy of what layouts/Compare.astro and
   * pages/compare/index.astro each also held, and the copy that landed here was
   * missing the one rule the other two had argued for in writing: the WCAG 2.2
   * SC 2.5.8 target floor. That is how this layout shipped a 33.8 x 15 crumb link
   * at 1440 on eight routes while /compare shipped a 24px one, from the same
   * idea, on four.
   *
   * They now live once, in components/ui/Breadcrumb.astro. `.art__crumb` survives
   * as a POSITIONING hook only (where the block sits in this layout's hero grid),
   * which is the one thing about a breadcrumb that genuinely is this file's
   * business. Anything about how it LOOKS belongs to the component.
   */
  .art__crumb {
    /* Grid placement only; see the note above. A grid item defaults to
       min-width:auto and refuses to shrink below its widest content, which a
       wrapping trail of crumbs would otherwise force this column to honour. */
    min-width: 0;
  }

  /*
   * THE HEAD BLOCK IS NO LONGER THIS LAYOUT'S BUSINESS.
   *
   * Four rules used to live here: the centring of the eyebrow, headline and
   * byline; the gradient capsule for `.art__eyebrow`; its @supports guard; and
   * a bare `h1` rule at --t-h1 with a 20ch measure. All four were a hand-copy
   * of components/layout/Section.astro, and the copy is why every blog post
   * rendered a FLAT WHITE headline: the shiny treatment lived inside Section's
   * SCOPED styles, so it could only ever reach the routes Section drew.
   *
   * The whole block now comes from styles/headings.css by way of PageHeader,
   * which emits `.section__head > h1.section__title` exactly as Section does.
   * The centring comes with it, so the `text-align` rule went too; the prose
   * column below is untouched and keeps its own left edge, which was the point
   * of scoping that rule element by element rather than putting it on a shared
   * ancestor.
   *
   * The old headline ran at 20ch against Section's 16ch, and at a slightly
   * tighter tracking. Those differences were the defect, not a decision.
   */

  .art__meta {
    /* The gap the deleted `h1` rule used to hold as its own bottom margin.
       h1.section__title is `margin: 0` in headings.css, because a shared head
       block cannot know what follows it, so the space belongs to whatever
       this layout puts in the slot, which is this byline. */
    margin: var(--stack-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    /* The byline sits in the head block, where a standfirst would, so it
       centres with it. text-align cannot do this on a flex container. */
    justify-content: center;
    align-items: center;
    color: var(--c-text-muted);
  }

  /* In the centred hero head the trail row spans the measure, so the pill
     sits at the start and the trail centres on the page. */
  .art__nav {
    justify-self: stretch;
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
  }

  /* The post's picture at the head of the reading band, at the frame width
     it has always had. It no longer rises into a dark band above it: the
     whole page is light now, so there is nothing for it to straddle. */
  .art__hero {
    position: relative;
    z-index: 1;
    width: var(--art-hero-w);
    margin-inline: auto;
    margin-bottom: var(--sec-gap);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  /*
   * THE READING MEASURE. 0.47, giving a 601.6px CONTENT column.
   *
   * CORRECTED 2026-08-05, O-25. This read 0.59 under a comment claiming it
   * produced "684px, Vercel's long-form measure ... roughly 68 characters a
   * line". BOTH HALVES OF THAT WERE FALSE, and the second is the trap:
   *
   *   1. 0.59 has not produced 684px since --measure was consolidated to
   *      1280px. 1280 x 0.59 = 755.2px. The 0.59 was derived against an
   *      earlier --measure of about 1159px and was never re-derived when the
   *      token moved, so the stated figure and the shipped figure had drifted
   *      71px apart.
   *
   *   2. "68 characters" was never measured, it was inferred from `ch`. `1ch`
   *      is the advance of "0", which in Inter is 0.611em -- far wider than
   *      the average lowercase letter. A 68ch box therefore holds about 86
   *      real characters, not 68. Every `ch`-stated measure on this site is
   *      about 27% wider than its comment claims.
   *
   * SO THE FIGURES BELOW ARE COUNTED, not converted. Rendered lines on
   * /blog/ppn-002-social-value-guide were split by client rect and the
   * characters on each full line counted, discarding the ragged last line:
   *
   *            content   median chars/line      longest line
   *   0.59     755.2px   95.0 @834  88.8 @1440   106 / 100   <- was shipping
   *   0.47     601.6px   74.7 @834  70.0 @1440    82 /  79   <- now
   *
   * The comfortable band is 45-75 characters. 0.59 sat 19-27% above the top
   * of it on every post at every width from 834 up; 0.47 sits inside it at
   * both. Re-measure by counting characters, never by dividing pixels by
   * `ch`, or this drifts back.
   *
   * Still derived from --measure rather than written as a pixel value, the
   * same way tokens.css derives --measure-mid, --measure-band and
   * --measure-prose, so it moves with the page grid. The gutter is added on
   * top because on this site "the measure" is the outer box, so the content
   * width is what the figures above describe.
   */
  .art__col {
    max-width: calc(var(--measure) * 0.47 + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ── Prose ────────────────────────────────────────────────────────────── */

  /*
   * TAG MATCHES TIER. These ran one step below their own level (h2 at --t-h3,
   * h3 at --t-h4), which is why the site had two different h2 sizes and, on
   * pages carrying both prose and a section heading, two on one page. An
   * article h2 is a section of the document and takes the section size.
   */
  .article-body :global(h2) {
