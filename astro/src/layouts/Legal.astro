---
/**
 * Legal: the layout for /privacy, /terms, /cookies and /security.
 *
 * These four pages are a single shape: a long, sectioned document that people
 * arrive at with one question and leave as soon as they have answered it.
 * Almost nobody reads one start to finish, so the design job is not
 * readability in the usual sense, it is FINDABILITY. Hence the contents rail:
 * every h2 in the document, generated from the headings Astro already parsed,
 * so it cannot drift out of step with the document the way a hand-maintained
 * list always eventually does.
 *
 * The body content is NOT authored here. It comes from the `legal` content
 * collection, converted from the legacy HTML by scripts/convert-legal.js, which
 * refuses to emit a file whose visible text is not token-identical to the
 * source. See the note on that collection in content.config.ts.
 *
 * THE LEGACY CONTENTS MARKUP IS GONE FROM THAT CONTENT, 2026-08-04, A-64, AND
 * THE RAIL BELOW IS WHY. Each of the three long legal documents carried a
 * legacy page-map that the conversion had half-emptied: `.pv-toc-card`,
 * `.tm-toc-card` and `.sec-toc-card` each still held their heading ("On this
 * page", "On this page", "Documentation"), and the <nav> of links UNDER that
 * heading had not come across. /privacy said "On this page" twice inside 165px
 * with nothing beneath either one. None of the three classes was defined in any
 * shipped stylesheet, so they drew as 26px body paragraphs pointing at nothing.
 *
 * /privacy also carried a `.pv-toc-mobile` <details> that DID still hold its 16
 * links, and deleting a phone's only way around an 11,000px legal document
 * would have been worse than leaving the orphans. So it was measured before
 * anything was deleted, at 390 on the built site:
 *
 *   .legal__toc at 1440   sticky, 240px, 18 entries, beside the document
 *   .legal__toc at 834    static, 751px, 18 entries, at y=412 above the document
 *   .legal__toc at 390    static, 350px, 18 entries, at y=365 above the document
 *
 * The @media block at the foot of this file is what does that: below 899px the
 * rail stops being a sidebar and becomes a wrapped jump list at the top of the
 * page. It is not hidden on a phone, it is the FIRST thing under the title,
 * whereas the legacy mobile TOC sat 2,057px down /privacy and listed 16 of the
 * 18 sections. The rail is earlier, longer and generated from the headings, so
 * the mobile disclosure was redundant rather than load-bearing, and porting
 * styles for it would have shipped a second contents list two screens below the
 * first. Removed, not restyled.
 *
 * WHY THE DATE IS PROMINENT. On a policy document the "last updated" stamp is
 * not metadata, it is the first thing a reader needs in order to trust anything
 * below it. It sits with the heading rather than in a footer.
 */
import Base from './Base.astro';
import PageHero from '../components/evidenced/PageHero.astro';
import Band from '../components/evidenced/Band.astro';
import '../styles/evidenced.css';
import { breadcrumbs } from '../lib/schema';
import '../styles/prose.css';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  eyebrow?: string;
  lastUpdated?: string;
  version?: string;
  effectiveDate?: string;
  draftNotice?: string;
  headings: MarkdownHeading[];
}

const { title, description, path, heading, eyebrow, lastUpdated, version, effectiveDate, draftNotice, headings } = Astro.props;

/** h2 only. h3 in these documents are sub-clauses and would swamp the rail. */
const toc = headings.filter((h) => h.depth === 2);

/*
 * BreadcrumbList. Every legacy legal page published one and all four were
 * lost in the port (OA-24), /cookies, /privacy, /security and /terms. It is
 * what puts the trail under the result in search rather than a bare URL.
 * Emitted from the layout, once, so a fifth legal page cannot ship without it.
 */
const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: heading.replace(/\.$/, ''), path },
  ]),
];

/**
 * Format for display without inventing precision. The source gives either an
 * ISO date or nothing at all; two of the four documents genuinely carry no
 * date, and inventing one for visual consistency would be a lie about when a
 * legal document last changed.
 */
const formatted = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;
const isValidDate = formatted && formatted !== 'Invalid Date';

/* D448: the version and effective date a person agrees to, shown exactly as the
   platform records them. Same rule as above, nothing is invented: a page whose
   front matter carries no version shows no version line. */
const effectiveFormatted = effectiveDate
  ? new Date(effectiveDate).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;
const isValidEffective = effectiveFormatted && effectiveFormatted !== 'Invalid Date';
---

<Base title={title} description={description} path={path} schema={schema} typeface="evidenced" headerTone="light">
  {/*
    2026-10-22, ON DESIGN SYSTEM VERSION 3 (R285-WEB-ENTERPRISE-REDESIGN-01).
    A compact PageHero, then the contents and the document on one light band.
    Every word is the Markdown's, unchanged.

    THE "LAST UPDATED" STAMP STAYS DIRECTLY UNDER THE TITLE. On a policy
    document the date is not metadata, it is the first thing a reader needs in
    order to trust anything below it. It would have been the easiest thing in
    this conversion to drop.

    No closing sales band: a privacy policy or a set of terms ends on the
    document, not on a pitch.
  */}
  <PageHero id="legal-title" size="compact" label={eyebrow ?? 'Legal'} title={heading}>
    {
      isValidDate && (
        <p slot="after" class="ea-label legal__stamp">
          Last updated <time datetime={lastUpdated}>{formatted}</time>
        </p>
      )
    }
    {
      version && isValidEffective && (
        <p slot="after" class="ea-label legal__stamp" data-legal-version={version}>
          Version {version}, in force from <time datetime={effectiveDate}>{effectiveFormatted}</time>
        </p>
      )
    }
  </PageHero>

  {/* D290: /security/ opens with the "Security built in" summary before the
      document. Other legal pages pass nothing and render as before. */}
  <slot name="before" />

  <Band tone="light" class="legal">
    {/* D442: a document still in draft says so before anything else, in
        plain words, so nobody mistakes it for final wording. The sentence
        comes from the page's front matter, the layout adds only the label. */}
    {
      draftNotice && (
        <div class="ea-wrap">
          <aside class="legal__draft" role="note" aria-labelledby="legal-draft-label" data-legal-draft>
            <p class="ea-label legal__draft-label" id="legal-draft-label">Draft</p>
            <p class="legal__draft-text">{draftNotice}</p>
          </aside>
        </div>
      )
    }
    <div class="ea-wrap legal__grid">
      {
        toc.length > 0 && (
          <nav class="legal__toc" aria-label="Contents">
            <p class="ea-label legal__toc-label" id="legal-toc-label">
              Contents
            </p>
            <ol aria-labelledby="legal-toc-label">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <article class="prose legal__body">
        <slot />
      </article>
    </div>
  </Band>
</Base>

<style>
  /* The draft notice. --c-at-risk is the central token for the middle state,
     neither verified nor refused, and on a light band it resolves to the
     ochre ink that reads at AA. No new brand value is introduced. */
  .legal__draft {
    margin: 0 0 var(--stack-2);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--c-at-risk);
    border-left-width: 4px;
    border-radius: var(--v3-radius-card);
    background: var(--ea-raised);
  }

  .legal__draft-label {
    margin: 0 0 var(--space-2);
    color: var(--c-at-risk);
  }

  .legal__draft-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.5;
    color: var(--c-text);
  }

  .legal__grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
  }

  /* A grid item defaults to min-width:auto, so it refuses to shrink below its
     widest content. A wide table therefore pushed the whole page sideways even
     though .prose-scroll was ready to scroll it. min-width:0 is what lets the
     scroll container actually do its job. */
  .legal__body { min-width: 0; }

  /* The rail follows the reader down a long document. `align-self: start` is
     required for position: sticky to have anywhere to travel inside a grid
     item, which stretches to the row height by default. */
  .legal__toc {
    position: sticky;
    top: calc(var(--v3-header-h) + var(--space-8));
    align-self: start;
    max-height: calc(100vh - 128px);
    overflow-y: auto;
  }

  .legal__toc-label {
    margin: 0 0 var(--stack-1);
    color: var(--c-text-muted);
  }

  .legal__toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    /* Numbered would imply the clauses must be read in order. They must not. */
  }

  .legal__toc a {
    display: block;
    /* 44px min target height, WCAG 2.2 2.5.8, met by padding rather than by a
       fixed height so a two-line entry still grows. */
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 6px 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.4;
    color: var(--c-text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: 12px;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .legal__toc a:hover {
    color: var(--c-text);
    border-left-color: var(--c-interactive);
  }

  .legal__toc a:focus-visible {
    outline: 3px solid var(--c-interactive);
    outline-offset: 2px;
    color: var(--c-text);
  }

  /* Below this the rail costs more than it earns: a sticky sidebar on a phone
     is just a block of links between the reader and the document. It becomes a
     normal jump list at the top instead. */
  @media (max-width: 899px) {
    /* minmax(0, 1fr), never a bare 1fr: `1fr` means minmax(auto, 1fr), which
       reintroduces the min-content floor and the sideways scroll it causes. */
    .legal__grid { grid-template-columns: minmax(0, 1fr); gap: var(--sec-gap); }
    .legal__toc {
      position: static;
      max-height: none;
      padding-bottom: var(--stack-2);
      border-bottom: 1px solid var(--c-border);
    }
    .legal__toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--stack-2);
    }
    .legal__toc a { border-left: 0; padding-left: 0; }
  }
</style>
