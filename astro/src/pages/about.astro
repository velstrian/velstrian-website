---
/**
 * /about/: who Velstrian is and why it exists.
 *
 * ── 2026-10-22: REBUILT ON DESIGN SYSTEM VERSION 3 ──────────────────────────
 *
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy section 0.7. Rebuilt from
 * docs/design/R285-GEMINI-BRIEF-PAGES.md. Written for a small firm deciding
 * whether to trust us (RULE 0-U). Composed from components/evidenced/ and
 * components/about/.
 *
 * STORYLINE:
 *   1. AboutHero        light      who is this, is it for me?   hero light, chips, stage, recreation
 *   2. AboutRoles       light alt  what does it do for my role? four reader perspectives, plain words first, the rule as a linked note
 *   3. AboutStory       dark       who is behind it?            the company and facts a reader can check (D279), a real product screen, principles
 *   4. AboutHistory     light      where are you based?         milestones timeline, company card linked to Companies House
 *   5. AboutVariants    light alt  how does it serve both sides? supplier (Bid) and buyer (Buy) variants
 *   6. AboutTrust       dark       is my data secure?           hairline facts, trust strip, 6 security cards
 *   7. AboutNewsletter  light      staying informed             monthly UK procurement digest
 *   8. Close            gradient   what now?                    gradient close band into dark footer
 *
 * ── SEO IS CARRIED OVER VERBATIM ───────────────────────────────────────────
 * Title, description, canonical and schema graph are preserved.
 */
import Base from '../layouts/Base.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutRoles from '../components/about/AboutRoles.astro';
import AboutStory from '../components/about/AboutStory.astro';
import AboutHistory from '../components/about/AboutHistory.astro';
import AboutVariants from '../components/about/AboutVariants.astro';
import AboutTrust from '../components/about/AboutTrust.astro';
import AboutNewsletter from '../components/about/AboutNewsletter.astro';
import Close from '../components/evidenced/Close.astro';
import '../styles/evidenced.css';
import { breadcrumbs } from '../lib/schema';

const title = 'About Velstrian: Bid Software for Small Firms';
const description =
  'Written for bid writers and evaluators. Velstrian Systems Ltd details, history, what we stand for and the UK procurement statutes we build against.';

const FREE_TOOL = '/tools/tender-compliance-matrix/';

const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ]),
];

const UPDATED = new Date('2026-10-22');
---

<Base
  title={title}
  description={description}
  path="/about"
  schema={schema}
  updatedAt={UPDATED}
  typeface="evidenced"
  headerTone="light"
>
  <AboutHero />
  <AboutRoles />
  <AboutStory />
  <AboutHistory />
  <AboutVariants />
  <AboutTrust />
  <AboutNewsletter />
  <Close
    title="Whichever of the four you are."
    lead="Book a 30-minute call, or run the free compliance matrix now. No card, no signup."
    primary={{ href: FREE_TOOL, label: 'Try the compliance matrix (free)' }}
  />
</Base>
