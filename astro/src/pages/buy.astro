---
/**
 * /buy/: the Velstrian Buy product page.
 *
 * ── 2026-10-22: REBUILT ON DESIGN SYSTEM VERSION 3, VERSION 2 STORYLINE ────
 *
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy section 0.7 step (2). Rebuilt from
 * docs/design/R285-GEMINI-BRIEF-BUY-PAGE.md. Written for a busy buyer who has to
 * buy a service and compare the replies fairly, and who is not a procurement
 * specialist (RULE 0-U). Composed from components/evidenced/ and components/buy/.
 *
 * STORYLINE:
 *   1. BuyHero        light      what is this, is it for me?   stage, sequence
 *   2. BuyWhatItDoes  light alt  what does it do for me?       five capabilities, five stages
 *   3. BuyBoundary    dark       can I trust it?               the one slow moment (AI reads, people score)
 *   4. Steps          dark       how hard is it to start?      three steps, as play once flash cards (D305 lane E1)
 *   5. BuyTrust       light      is my data safe, what cost?   hairline facts, trust strip, buyer plans
 *   6. BuyDetail      light alt  expert detail                 procurement rules, 5 RAG bands, portal scope, surfaces
 *   7. BuyFaq         light      words I do not know           newcomer terms first
 *   8. Close          gradient   what now?                     gradient band into footer
 *
 * ── SEO IS CARRIED OVER VERBATIM ───────────────────────────────────────────
 *
 * Title, description, canonical and schema graph are preserved.
 * The FAQPage node is built from the questions this page shows (components/buy/faqs.ts).
 */
import Base from '../layouts/Base.astro';
import BuyHero from '../components/buy/BuyHero.astro';
import BuyWhatItDoes from '../components/buy/BuyWhatItDoes.astro';
import BuyBoundary from '../components/buy/BuyBoundary.astro';
import Steps from '../components/evidenced/Steps.astro';
import BuyTrust from '../components/buy/BuyTrust.astro';
import BuyDetail from '../components/buy/BuyDetail.astro';
import BuyFaq from '../components/buy/BuyFaq.astro';
import Close from '../components/evidenced/Close.astro';
import { BUY_FAQS } from '../components/buy/faqs';
import '../styles/evidenced.css';
import { faqPage, breadcrumbs } from '../lib/schema';
import { SITE } from '../data/site';
import { PRODUCT_NAME_BUY, PLATFORM_SHORT_NAME } from '../lib/brand-names';
import { BUYER_PLANS, startHref, START_LABEL, TRIAL_NOTE } from '../data/pricing';

const [BUYER_PRO] = BUYER_PLANS;
const buyerStart = { href: startHref(BUYER_PRO.planKey), label: START_LABEL };

/* A buyer's start, in plain words. Each step restates the old /buy/ page:
   the requirement and rubric settled before bids arrive, suppliers invited by
   personal link or a Quick RFQ, and quotes located in each reply while the
   panel sets every mark. */
const BUYER_STEPS = [
  { icon: 'checklist' as const, title: 'Say what you need',
    body: 'Write down what you need and how you will judge the replies, before any supplier responds.' },
  { icon: 'upload' as const, title: 'Invite suppliers',
    body: 'Send each supplier a personal link, or use a Quick RFQ for a smaller job. They upload their reply and get a receipt.' },
  { icon: 'done' as const, title: 'Compare and decide',
    body: 'Read what each supplier said against each question, with the quotes found for you. Your panel sets every mark.' },
];

const title = 'Velstrian Buy | Compare supplier quotes fairly | Velstrian';
const description =
  'For public and private buyers. Say what you need, collect every supplier reply in one place, see the proof in each, word for word, and track delivery after award. Your panel scores, not the AI.';

const schema = [
  {
    '@type': 'WebPage',
    name: title,
    description,
    url: `${SITE.origin}/buy`,
    publisher: { '@type': 'Organization', name: PLATFORM_SHORT_NAME, url: `${SITE.origin}/` },
  },
  ...faqPage(BUY_FAQS),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: PRODUCT_NAME_BUY, path: '/buy/' },
  ]),
];

const UPDATED = new Date('2026-10-22');
---

<Base
  title={title}
  description={description}
  path="/buy"
  schema={schema}
  updatedAt={UPDATED}
  typeface="evidenced"
  headerTone="light"
>
  <BuyHero />
  <BuyWhatItDoes />
  <BuyBoundary />
  <Steps steps={BUYER_STEPS} action={buyerStart} flash />
  <BuyTrust />
  <BuyDetail />
  <BuyFaq />
  <Close
    title="Your next purchase can start today."
    lead={`${TRIAL_NOTE} Or talk it through with us first.`}
    primary={buyerStart}
  />
</Base>
