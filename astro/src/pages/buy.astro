  /*
   * WCAG 2.2 SC 2.5.8, AND THE SCOPE IS THE POINT. A link that is a paragraph
   * on its own is a control and takes the 44px floor. Measured at 390 before
   * this rule, "Contact sales" and "All frequently asked questions" were 21px
   * tall.
   *
   * `:only-child` is what keeps this off the OTHER `.note` on the page, whose
   * link sits inside a running sentence ("Responding to tenders rather than
   * running them? ..."). 2.5.8 exempts an inline target, and giving that one a
   * 44px box would open a hole in the middle of a paragraph.
   */
  .card__cta a,
  .note a:only-child {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .proof {
