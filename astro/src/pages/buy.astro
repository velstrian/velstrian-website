{/*
  ── MOMENT 3: CLICK-TRIGGERED EVIDENCE DRAWER (D5, D250) ─────────────────────
  Same-document View Transition morphs the selected submission into its located
  verbatim text and evaluation rationale.
  Honours prefers-reduced-motion: reduce with an instant, animation-free swap.
  Native Web API, zero animation library dependency.
*/}
<script is:inline>
  (function () {
    var tabs = document.querySelectorAll('[data-bidder-tab]');
    var drawer = document.getElementById('evidence-drawer');
    if (!tabs.length || !drawer) return;

    var data = {
      '1': {
        crit: 'Criterion 3.2 · Local employment',
        chip: 'Advisory · Verbatim match',
        quote: 'Two apprenticeship starts in the first contract year, both recruited from the borough, with a named site supervisor accountable for completion.',
        cite: 'Located verbatim · response section 4.1, page 12',
        rationale: 'Specific commitment with an accountable named supervisor and a local recruitment target. Meets the local employment criterion.',
        score: 'Panel score: 4 / 5'
      },
      '2': {
        crit: 'Criterion 3.2 · Local employment',
        chip: 'Advisory · Verbatim match',
        quote: 'We intend to explore opportunities for local training and work experience placements subject to contract value and operational feasibility.',
        cite: 'Located verbatim · response section 2.3, page 7',
        rationale: 'An intention, with no committed headcount, milestone or named supervision.',
        score: 'Panel score: 2 / 5'
      },
      '3': {
        crit: 'Criterion 3.2 · Local employment',
        chip: 'Advisory · Verbatim match',
        quote: 'Four accredited apprenticeships with London Living Wage guarantee, enrolled through the Borough Skills Hub with quarterly completion reviews.',
        cite: 'Located verbatim · response section 5.2, page 18',
        rationale: 'A countable commitment with a named training provider, a wage guarantee and quarterly completion reviews.',
        score: 'Panel score: 5 / 5'
      }
    };

    function updateContent(id) {
      var item = data[id];
      if (!item) return;
      for (var i = 0; i < tabs.length; i++) {
        var active = tabs[i].getAttribute('data-bidder-tab') === id;
        tabs[i].setAttribute('aria-selected', active ? 'true' : 'false');
        tabs[i].classList.toggle('buy-tab--active', active);
      }
      var critEl = drawer.querySelector('.spec__crit');
      var chipEl = drawer.querySelector('.spec__chip');
      var quoteEl = drawer.querySelector('.spec__quote');
      var citeEl = drawer.querySelector('.spec__cite');
      var ratEl = drawer.querySelector('.spec__rationale');
      var scoreEl = drawer.querySelector('.spec__score');
      if (critEl) critEl.textContent = item.crit;
      if (chipEl) chipEl.textContent = item.chip;
      if (quoteEl) quoteEl.textContent = item.quote;
      if (citeEl) citeEl.textContent = item.cite;
      if (ratEl) ratEl.textContent = item.rationale;
      if (scoreEl) scoreEl.textContent = item.score;
    }

    for (var j = 0; j < tabs.length; j++) {
      tabs[j].addEventListener('click', function (e) {
        var id = this.getAttribute('data-bidder-tab');
        if (!id) return;
        if (!document.startViewTransition || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
          updateContent(id);
        } else {
          document.startViewTransition(function () {
            updateContent(id);
          });
        }
      });
    }
  })();
</script>

<style>
  /* ── THE GROUND LADDER MOVED TO styles/surfaces.css, 2026-08-05 ───────────
   *
   * It replaced five hand-placed sv-floor classes here, and the reasoning for
   * expressing the ground against POSITION rather than by hand was right: the
   * owner moved the buyer carousel up the page, which put two floor sections
   * side by side, exactly as the workspace section's own comment had predicted.
   *
   * BUT THIS COPY WAS DEAD, AND HAD BEEN SINCE THE MOMENT IT WAS WRITTEN. It
   * sat in this plain <style> rather than <style is:global>, so Astro scoped it
   * to `#main-content.astro-g7huwdal > section.astro-g7huwdal` while
   * layouts/Base.astro renders <main id="main-content"> with NO class. The
   * selector matched nothing. MEASURED on the built page, not inferred: all
   * ELEVEN sections on this route rendered transparent, no alternation at all,
   * while / and /bid/ alternated correctly from their own copies.
   *
   * That is why the rule is now declared ONCE, in a stylesheet Base.astro
   * imports, where it cannot be scoped out from under itself. See the full
   * argument at the foot of surfaces.css.
   */

  /* ════════════════════════════════════════════════════════════════════════
     GEOMETRY ONLY. Panels are `.sv-raised`, cards are `.surface`, figures are
     `.sv-numeral`, the floor step is `.sv-floor`, and every duration is
     --m-beat. No shadow, radius, card recipe or timing is authored here.

     THE BLOCKS BELOW ARE THE SAME VOCABULARY /bid/ USES, AND THAT IS A
     KNOWN DEBT RATHER THAN A DESIGN. The plane stack, the gate and the ambient
     rig belong in components/sections/ so both product pages render one
     implementation; this pass was scoped to the two page files and may not add
     to src/components/**. Reported rather than done, and the values are
     identical in both files so the extraction is a move rather than a merge.
     ════════════════════════════════════════════════════════════════════════ */

  /* ── The section wrapper and its ambient rig ─────────────────────────────
     `isolation: isolate` so the z-index -1 field cannot escape behind the page
     background, and `position: relative` so the rig has something to measure
     against. */
  .cw { position: relative; isolation: isolate; }

  /*
   * ── M-P5 · AMBIENT FIELD, SCROLL DRIVEN, NEVER SCROLL JACKING ────────────
   * TRIGGER  @supports (animation-timeline: view()) only, via the shared layer
   *          in styles/tokens.css. Nothing is pinned and the scroll rate is
   *          untouched.
   * REDUCED  the whole block is dropped, because tokens.css declares both the
   *          drift and the parallax inside prefers-reduced-motion:
   *          no-preference. The static bloom is already correct.
   *
   * The bleed is exactly one gutter, never one pixel more, because the sitewide
   * gate fails any page whose scrollWidth exceeds its clientWidth at 390, 768
   * or 1440. `closest-side` on the mask so the ramp reaches transparent exactly
   * at the middle of every edge; a percentage ellipse leaves about 25% of the
   * field alive there and draws a lighter rectangle across the section.
   */
  .amb {
    position: absolute;
    inset-block: -14%;
    inset-inline: calc(-1 * var(--gutter));
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(closest-side, rgb(0 0 0) 42%, transparent 100%);
    mask-image: radial-gradient(closest-side, rgb(0 0 0) 42%, transparent 100%);
  }

  .amb b {
    position: absolute;
    border-radius: 50%;
    filter: blur(150px);
    mix-blend-mode: screen;
  }

  .amb b:nth-child(1) {
    width: 560px;
    height: 440px;
    left: -8%;
    top: -22%;
    background: var(--orb-teal);
    opacity: 0.42;
  }

  .amb b:nth-child(2) {
    width: 540px;
    height: 440px;
    right: -8%;
    bottom: -24%;
    background: var(--orb-violet);
    opacity: 0.34;
  }

  .cw--hero .amb { --par: 48px; }

  @media (max-width: 560px) {
    .amb b { filter: blur(90px); width: 320px; height: 280px; }
  }

  /* ══ THE HERO PLANE STACK, `223:5` ═══════════════════════════════════════
   *
   * MOVED TO styles/duty-card.css, 2026-08-04. A-45.
   *
   * THIS FILE WAS THE SECOND COPY. The note that used to sit on `.duty__lbl
   * span` here said so in as many words. That CM-01 names `/bid/` only,
   * that this page hand-copied the whole recipe, that it measured identically
   * at all three widths, and that the duplication itself was the real defect but
   * could not be closed in that pass because styles/ was being edited
   * concurrently. That is the move, made. Both copies are gone, the recipe has
   * one home, and the markup went with it to components/sections/DutyCard.astro.
   *
   * scripts/check-shared-blocks.js now fails the build if a `.duty` rule
   * reappears in this file or any other outside the owning stylesheet, because a
   * careful hand-copy renders identically and that is exactly how this one
   * survived a rendered audit. */

  /* The kicker on this page's OTHER drawn artefact, the boundary gate. It used
     to share a rule with `.duty__kicker`; the duty half now lives with the card
     it belongs to. */
  .art__kicker {
    margin: 0 0 var(--stack-2);
    color: var(--c-text-muted);
  }

  /* ══ THE BOUNDARY GATE ═══════════════════════════════════════════════════ */

  .gate { margin: var(--sec-gap) 0 0; padding: var(--blk-pad); }

  /* THE GATE ITSELF. Without a drawn line, "track 4 stops at the gate" is a
     shorter bar and nothing else; with it, three tracks visibly cross and one
     visibly does not. Positioned off the verdict column's own width so the rule
     lands exactly where every track ends, at any type size. */
  .gate__rows {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gate__rows::after {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    right: calc(10ch + var(--stack-2));
    width: 1px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-text) 30%, transparent),
      color-mix(in srgb, var(--c-text) 8%, transparent)
    );
  }

  .gate__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 84px) minmax(0, 10ch);
    align-items: center;
    gap: 4px var(--stack-2);
    padding: var(--stack-1) 0;
    border-top: 1px solid var(--c-border);
  }

  .gate__row:first-child { border-top: 0; }

  .gate__name {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-text);
  }

  .gate__src {
    grid-column: 1;
    grid-row: 2;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-micro);
    color: var(--c-text-muted);
  }

  /* THE TRACK EXISTS TO CLIP. The bar scales from zero on its left edge, and an
     unclipped mid-animation frame can paint outside the panel and grow the
     document's scrollWidth. A horizontal-overflow failure that exists only
     while the animation runs and is invisible to a settled-page check. */
  .gate__track {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    height: 2px;
    overflow: hidden;
  }

  .gate__bar {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, transparent, var(--c-verified));
    transform-origin: left center;
  }

  /* Stops at the line: two thirds of the track, and the last third stays empty.
     The boundary is drawn as an absence, which is what a boundary is. */
  .gate__row--stop .gate__bar {
    right: 34%;
    background: linear-gradient(90deg, transparent, var(--c-refused));
  }

  .gate__end {
    grid-column: 3;
    grid-row: 1 / span 2;
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    color: var(--c-verified);
  }

  .gate__end--stop { color: var(--c-refused); }

  .gate__pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-verified);
    box-shadow: 0 0 6px var(--c-verified-glow);
  }

  .gate__x { flex: none; width: 12px; height: 12px; }

  /* Dashed entirely out of view at rest, so the visible cross is the path
     beneath it and this one only ever adds light. */
  .gate__x-draw { stroke-dasharray: 0 20; }

  /* Gate resting state per D5 (one motion moment per page: Moment 3 is the Evidence Drawer) */
  .gate__bar { transform: scaleX(1); }
  .gate__x-draw { stroke-dasharray: 20 20; }

  .kicker {
    margin: 0 0 var(--stack-1);
    color: var(--c-text-muted);
  }
  .kicker--tight { margin-top: var(--stack-2); }

  .lead {
    margin: 0 auto var(--stack-2);
    max-width: 72ch;
    font-family: var(--font-body);
    font-size: var(--t-lede);
    line-height: 1.75;
    color: var(--c-text-sub);
