  .quote {
    margin: var(--sec-gap) auto 0;
    max-width: 76ch;
  }
  .quote blockquote {
    color: var(--c-text-sub);
  }
  /* The label recipe is `.meta` in styles/labels.css. */
  .quote figcaption {
    margin-top: var(--stack-1);
    color: var(--c-text-muted);
