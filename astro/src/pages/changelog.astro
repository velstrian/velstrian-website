---
/**
 * /changelog
 *
 * THREE THINGS CORRECTED IN THE PORT, all small and all measurable.
 *
 * 1. `<time>` HAD NO `datetime`. The legacy elements carry the ISO string as a
 *    text node only, so the date is not machine-readable. The one thing a
 *    <time> element exists to provide. Now emitted properly, and the visible
 *    text is formatted for a human while the attribute stays ISO.
 *
 * 2. THE HERO ADVERTISED CONTENT THE PAGE DOES NOT HAVE. Its eyebrow read
 *    "Changelog · System Status · UK Built"; there is no system status anywhere
 *    on the page. Removed rather than left as a promise the page breaks
 *    immediately. Anything that changes what a reader is told is de-claiming
 *    here, never adding.
 *
 * 3. A FALSE AFFORDANCE. "Explore the CrowAgent roadmap →" was styled as a link
 *    and was a plain <span>. Arrow, link colouring, no href. It is a real link
 *    now, to the destination it always implied.
 *
 * A third changelog entry exists on the legacy page only as an HTML comment
 * recording its removal (2026-07-28). Deliberately not ported.
 *
 * THE FEED IS STALE, and that is a content problem I cannot fix from here: the
 * newest entry is 2026-05-05 while the site shipped a homepage rebuild on
 * 2026-08-01 and removed five tools on 2026-07-28. A changelog three months
 * behind, under a standfirst reading "Every shipped change, in one feed",
 * undercuts its own claim. Logged as OA-14. Writing release notes is the
 * owner's call, not mine.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/evidenced/PageHero.astro';
import Band from '../components/evidenced/Band.astro';
import Close from '../components/evidenced/Close.astro';
import { breadcrumbs } from '../lib/schema';
import { PRODUCT_NAME_BID } from '../lib/brand-names';
import '../styles/evidenced.css';

const title = 'Changelog | Velstrian';
const description = 'Public release notes for Velstrian Bid. Every shipped change, in one feed.';

const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Changelog', path: '/changelog/' },
  ]),
];

interface Entry {
  /** ISO. Drives both the datetime attribute and the displayed date. */
  date: string;
  tag: string;
  heading: string;
  items: string[];
}

const ENTRIES: Entry[] = [
  {
    date: '2026-09-03',
    tag: 'Velstrian Buy',
    heading: 'Managing the contract after award, and PPN 026 by default',
    items: [
      'Supplier relationship management: a supplier profile now carries the commitments made in the winning bid, alongside scorecards, regular review meetings, and risk indicators, so what was promised stays visible throughout contract delivery.',
      'Record concerns and corrective actions directly against the specific bid commitments they relate to.',
      'Value tracking workspace: record and prove the cost savings and social benefits your contract delivers.',
      'Due diligence workspace, buyer relationship feedback, and clear procurement stages on every contract.',
      'Choose your social value model per contract: PPN 026 is now the default on new work, while PPN 002 remains available until 31 December 2026 for procurements running under it. The Cabinet Office has not yet published the PPN 026 sub-criteria, so Velstrian Bid does not score against them.',
      'Updated and refreshed design across account sign in, registration, password reset, and two-factor authentication pages.',
      'Automatic session expiry: active sessions time out after 7 days, with a 24-hour inactivity limit on every account.',
    ],
  },
  {
    date: '2026-08-24',
    tag: 'Velstrian Bid',
    heading: 'Review gates, version history and a briefing for the tender pack',
    items: [
      'Configurable review gates: set clear review checkpoints for your team, starting with a recorded bid or no-bid decision.',
      'Full answer history: view previous revisions, compare diffs, restore past drafts, and track changes across answers.',
      'Tender briefing summaries: get an instant breakdown of key requirements from large tender packs before drafting starts.',
      'Early tender visibility: see prior information notices (PINs) and framework or dynamic purchasing system expiry dates.',
      'Past contract awards: view recently awarded public contracts alongside new opportunities to benchmark competitors.',
      'Custom social value frameworks: calculate proxy values and local community indicators from official published sources.',
      'CRM integration: two-way sync with Salesforce and HubSpot, plus a Model Context Protocol (MCP) server for technical teams.',
      'Branded document export: generate bid packs and security documentation across eight formats, including Word documents.',
    ],
  },
  {
    date: '2026-07-26',
    tag: 'Velstrian Bid',
    heading: 'Release 2.6: whole tender packs in, one editor, six stages',
    items: [
      'Upload full tender packs: automatically unpack ZIP archives and extract structured content from PowerPoint, Excel, and CSV files.',
      /* D288 (2026-10-22): the email intake line is withdrawn. It was built in
         this release but is switched off in production, so listing it read as
         a feature a customer can use today. It returns when production has it. */
      'Streamlined six-stage bid workflow: replace multi-step forms with a unified bid workspace and single answer editor.',
      'Record bid decisions: store the bid or no-bid evaluation and rationale alongside the tender record.',
      'Opportunity details: view Common Procurement Vocabulary (CPV) codes and parse bill of quantities spreadsheets line by line.',
      'Biometric sign in: use Windows Hello or Touch ID passkeys on your device for fast two-factor authentication.',
    ],
  },
  {
    date: '2026-05-05',
    tag: 'Marketing surface',
    heading: 'MP1: Marketing surface expansion',
    items: [
      'Consolidated tools hub: aggregate free assessment tools into one location, including the tender compliance matrix.',
      'Search landing page for the social value calculator, updated and redirected to the PPN 026 glossary guide.',
      'Long-form methodology guides for each tool, citing source regulations and statutory thresholds.',
      'Top navigation and footer updated with quick links to free procurement tools.',
    ],
  },
  {
    date: '2026-04-26',
    tag: 'Infrastructure',
    heading: 'Cloudflare Pages migration complete',
    items: [
      'velstrian.com hosting: modernised edge hosting on Cloudflare Pages.',
      'Isolated deployment architecture: faster page delivery and enhanced reliability for UK and international users.',
    ],
  },
];

/* Sorted here rather than trusted to authoring order, so a new entry added in
   the wrong place cannot silently break reverse-chronology. */
const sorted = [...ENTRIES].sort((a, b) => b.date.localeCompare(a.date));

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const latest = sorted[0];
---

<Base title={title} description={description} path="/changelog" schema={schema} typeface="evidenced" headerTone="light">
  {/* 2026-10-22, ON DESIGN SYSTEM VERSION 3 (R285-WEB-ENTERPRISE-REDESIGN-01):
      every entry, date, tag and line is kept. The hero carries the latest
      line, derived from the entries so it cannot disagree with the top of the
      list. The roadmap and pricing links go to the Close and the header. */}
  <PageHero
    id="changelog-title"
    bandId="changelog-hero"
    label="Changelog"
    title="What we shipped, and when."
    lead={`Public release notes for ${PRODUCT_NAME_BID}. Every new feature, improvement, and security update shipped in Velstrian Bid, explained plainly in one feed.`}
  >
    <p slot="after" class="latest">
      Latest: <strong>{latest.heading.split(':')[0]}, <time datetime={latest.date}>{fmt(latest.date)}</time></strong>
    </p>
  </PageHero>

  <Band tone="light" id="changelog-entries" labelledby="changelog-entries-title">
    <div class="ea-wrap">
      <h2 class="ea-h2 ea-h2--centre" id="changelog-entries-title" data-reveal>Release notes</h2>
      <ol class="feed">
        {
          sorted.map((e) => (
            <li class="feed__item">
              <div class="feed__meta">
                <time class="ea-label feed__date" datetime={e.date}>
                  {fmt(e.date)}
                </time>
                <span class="ea-chip feed__tag">{e.tag}</span>
              </div>
              <div>
                <h3 class="ea-h3 feed__h">{e.heading}</h3>
                <ul class="feed__list">
                  {e.items.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Band>

  <Close
    title={`Ready to see what's next for ${PRODUCT_NAME_BID}?`}
    lead="The roadmap sets out what is being built, what is being researched, and what will not be built at all."
    primary={{ href: '/roadmap/', label: 'View roadmap' }}
  />
</Base>

<style>
  /* CENTRED UNDER A CENTRED HEAD. Owner report, 2026-08-02: "central alignment
     is missing" on this page. Section centres the head block; the latest line,
     the feed track and the CTA row all sat left, so the page read as two
     layouts stacked. Alignment only, and the feed's own two-column grid keeps
     its internal left alignment because a date and a bullet list are not
     things to centre. */
  .latest {
    margin: 0;
    text-align: center;
    color: var(--c-text-muted);
  }

  /* Weight is the shared `.meta` recipe; only the colour is local. */
  .latest strong { color: var(--c-ambient-start); }


  /* A narrower centred track rather than the full measure. At 1160px the
     220px meta column left a wide empty gutter beside every short entry, which
     is what made the feed read as detached from the heading above it. */
  .feed {
    list-style: none;
    margin-inline: auto;
    padding: 0;
    max-width: var(--measure-mid);
  }

  .feed__item {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 0 clamp(20px, 3vw, 44px);
    padding: var(--stack-2) 0;
    border-top: 1px solid var(--c-border);
  }

  .feed__meta { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }

  .feed__date {
    color: var(--c-text-muted);
  }

  .feed__tag {
    color: var(--c-ambient-start);
  }

  .feed__h {
    margin: 0 0 var(--stack-1);
  }

  .feed__list {
    margin: 0;
    padding-left: 1.2em;
    list-style: disc;
  }

  .feed__list li {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--c-text-sub);
  }

  .feed__list li + li { margin-top: 6px; }
  .feed__list li::marker { color: var(--c-text-muted); }

  @media (max-width: 899px) {
    .feed__item { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .feed__meta { flex-direction: row; align-items: center; gap: 12px; }
  }
</style>
