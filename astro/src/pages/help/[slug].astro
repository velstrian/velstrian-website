---
/**
 * /help/<slug>/: one help guide (D461, D462, row R285-WEB-HELP-CENTRE-01).
 *
 * The slug, title, summary and body are the platform's own, from
 * data/help-centre.generated.json (scripts/generate-help-centre.mjs). The app
 * redirects its old /help/<slug> to the same slug here, so a slug is a URL
 * contract: rename it only in the platform, and the app redirect follows.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/evidenced/PageHero.astro';
import Band from '../../components/evidenced/Band.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import '../../styles/evidenced.css';
import { breadcrumbs } from '../../lib/schema';
import { HELP_ARTICLES, articleHtml, articlesIn, type HelpArticle } from '../../data/help-centre';

export function getStaticPaths() {
  return HELP_ARTICLES.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
  article: HelpArticle;
}

const { article } = Astro.props;
const path = `/help/${article.slug}`;
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Help centre', path: '/help/' },
];
const schema = [breadcrumbs([...trail, { name: article.title, path: `${path}/` }])];
const related = articlesIn(article.category)
  .filter((a) => a.slug !== article.slug)
  .slice(0, 4);

const HELP_TITLES: Record<string, string> = {
  'quick-start-velstrian': 'Quick Start Guide | Velstrian Tenderworks',
  'bid-workflow-end-to-end': 'End-to-End Bid Management Workflow | Velstrian',
  'procurement-act-2023-readiness': 'Procurement Act 2023 Compliance Guide | Velstrian',
  'create-bid-contract': 'Create a Tender Workspace | Velstrian Bid Guide',
  'upload-tender-documents': 'Upload and Parse Tender Documents | Velstrian Bid',
  'build-compliance-matrix': 'Build an Audit-Proof Compliance Matrix | Velstrian',
  'generate-narrative': 'Draft and Cite Bid Narratives | Velstrian Bid',
  'collaborative-bidding-and-review-workflows': 'Collaborative Bidding and Review Gates | Velstrian',
  'export-tender-responses': 'Export Submission Packs and Matrices | Velstrian',
  'social-value-score': 'Social Value Scoring and TOMs Proxies | Velstrian',
  'ppn-06-20-social-value-themes': 'PPN 06/20 Social Value Themes Reference | Velstrian',
  'toms-social-value-calculator-deep-dive': 'Social Value Bank Proxy Methodology | Velstrian',
  'carbon-reduction-plans-ppn-06-21': 'Carbon Reduction Plans and PPN 006 | Velstrian',
  'evidence-vault-basics': 'Evidence Vault Setup and Policies | Velstrian',
  'evidence-vault-audit-citations': 'Automated Citation Mapping in Answers | Velstrian',
  'public-sector-supplier-review': 'Supplier Review and Compliance Checks | Velstrian',
  'public-sector-evaluation-scoring': 'Evaluation Rubrics and Scoring Audits | Velstrian',
  'buyer-set-up-your-workspace': 'Set Up Your Buyer Profile | Velstrian Buy Guide',
  'buyer-build-a-requirement': 'Build a Buyer Requirement Pack | Velstrian Buy',
  'buyer-local-priorities-and-social-value': 'Local Priorities and Social Value | Velstrian Buy',
  'buyer-weighting-and-rubric': 'Award Weightings and Scoring Bands | Velstrian Buy',
  'buyer-publish-download-and-share-the-pack': 'Publish and Share Requirement Packs | Velstrian Buy',
  'buyer-record-suppliers': 'Record Suppliers in Your Directory | Velstrian Buy',
  'buyer-run-an-evaluation': 'Run an Evaluation and AI Pre-read | Velstrian Buy',
  'buyer-compare-bids-and-whole-life-cost': 'Compare Bids and Whole Life Cost | Velstrian Buy',
  'buyer-award-standstill-and-letters': 'Contract Award Standstill and Letters | Velstrian Buy',
  'buyer-manage-the-contract': 'Manage Contract Commitments | Velstrian Buy Guide',
  'buyer-quick-rfq': 'Quick RFQ for Private Sector Buyers | Velstrian Buy',
  'private-bid-to-a-private-buyer': 'Bid to a Private Sector Buyer | Velstrian Bid',
  'private-market-and-currency': 'Set Market and Default Currency | Velstrian Help',
  'private-quick-quote': 'Price Quotes with Quick Quote | Velstrian Help',
  'private-buyer-mode': 'Private Sector Purchasing Mode | Velstrian Buy',
  'sso-saml-scim-enterprise-setup': 'Enterprise Single Sign-On and SCIM | Velstrian',
  'billing-and-plans': 'Billing, Subscriptions and AI Credits | Velstrian',
  'invite-team-members': 'Role-Based Access and Team Invites | Velstrian',
  'account-security-and-data': 'Account Security, MFA and Data Controls | Velstrian',
  'audit-logs-and-compliance': 'Compliance Audit Trails and Session Logs | Velstrian',
  'support-and-reporting-faq': 'Support SLA and Diagnostic Reporting | Velstrian',
};

const metaTitle = HELP_TITLES[article.slug] ?? `${article.title} | Velstrian`;
const metaDescription =
  article.slug === 'ppn-06-20-social-value-themes'
    ? 'The five social value themes and Model Award Criteria introduced by PPN 06/20. Reference guide for contracts recorded under the superseded framework.'
    : article.summary;
---

<Base
  title={metaTitle}
  description={metaDescription}
  path={path}
  type="article"
  schema={schema}
  typeface="evidenced"
  headerTone="light"
>
  <PageHero id="help-article-title" size="compact" label={article.category} title={article.title} lead={article.summary}>
    <div slot="before" class="ea-trail"><Breadcrumb trail={trail} current={article.title} /></div>
    <p slot="after" class="ea-label">{article.readingTime} read</p>
  </PageHero>

  <Band tone="light" class="help-article" flush>
    <div class="ea-wrap help-article__grid">
      <article class="prose help-article__body" set:html={articleHtml(article)} />
      <aside class="help-article__rail" aria-labelledby="help-related-title">
        <p class="ea-label help-article__rail-title" id="help-related-title">More in {article.category}</p>
        <ul role="list">
          {related.map((a) => (
            <li><a href={`/help/${a.slug}/`}>{a.title}</a></li>
          ))}
          <li><a href="/help/">All guides</a></li>
        </ul>
        <p class="help-article__ask">
          Still stuck? <a href="/help/contact/">Contact support</a>, no sign in needed.
        </p>
      </aside>
    </div>
  </Band>
</Base>

<style>
  .help-article__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: clamp(32px, 5vw, 72px);
  }

  .help-article__body {
    min-width: 0;
  }

  .help-article__rail {
    align-self: start;
    position: sticky;
    top: calc(var(--v3-header-h) + var(--space-6));
    display: grid;
    gap: var(--space-3);
  }

  .help-article__rail-title {
    margin: 0;
    color: var(--c-text-muted);
  }

  .help-article__rail ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .help-article__rail a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-1) 0;
    font-family: var(--font-body);
    font-size: var(--t-ea-small);
    line-height: 1.4;
    color: var(--c-interactive);
  }

  .help-article__ask {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--t-ea-small);
    line-height: 1.5;
    color: var(--c-text-muted);
  }

  @media (max-width: 899px) {
    .help-article__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .help-article__rail {
      position: static;
      padding-top: var(--stack-2);
      border-top: 1px solid var(--c-border);
    }
  }
</style>
