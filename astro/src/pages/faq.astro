---
/**
 * /faq
 *
 * THE POINT OF THIS PAGE IS THAT THE STRUCTURED DATA IS GENERATED.
 *
 * The legacy page hand-wrote 14 accordions in HTML and hand-wrote a separate
 * FAQPage JSON-LD block beside them. They drifted: 9 questions in the schema
 * against 14 on screen, one answer truncated, two in a different order, and the
 * whole Security category (the most trust-critical block) absent from the
 * structured data entirely. 36% of the page was invisible to the consumers that
 * block exists for.
 *
 * Nobody did that on purpose. It is what two hand-maintained copies of the same
 * content guarantee over time. Here the accordions and the FAQPage node both
 * come from FAQ_CATEGORIES in src/data/faq.ts, so drift requires deleting one of
 * two call sites rather than merely forgetting.
 *
 * SEO is carried over verbatim: title, description, canonical.
 *
 * ── 2026-10-22: ON DESIGN SYSTEM VERSION 3 ───────────────────────────────────
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy 0.7. Every question, answer, link
 * and control is kept, on the v3 bands:
 *
 *   1. PageHero    light      what is this?     h1, lead, Book a call, Browse, the search
 *   2. SectionBand light/alt  the register      one band per category, the questions
 *   3. SectionBand light-alt  still stuck?      message, call, email
 *
 * The answers carry no typed price or fact: data/faq.ts reads them from
 * data/pricing.ts, data/duty.ts and data/site-facts.ts.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/evidenced/PageHero.astro';
import SectionBand from '../components/evidenced/SectionBand.astro';
import Action from '../components/evidenced/Action.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { FAQ_CATEGORIES, FAQ_ALL } from '../data/faq';
import { WALKTHROUGH_URL } from '../data/app';
import { faqPage, breadcrumbs } from '../lib/schema';
import { HELLO_EMAIL } from '../lib/brand-names';
import '../styles/evidenced.css';

const title = 'Velstrian Bid FAQ | Bid software questions answered | Velstrian';
const description =
  'Plans, pricing, AI credits, security and the rules Velstrian Bid reads. Answers to the questions UK bid teams ask most.';

const TRAIL = [{ name: 'Home', path: '/' }];

/* Both nodes derive from the same array the page renders. */
const schema = [
  ...faqPage(FAQ_ALL),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq/' },
  ]),
];

/*
 * WHEN THIS PAGE LAST MATERIALLY CHANGED. Read by Seo.astro into a WebPage
 * node's dateModified, and from there by scripts/build-sitemap.js into
 * <lastmod>. It is a FACT about this page, not a build timestamp: bump it only
 * when the page's content actually changes, never on a redeploy. Leaving it
 * stale is safer than advancing it falsely, because a sitemap that claims
 * everything changed is discounted.
 */
const UPDATED = new Date('2026-10-22'); /* R285-WEB-ENTERPRISE-REDESIGN-01: the security answer now names the ICO reference and the certification statement from site-facts. */
---

<Base title={title} description={description} path="/faq" schema={schema} updatedAt={UPDATED} typeface="evidenced" headerTone="light">
  <PageHero
    id="faq-title"
    bandId="faq-top"
    label="Help centre · Support"
    title="Questions about Velstrian?"
    lead="Plans, pricing, AI credits, security and the rules Velstrian Bid reads. If your question is not on this page, book a call."
  >
    <div slot="before" class="ea-trail"><Breadcrumb trail={TRAIL} current="FAQ" /></div>
    <Action href={WALKTHROUGH_URL} newWindow>Book a 30-minute call</Action>
    <Action href="#faq-general" variant="secondary">Browse questions</Action>
    <div slot="after" class="faq-search">
      <label class="faq-search__label" for="faq-search">Search the questions</label>
      <input
        class="field__input faq-search__input"
        id="faq-search"
        type="search"
        placeholder="Try &quot;credits&quot;, &quot;PPN&quot; or &quot;cancel&quot;"
        autocomplete="off"
      />
      {/* Politely announced, because a sighted reader watches the list shrink
          and a screen reader user is otherwise told nothing at all. */}
      <p class="faq-search__status" id="faq-search-status" role="status" aria-live="polite"></p>
    </div>
  </PageHero>

  {/*
    One band per category, alternating light and light alt, so the register
    reads as one column broken into groups. The category's label and heading
    are the same word, so the heading alone is printed. The open and close
    mark is the site's one disclosure treatment, summary::after in
    styles/blocks.css (A-65).
  */}
  {
    FAQ_CATEGORIES.map((cat, i) => (
      <SectionBand tone={i % 2 === 0 ? 'light' : 'light-alt'} title={cat.heading} standfirst={cat.standfirst} id={cat.id} align="centre">
        <div class="ea-faq__wrap faq-list">
          {cat.entries.map((e) => (
            <details class="ea-qa faq-item" data-q={`${e.question} ${e.answer}`.toLowerCase()}>
              <summary>{e.question}</summary>
              <p>{e.answer}</p>
              {e.link && (
                <p class="faq-item__link">
                  <a class="ea-link" href={e.link.href}>{e.link.label}</a>
                </p>
              )}
            </details>
          ))}
        </div>
      </SectionBand>
    ))
  }

  <SectionBand
    tone={FAQ_CATEGORIES.length % 2 === 0 ? 'light' : 'light-alt'}
    title="Still have questions?"
    standfirst="If the answer is not here, ask us directly. A person on the team that built it replies, usually within three to five business days."
    id="faq-contact"
    align="centre"
  >
    {/*
      "EMAIL US" IS BACK (OA-28, 2026-08-02). The general enquiry address is a
      third route in, beside the form and the call, for a reader who wants
      neither.
    */}
    <div class="ea-actions faq-contact__actions">
      <Action href="/contact/#contact-form">Send us a message</Action>
      <Action href={WALKTHROUGH_URL} variant="secondary" newWindow>Book a call</Action>
      <Action href={`mailto:${HELLO_EMAIL}`} variant="secondary">Email us</Action>
    </div>
  </SectionBand>
</Base>

<script>
  /**
   * Client-side filter. Deliberately hides the ANSWER-matching items too, not
   * just question matches: someone searching "credits" is as likely to be
   * looking for a phrase inside an answer.
   *
   * Everything is visible by default and the filter only ever REMOVES. If this
   * script never runs, the page is a complete, readable FAQ, which is the rule
   * that the earlier hide-then-reveal pattern on this site broke, leaving 4 of 9
   * homepage sections permanently invisible when an observer did not fire.
   */
  function initFaqSearch() {
    const input = document.getElementById('faq-search') as HTMLInputElement | null;
    const status = document.getElementById('faq-search-status');
    if (!input || !status) return;

    const items = Array.from(document.querySelectorAll<HTMLElement>('.faq-item'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id^="faq-"]'));
    if (!items.length) return;

    let timer: number | undefined;

    function apply() {
      const q = input!.value.trim().toLowerCase();
      let shown = 0;

      for (const item of items) {
        const hit = !q || (item.dataset.q ?? '').includes(q);
        item.hidden = !hit;
        if (hit) shown++;
        // Open matches once the query is specific enough to be worth reading,
        // and close them again when the query is cleared.
        if (q.length >= 3) (item as HTMLDetailsElement).open = hit;
        else if (!q) (item as HTMLDetailsElement).open = false;
      }

      // A category with nothing left in it is noise. Hide the whole section,
      // but never the hero or the closing block.
      for (const s of sections) {
        if (s.id === 'faq-top' || s.id === 'faq-contact') continue;
        const any = Array.from(s.querySelectorAll<HTMLElement>('.faq-item')).some(
          (i) => !i.hidden
        );
        s.hidden = !any;
      }

      status!.textContent = q
        ? shown === 0
          ? `No questions match "${q}". Try a different term.`
          : `${shown} question${shown === 1 ? '' : 's'} match "${q}".`
        : '';
    }

    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(apply, 150);
    });

    // Enter would submit an enclosing form or reload; there is nothing to submit.
    input.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') e.preventDefault();
    });
  }

  initFaqSearch();
</script>

<style>
  /* The search sits under the hero's actions, at a field's width. Sizes are
     the system's: the field is the shared .field__input. */
  /* The hero head centres its children at their own width, so the field
     states its width rather than taking 100% of a shrunk box. */
  .faq-search {
    width: min(var(--ea-copy), calc(100vw - var(--ea-gutter) * 2));
    margin-inline: auto;
  }

  .faq-search__input {
    width: 100%;
  }

  .faq-search__label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--t-ea-small);
    font-weight: var(--t-w-ea-medium);
    color: var(--ea-ink);
  }

  .faq-search__input:focus-visible {
    outline: var(--ea-focus);
    outline-offset: 2px;
  }

  .faq-search__status {
    min-height: 1em;
    margin-top: var(--space-2);
    font-size: var(--t-ea-tiny);
    color: var(--ea-muted);
  }

  /* The register is one reading column, centred under its centred head. */
  .faq-list {
    padding-inline: 0;
    margin-inline: auto;
    text-align: start;
  }

  .faq-item__link {
    margin-top: calc(var(--space-4) * -1);
  }

  .faq-contact__actions {
    justify-content: center;
  }
</style>
