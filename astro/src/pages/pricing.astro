---
/**
 * /pricing/: the Velstrian pricing page on design system v3.
 *
 * ── 2026-10-22: REBUILT ON DESIGN SYSTEM VERSION 3 ──────────────────────────
 *
 * R285-WEB-ENTERPRISE-REDESIGN-01. docs/design/R285-GEMINI-BRIEF-PAGES.md.
 * Follows R285-BILLING-AND-PRICING-TRANSFORMATION-SPEC-2026-10-21.md Part 2
 * (2.1 to 2.4), the website rows of Part 4 (W1 to W13), and the decisions
 * in Part 6.
 *
 * STORYLINE:
 *   1. PricingHero          light      what is this, what does it cost?  one sentence, toggle in hero
 *   2. PricingPlans         light alt  choose your plan                  three plan cards, plain lines
 *   3. PricingCredits       dark       how AI credits work               simple explanation, extra usage options
 *   4. PricingBuy           light      Velstrian Buy for buyers          two buyer cards, W2/W4 fixes
 *   5. PricingCompare       light alt  compare every feature             statutory checks, page counting table
 *   6. PricingFaq           light      frequently asked questions        newcomer doubts answered directly
 *   7. PricingPurchaseOrder dark       buying on a purchase order        shortened PO block, security credentials
 *   8. Close                gradient   what now?                         gradient band into dark footer
 *   9. Regulatory sources   light      statutory evidence                PPN 026, PPN 017, Procurement Act
 *
 * ── SEO AND STRUCTURED DATA ARE CARRIED OVER VERBATIM ───────────────────────
 *
 * BreadcrumbList, ItemList with offers for Bid and Buy, and FAQPage JSON-LD
 * are preserved.
 */
import Base from '../layouts/Base.astro';
import PricingHero from '../components/pricing/PricingHero.astro';
import PricingPlans from '../components/pricing/PricingPlans.astro';
import PricingCredits from '../components/pricing/PricingCredits.astro';
import PricingBuy from '../components/pricing/PricingBuy.astro';
import PricingCompare from '../components/pricing/PricingCompare.astro';
import PricingFaq from '../components/pricing/PricingFaq.astro';
import PricingPurchaseOrder from '../components/pricing/PricingPurchaseOrder.astro';
import Close from '../components/evidenced/Close.astro';
import { PRICING_PAGE_FAQS } from '../components/pricing/faqs';
import '../styles/evidenced.css';
import { breadcrumbs, faqPage } from '../lib/schema';
import { SITE } from '../data/site';
import { PLANS, BUYER_PLANS, SIGNUP_URL, TRIAL_DAYS, annualDiscountPct, START_LABEL } from '../data/pricing';

const [P_STARTER, P_PRO, P_PORTFOLIO] = PLANS;
const [P_BUYER_PRO, P_BUYER_PORTFOLIO] = BUYER_PLANS;
const SAVE_PCT = annualDiscountPct(P_STARTER);
const title = `Velstrian Bid pricing | Plans from £${P_STARTER.monthly} a month | Velstrian`;
const description =
  `Velstrian pricing: Velstrian Bid from £${P_STARTER.monthly} a month, Pro £${P_PRO.monthly}, Portfolio £${P_PORTFOLIO.monthly}, Velstrian Buy from £${P_BUYER_PRO.monthly} and Buyer Portfolio £${P_BUYER_PORTFOLIO.monthly}. Annual billing saves ${SAVE_PCT}%. Start today by card.`;

const offers = PLANS.filter((p) => p.monthly !== null).map((p) => ({
  '@type': 'Offer',
  name: p.name,
  price: String(p.monthly),
  priceCurrency: 'GBP',
  url: `${SITE.origin}/pricing`,
}));

const buyerOffers = BUYER_PLANS.filter((p) => p.monthly !== null).map((p) => ({
  '@type': 'Offer',
  name: p.name,
  price: String(p.monthly),
  priceCurrency: 'GBP',
  url: `${SITE.origin}/pricing`,
}));

const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Pricing', path: '/pricing/' },
  ]),
  {
    '@type': 'ItemList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: {
          '@type': 'SoftwareApplication',
          name: 'Velstrian Bid',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web',
          url: `${SITE.origin}/bid`,
          publisher: { '@type': 'Organization', name: 'Velstrian', url: `${SITE.origin}/` },
          offers,
        },
      },
      {
        '@type': 'ListItem',
        position: 2,
        item: {
          '@type': 'SoftwareApplication',
          name: 'Velstrian Buy',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web',
          url: `${SITE.origin}/buy`,
          publisher: { '@type': 'Organization', name: 'Velstrian', url: `${SITE.origin}/` },
          offers: buyerOffers,
        },
      },
    ],
  },
  ...faqPage(PRICING_PAGE_FAQS),
];

const UPDATED = new Date('2026-10-22');
---

<Base
  title={title}
  description={description}
  path="/pricing"
  schema={schema}
  updatedAt={UPDATED}
  typeface="evidenced"
  headerTone="light"
>
  <div class="pricing-page">
    {/* The billing choice: two radios, so each segment of the control in
        PricingHero is a label that SELECTS rather than toggles (a second
        press on "Monthly" leaves it monthly). They sit first in the page so
        every band below reads them with `~ *`. #billing-toggle is the annual
        one, and every price rule keys off `#billing-toggle:checked` in CSS,
        with no script (R285-WEB-TRANSFORMATION-WT-F, audit S3). */}
    <input
      type="radio"
      id="billing-monthly"
      name="billing"
      class="billing-input visually-hidden"
      aria-label="Show monthly prices"
      checked
    />
    <input
      type="radio"
      id="billing-toggle"
      name="billing"
      class="billing-input visually-hidden"
      aria-label={`Show annual prices, which save ${SAVE_PCT}%`}
    />

    <PricingHero />
    <PricingPlans>
      <div class="pricing-billing" slot="toggle" role="radiogroup" aria-label="Billing interval">
        <label for="billing-monthly" role="radio" aria-checked="true" class="pricing-billing__seg pricing-billing__seg--m">Monthly</label>
        <label for="billing-toggle" role="radio" aria-checked="false" class="pricing-billing__seg pricing-billing__seg--a">Annual billing · Save {SAVE_PCT}%</label>
      </div>
    </PricingPlans>
    <PricingCredits />
    <PricingBuy />
    <PricingCompare />
    <PricingFaq />
    <PricingPurchaseOrder />

    <section class="ea-sec pricing-sources band--light" aria-label="Regulatory sources">
      <div class="ea-wrap">
        <p class="pricing-sources__text">
          PPN 026, published 5 August 2026 and applying to central government procurements
          commenced on or after 1 January 2027 at 1 million pounds inc VAT or above · PPN 017 ·
          Procurement Act 2023, section 52 (indicators set and published) and section 71
          (performance assessed and published)
        </p>
      </div>
    </section>

    <Close
      title="Your next bid or tender can start today."
      lead={`Try Velstrian Bid free for ${TRIAL_DAYS} days, or talk it through with us first.`}
      primary={{ href: SIGNUP_URL, label: START_LABEL }}
    />
  </div>
</Base>

<script>
  function initBillingAria() {
    const mInput = document.getElementById("billing-monthly");
    const aInput = document.getElementById("billing-toggle");
    const mSeg = document.querySelector(".pricing-billing__seg--m");
    const aSeg = document.querySelector(".pricing-billing__seg--a");
    function update() {
      if (mInput && aInput && mSeg && aSeg) {
        const isAnnual = aInput.checked;
        mSeg.setAttribute("aria-checked", String(!isAnnual));
        aSeg.setAttribute("aria-checked", String(isAnnual));
      }
    }
    mInput?.addEventListener("change", update);
    aInput?.addEventListener("change", update);
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBillingAria, { once: true });
  } else {
    initBillingAria();
  }
</script>

<style>
  .pricing-page {
    position: relative;
  }

  .pricing-billing {
    display: inline-flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border: 1px solid var(--ea-rule);
    border-radius: var(--radius-pill);
    background: var(--ea-well);
  }

  .pricing-billing__seg {
    display: inline-flex;
    align-items: center;
    min-height: var(--ea-btn-h);
    padding-inline: var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--t-ea-small);
    font-weight: var(--t-w-ea-medium);
    color: var(--ea-muted);
    cursor: pointer;
    transition: var(--transition-hover), color var(--ea-dur-hover) ease-out;
  }

  :global(#billing-monthly:checked ~ * .pricing-billing__seg--m),
  :global(#billing-toggle:checked ~ * .pricing-billing__seg--a) {
    border-color: var(--ea-accent);
    background: var(--ea-accent-wash);
    color: var(--ea-accent-ink);
    box-shadow: 0 0 0 1px var(--ea-accent);
    font-weight: var(--t-w-ea-strong);
  }

  :global(#billing-monthly:focus-visible ~ * .pricing-billing__seg--m),
  :global(#billing-toggle:focus-visible ~ * .pricing-billing__seg--a) {
    outline: var(--ea-focus);
    outline-offset: 2px;
  }

  .pricing-sources {
    padding-block: var(--space-8);
    border-top: 1px solid var(--ea-rule);
    text-align: center;
  }

  .pricing-sources__text {
    margin-inline: auto;
    max-width: var(--ea-copy);
    font-size: var(--t-ea-small);
    line-height: var(--lh-ea-body);
    color: var(--ea-muted);
  }
</style>
