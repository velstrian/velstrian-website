---
/**
 * /compare/: the comparison hub.
 *
 * ── 2026-10-22: ON DESIGN SYSTEM VERSION 3 ──────────────────────────────────
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy 0.7. Every comparison, link and
 * line of the previous page is kept, on the v3 bands:
 *
 *   1. PageHero   light     which tools are compared?  trail, h1, lead, two actions
 *   2. Hub        light     pick one                   the two intro lines, four cards, the feed on a stage
 *   3. Close      gradient  what now?                  "Decide faster.", See pricing
 *
 * The starting price is read from data/pricing.ts, never typed (it was a
 * typed "£49" in two places). The h1 stays spelled out rather than bound to
 * the title const, for the reason the previous version recorded: the const is
 * the <title> and the CollectionPage name, and binding them means tuning one
 * silently rewrites the other.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/evidenced/PageHero.astro';
import Band from '../../components/evidenced/Band.astro';
import Action from '../../components/evidenced/Action.astro';
import ProductScreen from '../../components/evidenced/ProductScreen.astro';
import Close from '../../components/evidenced/Close.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { SITE } from '../../data/site';
import { SIGNUP_URL, START_LABEL } from '../../data/app';
import { PLANS, TRIAL_NOTE } from '../../data/pricing';
import { breadcrumbs } from '../../lib/schema';
import { routeUrl } from '../../lib/route-url';
import { PRODUCT_NAME_BID, PRODUCT_NAME_BUY } from '../../lib/brand-names';
import '../../styles/evidenced.css';

const title = 'Compare Velstrian Bid with UK bid software';
const description =
  'Side-by-side comparisons of Velstrian Bid against AutogenAI, mytender.io, CleanTender and SwiftBid. A dated source for every competitor figure.';
const path = '/compare';

const comparisons = [
  {
    href: '/compare/bid-vs-autogenai/',
    tag: 'Enterprise engine',
    name: 'Velstrian Bid vs AutogenAI',
    blurb:
      'Published SME pricing against a venture-backed enterprise engine that quotes on request. Where scale wins and where it does not.',
  },
  {
    href: '/compare/bid-vs-mytender-io/',
    tag: 'UK drafting platform',
    name: 'Velstrian Bid vs mytender.io',
    blurb:
      'Two UK-built tools. Figure-grounding and published pricing against a private-cloud drafting platform with content-tool integrations.',
  },
  {
    href: '/compare/bid-vs-cleantender/',
    tag: 'Soft-FM specialist',
    name: 'Velstrian Bid vs CleanTender',
    blurb: 'A sector-agnostic suite against a soft-FM specialist. Both publish pricing, so the question is scope and depth.',
  },
  {
    href: '/compare/bid-vs-swiftbid/',
    tag: 'Per-bid service',
    name: 'Velstrian Bid vs SwiftBid',
    blurb: 'Subscribe, or pay per bid. Which model fits depends on how often you bid. The break-even, worked through.',
  },
];

/* One array for the trail a reader sees and the trail this page publishes. See
   the note in layouts/Compare.astro: the two were hand-written separately across
   this page and that layout, and the layout's two copies disagreed. */
const [STARTER] = PLANS;
const UPDATED = new Date('2026-10-22');

const trail = [{ name: 'Home', path: '/' }];

const schema = [
  breadcrumbs([...trail, { name: 'Compare', path }]),
  {
    '@type': 'CollectionPage',
    name: title,
    /* routeUrl, not origin-plus-path: the concatenated form drops the trailing
       slash and is therefore the 308 source on a directory-format build. This
       node named its own page and all four comparison pages that way. */
    url: routeUrl(path),
    description: 'Honest, sourced comparisons of Velstrian Bid against AutogenAI, mytender.io, CleanTender and SwiftBid.',
    publisher: { '@id': `${SITE.origin}/#organization` },
    hasPart: comparisons.map((c) => ({
      '@type': 'WebPage',
      name: c.name,
      url: routeUrl(c.href),
    })),
  },
];
---

<Base
  title={`${title} | Velstrian`}
  description={description}
  path={path}
  image="/Assets/og/crowmark.png"
  schema={schema}
  updatedAt={UPDATED}
  typeface="evidenced"
  headerTone="light"
>
  <PageHero
    id="cmp-hub-title"
    label="Honest comparisons"
    title="Compare Velstrian Bid with UK bid software"
    lead="Side-by-side, sourced comparisons of Velstrian Bid against the tools UK suppliers shortlist. Real feature tables, our published pricing, and a dated source for every competitor figure."
  >
    <div slot="before" class="ea-trail"><Breadcrumb trail={trail} current="Compare" /></div>
    <Action href="#comparisons">See the comparisons</Action>
    <Action href={SIGNUP_URL} variant="secondary">{START_LABEL}</Action>
    <Fragment slot="note">{TRIAL_NOTE}</Fragment>
  </PageHero>

  <Band tone="light" id="comparisons" class="cmp-hub">
    <div class="ea-wrap">
      <div class="cmp-hub__intro" data-reveal>
        <p class="ea-lead">
          {PRODUCT_NAME_BID} is a UK bid and tender management suite from &pound;{STARTER.monthly} per month. Where a
          rival does not publish a figure, we mark it Not published rather than guess, and we concede the points where
          {PRODUCT_NAME_BID} is not the strongest option. Pick a comparison below.
        </p>
        <p>
          Velstrian serves both sides of a procurement: {PRODUCT_NAME_BID} for Suppliers answers tenders, RFPs and
          questionnaires, and {PRODUCT_NAME_BUY} for Buyers locates the evidence for each published requirement across
          the responses received. Both work in the public sector and the private sector. Every supplier and buyer plan
          has a published price, on the <a class="cmp-hub__link" href="/pricing/">pricing page</a>. The comparisons
          below are supplier-side, because that is where the competing tools sit.
        </p>
      </div>

      <ul class="ea-cards ea-cards--2" role="list">
        {
          comparisons.map((c) => (
            <li data-reveal>
              <a class="ea-card ea-tcard" href={c.href}>
                <p class="ea-label">{c.tag}</p>
                <h2 class="ea-h3">{c.name}</h2>
                <p>{c.blurb}</p>
                <span class="ea-tcard__more">Read comparison</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="cmp-hub__screen" data-reveal>
        <ProductScreen name="find" />
      </div>
    </div>
  </Band>

  <Close
    title="Decide faster."
    lead={`Published pricing from £${STARTER.monthly} a month, live and ready to use today. Start today. No sales call needed.`}
    primary={{ href: '/pricing/?product=mark', label: 'See pricing' }}
  />
</Base>

<style>
  .cmp-hub__intro {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-prose);
    color: var(--ea-sub);
  }

  .cmp-hub__link {
    color: var(--ea-accent-ink);
  }

  .cmp-hub__intro + .ea-cards {
    margin-top: var(--ea-head-gap);
  }

  .cmp-hub__screen {
    margin-top: var(--ea-head-gap);
  }
</style>
