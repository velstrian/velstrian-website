---
import { getCollection, render } from 'astro:content';
import Compare from '../../layouts/Compare.astro';
import ProductScreen from '../../components/evidenced/ProductScreen.astro';
import { resolvePriceTokensDeep } from '../../lib/price-tokens';

export async function getStaticPaths() {
  const pages = await getCollection('compare');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
/* Our prices in the frontmatter are tokens resolved from data/pricing.ts
   (lib/price-tokens.ts). The body's are resolved in Compare.astro. */
const d = resolvePriceTokensDeep(page.data, `compare/${page.id}`);
---

<Compare
  title={d.title}
  description={d.description}
  ogDescription={d.ogDescription}
  articleDescription={d.articleDescription}
  path={`/compare/${page.id}`}
  publishedAt={d.publishDate}
  updatedAt={d.updatedDate}
  competitor={d.competitor}
  eyebrow={d.eyebrow}
  heroDescription={d.heroDescription}
  ogImage={d.ogImage}
  ogImageAlt={d.ogImageAlt}
  ctaHeadline={d.ctaHeadline}
  ctaSubLine1={d.ctaSubLine1}
  ctaSubLine2={d.ctaSubLine2}
  faq={d.faq}
>
  <Content />
  <ProductScreen slot="screen" name={d.screen} />
</Compare>
