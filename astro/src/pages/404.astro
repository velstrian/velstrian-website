---
/**
 * 404
 *
 * Cloudflare Pages serves /404.html for any unmatched path, so without this the
 * new site would answer a mistyped URL with a bare platform error page, no
 * navigation, no branding, and nothing to do next. The legacy site has one; the
 * Astro build did not, which would have been a regression at cutover.
 *
 * WHAT A 404 IS FOR. Not an apology. The reader is somewhere that does not
 * exist and needs a route out, so the page names the likely reasons and offers
 * the destinations people actually arrive looking for. It also surfaces the
 * command palette, which is the fastest way to find a page whose URL was
 * mistyped. The reader already knows what they wanted, they just missed.
 *
 * noindex, because a 404 that gets indexed is a 404 that shows up in results.
 * It stays crawlable so the status code is still read.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/evidenced/PageHero.astro';
import Band from '../components/evidenced/Band.astro';
import Action from '../components/evidenced/Action.astro';
import '../styles/evidenced.css';

const title = 'Page Not Found | Velstrian Tenderworks';
const description = 'That page does not exist. Find what you were looking for from here.';

/** The destinations people actually arrive looking for. */
const ROUTES = [
  { href: '/bid/', label: 'Velstrian Bid', note: 'Find tenders, draft cited answers, evidence delivery' },
  { href: '/buy/', label: 'Velstrian Buy', note: 'Publish requirements and locate evidence in responses' },
  { href: '/tools/tender-compliance-matrix/', label: 'Tender Compliance Matrix', note: 'Free, no account, no email gate' },
  { href: '/tools/tender-finder/', label: 'Tender Finder', note: 'Search open UK and EU tenders, free' },
  { href: '/blog/', label: 'Blog', note: 'Long-form analysis, cited to the policy note it rests on' },
  { href: '/faq/', label: 'FAQ', note: 'Plans, pricing, AI credits and security' },
  { href: '/contact/#contact-form', label: 'Contact', note: 'A person on the team that built it replies' },
];
---

<Base title={title} description={description} path="/404" noindex typeface="evidenced" headerTone="light">
  {/* 2026-10-22, ON DESIGN SYSTEM VERSION 3 (R285-WEB-ENTERPRISE-REDESIGN-01).
      The same words, the same two ways out and the same seven routes. The
      search button opens the command palette through data-cmdk-open, the same
      hook the nav uses: the fastest route when someone knows what they want
      and simply missed the URL. */}
  <PageHero
    id="not-found-title"
    bandId="not-found"
    label="404"
    title="That page does not exist."
    lead="The address may be mistyped, or the page may have been removed. The links below are where people usually meant to go."
  >
    <Action href="/">Back to the homepage</Action>
    <Action as="button" variant="secondary" data-cmdk-open="">
      Search the site<span class="visually-hidden"> (opens the search palette)</span>
    </Action>
  </PageHero>

  <Band tone="light" labelledby="not-found-title">
    <div class="ea-wrap">
      <ul class="routes">
        {
          ROUTES.map((r) => (
            <li>
              <a href={r.href}>{r.label}</a>
              <span>{r.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Band>
</Base>

<style>
  .routes {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--measure-prose);
  }

  .routes li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--c-border);
  }

  .routes li:last-child { border-bottom: 0; }

  .routes a {
    /* 44px target, WCAG 2.2. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-ea-h3);
    font-weight: var(--t-w-ea-strong);
    color: var(--ea-ink);
    text-decoration: none;
  }
  .routes a:hover { color: var(--ea-accent-ink); }
  .routes a:focus-visible { outline: 3px solid var(--c-interactive); outline-offset: 3px; border-radius: 3px; }

  .routes span {
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--c-text-muted);
  }

</style>
