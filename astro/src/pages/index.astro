---
/**
 * The homepage.
 *
 * ── 2026-10-21: BUILT WHOLE FROM THE EVIDENCED ANSWER SYSTEM ────────────────
 *
 * R285-WEB-ENTERPRISE-REDESIGN-01. docs/design/R285-DESIGN-STRATEGY-2026-10-21.md
 * was adopted by the owner on 2026-10-21 and this page is its first build. It
 * is composed from components/evidenced/ and styles/evidenced.css, not edited
 * from the sections it replaces, and those sections (components/home2/) are
 * left untouched until the owner approves this page, because other routes
 * still use the shared shell they were built against.
 *
 * VERSION 2 (strategy section 0, owner 2026-10-21 evening): written for a
 * small or mid size organisation that writes its own bids, public AND
 * private, never for an expert bid manager (RULE 0-U).
 *
 * VERSION 3 (strategy section 0.8, owner 2026-10-21 night): the visual
 * system. Bands alternate light and dark, each section its own temperature,
 * product UI floats on the indigo to purple stage, and content settles in
 * once on first view. Each section answers the next thing a first time
 * visitor wonders:
 *
 *   Hero          light      what is this, is it for me?  stage, sequence
 *   Facts         dark       why trust it?                hairline facts, trust strip
 *   Audience      light      is it for someone like me?   who are you tabs, stages
 *   Capabilities  light alt  what can it do?              five tabs, stage, sequence
 *   Refusal       dark       can I trust what it writes?  the one slow moment
 *   Screens       light      what does it look like?      product carousel
 *   Steps         dark       how hard is it to start?     three steps
 *   Plans         light alt  what does it cost?           three plan cards
 *   Faq           light      I have questions             rules, centred
 *   Close         gradient   what now?                    overlaps into the footer
 *
 * ── SEO IS CARRIED OVER VERBATIM, AS THROUGH EVERY EARLIER REDESIGN ────────
 *
 * Title, description, canonical and the JSON-LD graph are untouched. Their
 * history (OA-33, A-112, A-89) is in git: `git log -p -- astro/src/pages/index.astro`.
 * Changing homepage metadata is a separate, measured decision and never rides
 * along inside a redesign.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/evidenced/Hero.astro';
import Audience from '../components/evidenced/Audience.astro';
import Capabilities from '../components/evidenced/Capabilities.astro';
import Refusal from '../components/evidenced/Refusal.astro';
import Steps from '../components/evidenced/Steps.astro';
import Facts from '../components/evidenced/Facts.astro';
import Faq from '../components/evidenced/Faq.astro';
import Screens from '../components/evidenced/Screens.astro';
import Plans from '../components/evidenced/Plans.astro';
import Close from '../components/evidenced/Close.astro';
import '../styles/evidenced.css';
import { SITE } from '../data/site';

/* 58 characters. See the header for why this is a list and not a sentence, and
   for the 60-character ceiling A-89 set. Unchanged by the 2026-09-06 redesign. */
const title = 'Velstrian | Bid software: supplier, buyer, public, private';

/* 157 characters, cut from 195 under A-89. Unchanged by the redesign. Both
   sides are kept, because that is the point of the sentence and OA-25's market
   neutrality rides on it: public sector and private, supplier and buyer, all
   four still present. */
const description =
  'Velstrian serves both sides of procurement, public and private. Suppliers answer tenders, RFPs and PQQs from bids already written. Buyers find the evidence.';

/** The WebSite node the legacy page emits alongside Organization. Unchanged. */
const webSite = {
  '@type': 'WebSite',
  '@id': `${SITE.origin}/#website`,
  url: `${SITE.origin}/`,
  name: SITE.name,
  publisher: { '@id': `${SITE.origin}/#organization` },
};

/*
 * WHEN THIS PAGE LAST MATERIALLY CHANGED. Read by Seo.astro into a WebPage
 * node's dateModified, and from there by scripts/build-sitemap.js into
 * <lastmod>. It is a FACT about this page, not a build timestamp: bump it only
 * when the page's content actually changes, never on a redeploy.
 *
 * Moved from 2026-08-05 to 2026-09-06 because every section on the page was
 * rebuilt on that day. This is exactly the case the rule above is for: the
 * presentation changed completely, and a crawler that re-reads the page will
 * find a different document.
 */
const UPDATED = new Date('2026-10-21');
---

<Base
  title={title}
  description={description}
  path="/"
  schema={[webSite]}
  updatedAt={UPDATED}
  typeface="evidenced"
  headerTone="light"
>
  <Hero />
  <Facts />
  <Audience />
  <Capabilities />
  <Refusal />
  <Screens />
  <Steps />
  <Plans />
  <Faq />
  <Close />
</Base>
