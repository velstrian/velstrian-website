---
/**
 * /partners
 *
 * The enquiry form used to POST to Formspree, a US processor that privacy.html
 * does not name, contradicting the form's own consent line ("in line with the
 * Privacy Policy"). Logged as OA-08 and CLOSED 2026-09-03
 * (R281-PARTNERS-ENQUIRY-DECISION-01): PartnerForm.astro now posts to the
 * platform's own `POST /api/v1/partners/enquiry`, first party, no Formspree
 * in the path. See that component's header for the full change.
 *
 * SEO carried over verbatim. Note that `description` and `og:description` are
 * DIFFERENT strings on the live page (two separately written sentences, both
 * already indexed), so they are kept distinct rather than unified.
 *
 * The H1 is the CORRECTED wording. As shipped, the two hero spans concatenated
 * to "Put CrowMark in front of to your clients.", which is not grammatical under
 * any reading and was the page's accessible name. Repaired in the legacy page
 * too, and logged as OA-11 in case a different headline was intended.
 *
 * -- 2026-10-22: ON DESIGN SYSTEM VERSION 3 --
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy 0.7. PageHero, What partners get,
 * Who we partner with, and the enquiry band with the reasons panel beside the
 * form, every heading, card, link and the form kept. The call link reads
 * WALKTHROUGH_URL instead of a local copy of the same URL.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/evidenced/PageHero.astro';
import SectionBand from '../components/evidenced/SectionBand.astro';
import Action from '../components/evidenced/Action.astro';
import Icon from '../components/evidenced/Icon.astro';
import ProductScreen from '../components/evidenced/ProductScreen.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { WALKTHROUGH_URL } from '../data/app';
import '../styles/evidenced.css';
import PartnerForm from '../components/forms/PartnerForm.astro';
import { breadcrumbs } from '../lib/schema';
import { HELLO_EMAIL, PRODUCT_NAME_BID } from '../lib/brand-names';

const TRAIL = [{ name: 'Home', path: '/' }];

const title = 'Partners | Velstrian';
/*
 * REWRITTEN 2026-08-11. THE PAGE SOLD THREE THINGS THAT DO NOT EXIST.
 *
 * Measured against the platform repository, not remembered:
 *
 *   1. "Branded PDF and DOCX exports carrying your own name."
 *      `whiteLabelDocxHeaderFooter()` (web/src/shared/lib/brand/docx-letterhead.ts:215)
 *      has ZERO callers. Every exporter draws the CrowAgent lockup from a
 *      hardcoded constant: web/lib/public-sector/requirement-pack-docx.ts:28,
 *      requirement-pack-pdf.ts:20, web/src/features/reports/portfolio-summary-pdf.ts:24.
 *      A partner could fill in a branding form and every file they generated
 *      would still say CrowAgent.
 *
 *   2. "One pool of AI credits allocated across every client" / "Bulk credit
 *      allocation". The credit ledger is keyed (organisation_id, product,
 *      month_bucket), supabase/migrations/20260736000000_i1_ai_credit_ledger.sql:69.
 *      Nothing anywhere moves a credit between two organisations, so there is
 *      no pool to allocate from.
 *
 *   3. "Revenue share on all client credits". `agency_revenue_share` has no
 *      writer in any application code. Its own migration says so:
 *      supabase/migrations/20260706140000_mb002_agency_revenue_share.sql:23-28,
 *      "Until that exists this ledger stays empty".
 *
 * WHAT REPLACED THEM IS NOT A SOFTER VERSION OF THE SAME PROMISE. It is the
 * part that ships: a named contact, a priority channel, co-marketing, and
 * PARTNER ATTRIBUTION, which already works end to end. `?partner=<slug>` is
 * read at web/app/(auth)/auth/callback/route.ts:582-604 and written to
 * profiles.partner_slug / partner_attributed_at, guarded by
 * `.is('partner_slug', null)` so the FIRST attribution is the one that sticks.
 * Both columns are live in production. The only thing missing was a page that
 * offered anyone the link.
 *
 * NO COMMISSION FIGURE APPEARS ANYWHERE ON THIS PAGE, and none may be added
 * without the owner setting one. The rate is agreed on the call. That is also
 * what the platform's own partner console says
 * (web/lib/partner/console.ts, PARTNER_REVSHARE_CONTACT), so the two surfaces
 * now tell one story instead of two.
 */
const description =
  'Partner with Velstrian. Bid agencies, law firms and public sector advisors get a tracked referral link, a named account contact and a priority support channel.';
/** Deliberately a different sentence from `description`. Both are published. */
const ogDescription =
  'Bring PPN 026 social value scoring and delivery evidence to your public-sector bidding clients, with a tracked referral link and a named contact.';

const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Partners', path: '/partners/' },
  ]),
];

/*
 * THE FIRST CARD USED TO READ "Branded reports", and it promised branded PDF
 * and DOCX exports plus a shared credit pool. Both are argued at the top of
 * this file; neither exists in the product. It is replaced by the one
 * capability that does: attribution.
 *
 * IF THE HEADING CHANGE FAILS check-content-parity.js, that is the gate doing
 * its job. Refresh the baseline with `node scripts/check-content-parity.js
 * --update` and let the diff carry the argument, exactly as that file's own
 * "REFRESHING THE BASELINE" section instructs. Do NOT add an ALLOWED_LOSSES
 * entry: this is a permanent editorial change, not a loss tolerated across a
 * few builds.
 */
const BENEFITS = [
  {
    kicker: 'Attribution',
    heading: 'A tracked referral link',
    body: 'Your own referral link. A client who signs up through it is recorded against your name, and the first attribution recorded is the one that stands.',
  },
  {
    kicker: 'Support',
    heading: 'A named contact',
    body: 'Dedicated account contact and a priority support channel for rapid technical and regulatory guidance.',
  },
  {
    kicker: 'Growth',
    heading: 'Joint marketing',
    body: 'Co-branded regulatory updates you can send to your own client list, and joint write-ups of the work once there is work to write up.',
  },
];

/*
 * AUDIENCE CATEGORIES, NOT NAMED PARTNERS. Nothing here asserts an existing
 * commercial relationship with any organisation, and it must stay that way
 * unless there is a signed one to name.
 *
 * The live page shows only two cards while the hero, the meta description and
 * the form dropdown all name law firms as a third audience. That inconsistency
 * is carried over rather than invented away: adding a "Law firms" card would
 * mean writing a proposition nobody has approved.
 */
const AUDIENCES = [
  {
    heading: 'Bid agencies',
    /* "Bulk credits" REMOVED. Credits are held per organisation and never move
       between them; see the note at the top of this file. The evidence tracker
       is real and per client, which is what the sentence now says. */
    body: 'Run PPN 026 social value across your client bids, with the evidence tracker working per client.',
  },
  {
    heading: 'Public sector advisors',
    body: 'PPN 026 social value scoring (Velstrian Bid) for your public sector bidding clients.',
  },
];

/*
 * ALL THREE ITEMS WERE REPLACED, and none of the replacements is a restatement
 * of what it replaced:
 *
 *   "Revenue share on all client credits"            -> no writer exists
 *   "White-label PDF report generation"              -> no exporter reads it
 *   "Bulk credit allocation across your portfolio"   -> credits are per org
 *
 * The four below are each a thing a partner receives on the day they sign.
 * The commission line names no number ON PURPOSE: no rate has been set, and
 * publishing one would be inventing it. Every comparable UK vendor says the
 * same thing this line says.
 */
const WHY = [
  'A tracked referral link, attributed to you on signup',
  'Commission agreed with you, discussed on the call',
  'A named account contact and a priority support channel',
  'Co-branded regulatory updates for your own client list',
];

/*
 * THE BOOKING LINK IS BACK (OA-28, 2026-08-02). partners.html:320-327 closes on
 * a "Ready to start?" band whose two actions are this Calendly link and
 * mailto:hello@velstrian.com. The port folded that band's heading into "Express
 * your interest." and kept the mailto in the hero, but the booking link went
 * with the band, leaving the form as the only way a partner could start a
 * conversation. It returns inside the enquiry section, which is where the folded
 * band now lives, rather than as a new closing band, restoring the affordance,
 * not re-adding a section the port deliberately merged.
 */
---

<Base
  title={title}
  description={description}
  ogDescription={ogDescription}
  path="/partners"
  schema={schema}
  typeface="evidenced"
  headerTone="light"
>
  <PageHero
    id="partners-title"
    bandId="partners-hero"
    label="Partner programme"
    title={`Put ${PRODUCT_NAME_BID} in front of your clients.`}
    lead={`Velstrian partners with bid agencies, law firms and public sector advisors who run PPN 026 social value and delivery evidence for their clients. A tracked referral link, co-marketing and a priority support channel, with commission agreed on the call.`}
  >
    <div slot="before" class="ea-trail"><Breadcrumb trail={TRAIL} current="Partners" /></div>
    <Action href="#partner-enquiry">Become a partner</Action>
    <Action href={`mailto:${HELLO_EMAIL}`} variant="secondary">Talk to us</Action>
  </PageHero>

  {/* No eyebrow: it would repeat the heading word for word. */}
  <SectionBand tone="light" title="What partners get" id="partner-benefits" align="centre">
    <ul class="ea-cards" role="list">
      {
        BENEFITS.map((b) => (
          <li data-reveal>
            <div class="ea-card ea-tcard">
              <p class="ea-label">{b.kicker}</p>
              <h3 class="ea-h3">{b.heading}</h3>
              <p>{b.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </SectionBand>

  <SectionBand
    tone="light-alt"
    eyebrow="Ecosystem"
    title="Who we partner with."
    standfirst={`Whether you write bids, advise on procurement or guide public sector clients, ${PRODUCT_NAME_BID} does the social value arithmetic and the evidence tracking underneath your service.`}
    id="partner-audiences"
  >
    <ul class="ea-cards ea-cards--2" role="list">
      {
        AUDIENCES.map((a) => (
          <li data-reveal>
            <div class="ea-card ea-tcard">
              <h3 class="ea-h3">{a.heading}</h3>
              <p>{a.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </SectionBand>

  {/*
    THE REASONS PANEL ON THE LEFT, THE FORM ON THE RIGHT, the legacy
    arrangement, in one grid whose two cards stretch to one height. DOM order
    is the mobile order: reasons to partner, then the form to do it with.

    THE SCREEN IS NO LONGER THE FIGMA PHONE DRAWING. That picture carried the
    old brand's initials and was one of the drawings removed from every page on
    2026-10-22. ProductScreen's action centre recreation shows the same queue,
    captioned "Example data", until a real capture lands.
  */}
  <SectionBand
    tone="light"
    eyebrow="Enquiry"
    title="Express your interest."
    standfirst="Tell us who your clients are and how you work with them. We reply within two business days."
    id="partner-enquiry"
  >
    <div class="pt-grid">
      <aside class="ea-card pt-pane" aria-labelledby="why-partner-title" data-reveal>
        <h3 class="ea-h3" id="why-partner-title">Why partner?</h3>
        <ul class="pt-why" role="list">
          {WHY.map((w) => <li><Icon name="done" size={18} /><span>{w}</span></li>)}
        </ul>
        <ProductScreen name="action-centre" bare />
        <p class="pt-alt">
          Prefer to talk it through first? Book a 30-minute call to go through your client base before you sign
          anything.
        </p>
        <div class="pt-call">
          <Action href={WALKTHROUGH_URL} variant="secondary" newWindow>Book a 30-minute call</Action>
        </div>
      </aside>
      <div class="ea-card pt-pane" data-reveal>
        <PartnerForm />
      </div>
    </div>
  </SectionBand>
</Base>

<style>
  .pt-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    align-items: stretch;
  }

  .pt-pane {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
    padding: clamp(var(--space-6), 3vw, var(--space-8));
  }

  .pt-why {
    display: grid;
  }

  .pt-why li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--ea-rule);
    color: var(--ea-sub);
  }

  .pt-why li:last-child {
    border-bottom: 0;
  }

  .pt-why :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--ea-accent-ink);
  }

  .pt-alt {
    margin-top: auto;
    color: var(--ea-sub);
  }

  @media (max-width: 959px) {
    .pt-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
