---
/**
 * /sectors/: the sector hub.
 *
 * ── 2026-10-22: ON DESIGN SYSTEM VERSION 3 ──────────────────────────────────
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy 0.7. Every sector card, link and
 * fact of the previous page is kept, on the v3 bands:
 *
 *   1. PageHero   light      is this for my sector?   trail, plain headline, two actions
 *   2. Sectors    light      which one is mine?       one card per sector, each one link, the screen on a stage
 *   3. Cited      light alt  can I trust the answer?  the one ledger row, a question link
 *   4. Close      gradient   what now?                into the footer
 *
 * The h1 was "The statute behind your sector." and is now "What wins work in
 * your sector." (RULE 0-U: "statute" is a word a first time bidder has to look
 * up). Recorded in check-content-parity.js ALLOWED_LOSSES.
 *
 * SEO (title, description, canonical, the BreadcrumbList and CollectionPage
 * data) is carried over verbatim. The visible trail is the one Breadcrumb
 * component, fed from the same array as the BreadcrumbList.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/evidenced/PageHero.astro';
import Band from '../../components/evidenced/Band.astro';
import Action from '../../components/evidenced/Action.astro';
import ProductScreen from '../../components/evidenced/ProductScreen.astro';
import Close from '../../components/evidenced/Close.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { SITE } from '../../data/site';
import { SIGNUP_URL, START_LABEL } from '../../data/app';
import { TRIAL_NOTE } from '../../data/pricing';
import { breadcrumbs } from '../../lib/schema';
import { HELLO_EMAIL, PRODUCT_NAME_BID } from '../../lib/brand-names';
import '../../styles/evidenced.css';

const title = 'By Sector | Velstrian';
const description =
  'See the statute behind your sector. Velstrian helps UK teams find, win and evidence public sector tenders, cited to the regulation that applies to you.';
const path = '/sectors';

/* `kind` is the card's category on the Stripe card (D424, A-434): whether the
   work in that sector is public, private or both, in plain words (RULE 0-U). */
const sectorCards = [
  {
    name: 'Public-Sector Suppliers',
    kind: 'Public work',
    say: 'PPN 026, the next edition of the Social Value Model, applies to central government procurements commenced on or after 1 January 2027 at 1 million pounds inc VAT or above, and makes social value a scored award criterion on in-scope central-government tenders.',
    href: '/bid/',
  },
  {
    name: 'IT Managed Service Providers',
    kind: 'Public and private work',
    /* A-435 (2026-10-25). Was "scored on PPN 026 social value". PPN 026 binds
       central government contracting authorities only, so most IT buyers do
       not apply it. Tailored to who actually scores social value in IT. */
    say: 'Many public and private IT tenders ask how you add social value. Central government buyers score it under PPN 026, and other public bodies often use their own policy.',
    href: '/bid/',
  },
  {
    name: 'Professional Services',
    kind: 'Public and private work',
    say: 'Framework and consultancy tenders reward a consistent, evidenced bid response.',
    href: '/bid/',
  },
  {
    name: 'Construction',
    kind: 'Public and private work',
    /* A-435 (2026-10-25). Was "Public works bids score PPN 026 social value".
       Councils and housing bodies let most public works and are not bound by
       PPN 026, which covers central government only. */
    say: 'Many public works tenders ask how you add social value, such as local jobs and apprentices. Central government buyers score it under PPN 026, councils often use their own policy, and private clients increasingly ask too.',
    href: '/sectors/construction/',
  },
  {
    name: 'Facilities Management',
    kind: 'Public and private work',
    say: 'FM tenders turn on TUPE, mobilisation and evidenced delivery against the published KPIs.',
    href: '/sectors/facilities/',
  },
  {
    name: 'Highways',
    kind: 'Public work',
    say: 'Term maintenance and NEC4 contracts often score social value alongside price and capability.',
    href: '/sectors/highways/',
  },
  {
    name: 'NHS Suppliers',
    kind: 'Public work',
    /* A-435 (2026-10-25). Was "Framework bids weigh PPN 026 social value".
       PPN 026 binds central government, so an NHS trust tender may score social
       value under its own approach or not at all. */
    say: 'NHS buyers often ask how you add social value, and NHS and central government bodies may apply PPN 026. A track record of on time, evidenced delivery still counts.',
    href: '/bid/',
  },
  {
    name: 'Education',
    kind: 'Public and private work',
    say: 'Public-sector contracts expect a consistent, well-evidenced bid and a track record of on-time delivery.',
    href: '/sectors/education/',
  },
  {
    name: 'Charities',
    kind: 'Contracts and grants',
    /* A-433 (D424, 2026-10-25). Was "judged on PPN 026 social value". PPN 026
       binds central government contracting authorities, so it does not judge a
       charity's grant bid or most of its contracts. What is true for a charity:
       many contracts and grant funded services ask how you add social value,
       and a public body may score the answer. */
    say: 'Many charity contracts and grant funded services ask how you add social value, and public bodies may score your answer. Your reporting still has to stay lean.',
    href: '/bid/',
  },
];

/** What the card's foot says: a sector with its own page names it, the rest
    go to the product page. */
const more = (c: { name: string; href: string }) =>
  c.href.startsWith('/sectors/') ? `Read the ${c.name.toLowerCase()} page` : `See ${PRODUCT_NAME_BID}`;

/** SE-01 (audit 2026-10-25): the count in the lead is read from the cards,
    so it can never drift from what renders. Nine cards render, four of them
    with a sector page of their own (measured on the built page). */
const COUNT_WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const ownPages = sectorCards.filter((c) => c.href.startsWith('/sectors/')).length;
const cardCount = COUNT_WORDS[sectorCards.length] ?? String(sectorCards.length);
const ownCount = (COUNT_WORDS[ownPages] ?? String(ownPages)).toLowerCase();

const trail = [{ name: 'Home', path: '/' }];
const schema = [
  breadcrumbs([...trail, { name: 'Sectors', path }]),
  {
    '@type': 'CollectionPage',
    name: 'Sectors',
    description: 'How Velstrian serves UK teams by sector, cited to the statute that applies to each.',
    url: `${SITE.origin}/sectors`,
    publisher: { '@type': 'Organization', name: 'Velstrian', url: `${SITE.origin}/` },
  },
];

const UPDATED = new Date('2026-10-22');
---

<Base
  title={title}
  description={description}
  path={path}
  image={SITE.defaultOgImage}
  schema={schema}
  updatedAt={UPDATED}
  typeface="evidenced"
  headerTone="light"
>
  <PageHero
    id="sectors-title"
    label="By sector"
    title="What wins work in your sector."
    lead={`Different rules, one product. See what decides who wins the work in your sector, public or private, and how ${PRODUCT_NAME_BID} helps you answer it.`}
  >
    <div slot="before" class="ea-trail"><Breadcrumb trail={trail} current="Sectors" /></div>
    <Action href={SIGNUP_URL}>{START_LABEL}</Action>
    <Action href="#sectors-list" variant="secondary">Find your sector</Action>
    <Fragment slot="note">{TRIAL_NOTE}</Fragment>
  </PageHero>

  <Band tone="light" id="sectors-list" labelledby="sectors-list-title">
    <div class="ea-wrap">
      <div class="ea-head-row" data-reveal>
        <div class="ea-split__head">
          <p class="ea-label">Who we build for</p>
          <h2 class="ea-h2" id="sectors-list-title">Every sector is under its own clock.</h2>
        </div>
        <p class="ea-lead">
          {cardCount} UK sectors, each with its own bidding pressure, and {ownCount} with a page of their own. One line
          on the pressure, and how {PRODUCT_NAME_BID} answers it.
        </p>
      </div>

      <ul class="ea-cards" role="list">
        {
          sectorCards.map((c) => (
            <li data-reveal>
              <a class="ea-card ea-tcard" href={c.href}>
                <p class="ea-label">{c.kind}</p>
                <h3 class="ea-h3">{c.name}</h3>
                <p>{c.say}</p>
                <span class="ea-tcard__more">{more(c)}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="sectors-screen" data-reveal>
        <ProductScreen name="insights" />
      </div>
    </div>
  </Band>

  <Band tone="light-alt" labelledby="sectors-cited-title">
    <div class="ea-wrap">
      <div class="ea-head-row" data-reveal>
        <div class="ea-split__head">
          <p class="ea-label">How {PRODUCT_NAME_BID} works</p>
          <h2 class="ea-h2" id="sectors-cited-title">Whatever your sector, the answer is cited.</h2>
        </div>
        <p class="ea-lead">
          {PRODUCT_NAME_BID} reads the rules behind the tender, so every score, weighting and figure traces back to its
          source.
        </p>
      </div>

      <div class="ea-card sectors-ledger" data-reveal>
        <p class="ea-label">{PRODUCT_NAME_BID}</p>
        <p class="sectors-ledger__desc">
          <strong>Social value computed in code</strong>, over a curated catalogue of TOMs-aligned measures, with answers
          drafted from your own submitted bids.
        </p>
        <p class="sectors-ledger__meta">PPN 026, Cabinet Office<br />Published 5 August 2026, applies from 1 January 2027</p>
      </div>

      <p class="sectors-ask" data-reveal>
        <a class="ea-link" href="/pricing/">See pricing</a>
        <a class="ea-link" href={`mailto:${HELLO_EMAIL}`}>Ask a question</a>
      </p>
    </div>
  </Band>

  <Close
    title="Find the work. Win it. Prove you delivered."
    lead={`See how ${PRODUCT_NAME_BID} fits your sector's bidding calendar.`}
  />
</Base>

<style>
  .sectors-screen {
    margin-top: var(--ea-head-gap);
  }

  .sectors-ledger {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 6fr) minmax(0, 3fr);
    gap: var(--space-6);
    align-items: start;
    padding: var(--blk-pad);
  }

  .sectors-ledger__desc {
    color: var(--ea-sub);
  }

  .sectors-ledger__desc strong {
    color: var(--ea-ink);
    font-weight: var(--t-w-ea-strong);
  }

  .sectors-ledger__meta {
    font-size: var(--t-ea-small);
    color: var(--ea-muted);
  }

  .sectors-ask {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  @media (max-width: 959px) {
    .sectors-ledger {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
