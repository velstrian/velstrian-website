---
/**
 * /resources/: the resources hub on design system v3.
 *
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy section 0.7.
 * Rebuilt on design system version 3.
 *
 * Responsive.io style resource row: a grid of varied cards with card art on top,
 * short label, plain title, one line of description, the whole card one link.
 *
 * STORYLINE:
 *   1. ResourcesHero        light      what is this hub?       title, lead, two actions, no-gate reassurance
 *   2. ResourcesGrid        light alt  free tools and guides   4 varied cards (art, label, title, line), exit actions
 *   3. ResourcesStandards   dark       methodology & glossary  how rules are sourced, procurement glossary, compare link
 *   4. Close                gradient   what now?               the home page close, public and private
 *
 * ── SEO CARRIED OVER VERBATIM ──────────────────────────────────────────────
 * Title, description, canonical and breadcrumbs schema are preserved.
 */
import Base from '../layouts/Base.astro';
import ResourcesHero from '../components/resources/ResourcesHero.astro';
import ResourcesGrid from '../components/resources/ResourcesGrid.astro';
import ResourcesStandards from '../components/resources/ResourcesStandards.astro';
import Close from '../components/evidenced/Close.astro';
import '../styles/evidenced.css';
import { breadcrumbs } from '../lib/schema';

const title = 'Resources | Velstrian';
const description =
  'Free tools, plain guides to bidding for public and private work in the UK, and a glossary that explains the jargon.';

const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Resources', path: '/resources/' },
  ]),
];

const UPDATED = new Date('2026-10-22');
---

<Base
  title={title}
  description={description}
  path="/resources"
  schema={schema}
  updatedAt={UPDATED}
  typeface="evidenced"
  headerTone="light"
>
  <ResourcesHero />
  <ResourcesGrid />
  <ResourcesStandards />
  {/* The same close as the home page (audit S5): it said "find UK
      public-sector tenders", which is half the market (RULE 0-U). */}
  <Close />
</Base>
