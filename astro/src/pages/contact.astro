---
/**
 * /contact/: the page every "Request access" and "Send a question" link on the
 * site points at.
 *
 * ── 2026-10-22: ON DESIGN SYSTEM VERSION 3 ──────────────────────────────────
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy 0.7: the content stays, the page
 * moves onto the v3 bands, type and cards. Written for a first time reader from
 * a small firm (RULE 0-U), public and private named.
 *
 * STORYLINE:
 *   1. PageHero   light      who do I talk to?          book a call, email us
 *   2. Reach      light      which way suits me?        three card links, reply time
 *   3. The call   light alt  what happens on a call?    a real screen on a stage
 *   4. The form   light      tell us the situation      #contact-form, email directory, company
 *   5. Digest     light alt  can I just keep up?        monthly digest signup
 *
 * Every heading, link and form control of the previous page is kept. The one
 * change of substance is the picture under "What you will see on the call": it
 * was a drawn Figma screen, and is now a real screen from a demo account
 * (data/product-captures.ts `contact-call-find`), shown on a stage like every
 * other product view on the site, its caption saying exactly what it is.
 *
 * `#contact-form` is the anchor every sitewide CTA links to. Never rename it.
 * SEO (title, description, canonical, breadcrumb) is carried over verbatim.
 */
import Base from '../layouts/Base.astro';
import Band from '../components/evidenced/Band.astro';
import PageHero from '../components/evidenced/PageHero.astro';
import Action from '../components/evidenced/Action.astro';
import Stage from '../components/evidenced/Stage.astro';
import Frame from '../components/evidenced/Frame.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import NewsletterForm from '../components/forms/NewsletterForm.astro';
import '../styles/evidenced.css';
import { breadcrumbs } from '../lib/schema';
import { CONTACT_EMAILS, COMPANY_NUMBER, LEGAL_ENTITY_NAME, PRODUCT_NAME_BID } from '../lib/brand-names';
import { WALKTHROUGH_URL } from '../data/app';

const title = 'Contact Velstrian | Book a demo or ask a question';
const description =
  'Book a 30-minute call, send an enquiry, or email us. UK team, replying within three to five business days.';

const breadcrumb = breadcrumbs([
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
]);

/** Who to email, and for what. */
const DIRECTORY = [
  { purpose: 'General and partnerships', address: CONTACT_EMAILS.hello },
  { purpose: 'Support and data requests (GDPR)', address: CONTACT_EMAILS.support },
  { purpose: 'Enterprise sales', address: CONTACT_EMAILS.sales },
  { purpose: 'Security disclosures', address: CONTACT_EMAILS.security },
];

/** The three ways to reach us, each card one link. Copy kept from the previous
    page, the Portfolio card worded per R285-WEB-CLAIMS-AUDIT-01 C1 (single
    sign-on is on every plan, D241, and Portfolio has a published price, D235). */
const REACH = [
  {
    heading: 'Book a 30-minute call',
    body: 'Speak directly with the founders. Walk through your procurement challenge live.',
    href: WALKTHROUGH_URL,
    action: 'Choose a time',
    external: true,
  },
  {
    heading: 'Portfolio plan and volume licensing',
    body: 'Single sign-on is included on every plan. Talk to us about Portfolio contract terms, a DPA, invoice or purchase order billing, or more than 10 users.',
    href: `mailto:${CONTACT_EMAILS.sales}?subject=Enterprise%20enquiry`,
    action: 'Email sales',
    external: false,
  },
  {
    heading: 'Send us an email',
    body: `${CONTACT_EMAILS.hello}. We respond within 3 to 5 business days.`,
    href: `mailto:${CONTACT_EMAILS.hello}`,
    action: CONTACT_EMAILS.hello,
    external: false,
  },
];

const COMPANY = [
  { term: 'Registration', detail: 'Registered in England and Wales' },
  { term: 'Companies House number', detail: COMPANY_NUMBER, mono: true },
  { term: 'Data protection', detail: 'ICO registered data controller' },
  { term: 'Data residency', detail: 'EU' },
  { term: 'UK business hours', detail: 'Mon to Fri, 09:00 to 17:30 BST' },
  { term: 'Response time', detail: 'Typically three to five business days' },
];

const UPDATED = new Date('2026-10-22');
---

<Base
  title={title}
  description={description}
  path="/contact"
  schema={[breadcrumb]}
  updatedAt={UPDATED}
  typeface="evidenced"
  headerTone="light"
>
  <PageHero
    id="contact-hero-title"
    bandId="contact-hero"
    label="Contact"
    title="Talk to Velstrian."
    lead="Book a call, send us a message or email us. We reply within three to five business days, and the person who replies is on the team that built it."
  >
    <Action href={WALKTHROUGH_URL} newWindow>Book a 30-minute call</Action>
    <Action href={`mailto:${CONTACT_EMAILS.hello}`} variant="secondary">Email us</Action>
  </PageHero>

  <Band tone="light" id="reach" class="ct-reach">
    <div class="ea-wrap">
      <ul class="ct-reach__grid" role="list">
        {
          REACH.map((r) => (
            <li data-reveal>
              <a
                class="ea-card ct-card"
                href={r.href}
                target={r.external ? '_blank' : undefined}
                rel={r.external ? 'noopener noreferrer' : undefined}
              >
                <h2 class="ea-h3 ct-card__h">{r.heading}</h2>
                <p class="ct-card__body">{r.body}</p>
                <span class="ct-card__action">{r.action}</span>
                {r.external && <span class="visually-hidden"> (opens in a new window)</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="ct-reach__trust" data-reveal>
        Response within 3 to 5 business days. Founded in the UK. No outsourced support.
      </p>
    </div>
  </Band>

  <Band tone="light-alt" id="contact-shots" labelledby="contact-shots-title">
    <div class="ea-wrap">
      <div class="ea-panel ea-panel--row ct-call" data-reveal>
        <div class="ea-panel__copy">
          <p class="ea-label">The product</p>
          <h2 class="ea-h2" id="contact-shots-title">What you will see on the call</h2>
          <p>
            We show you {PRODUCT_NAME_BID} working on a demo account, starting where most people start: the public and
            private contracts that suit your business, and how an answer is built from your own documents.
          </p>
        </div>
        <Stage layout="panel">
          <Frame
            title="New today"
            status="Matched to you"
            capture="contact-call-find"
            caption="One contract in the morning feed, with how well it suits you."
          >
            <ul class="ea-mini-list">
              <li><span>Office cleaning, a primary school</span><span class="ea-state">Closes in 21 days</span></li>
              <li><span>Facilities support, a private retailer</span><span class="ea-state">Uploaded by you</span></li>
            </ul>
          </Frame>
        </Stage>
      </div>
    </div>
  </Band>

  <Band tone="light" id="contact-form" labelledby="contact-form-title">
    <div class="ea-wrap">
      <div class="ea-head-row" data-reveal>
        <div class="ct-head">
          <p class="ea-label">Send a message</p>
          <h2 class="ea-h2" id="contact-form-title">Tell us what you're working on.</h2>
        </div>
        <p class="ea-lead">
          Bidding for public or private contracts, or working out whether Velstrian suits your business? Tell us the
          situation and we will answer properly.
        </p>
      </div>

      <div class="ct-grid">
        <div class="ea-card ct-pane" data-reveal>
          <h3 class="ea-h3">Send us a message</h3>
          <ContactForm />
        </div>

        <aside class="ea-card ct-pane" aria-labelledby="directory-title" data-reveal>
          <h3 class="ea-h3" id="directory-title">How to reach us by email</h3>
          <dl class="ct-list">
            {
              DIRECTORY.map((d) => (
                <div class="ct-list__row">
                  <dt>{d.purpose}</dt>
                  <dd>
                    <a class="ct-list__link" href={`mailto:${d.address}`}>{d.address}</a>
                  </dd>
                </div>
              ))
            }
          </dl>

          <h3 class="ea-h3 ct-pane__next" id="company-title">{LEGAL_ENTITY_NAME}</h3>
          <dl class="ct-list" aria-labelledby="company-title">
            {
              COMPANY.map((c) => (
                <div class="ct-list__row">
                  <dt>{c.term}</dt>
                  <dd class={c.mono ? 'is-mono' : undefined}>{c.detail}</dd>
                </div>
              ))
            }
            <div class="ct-list__row">
              <dt>Registered office</dt>
              <dd>Details in our <a class="ct-list__link" href="/privacy/">Privacy Policy</a></dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </Band>

  <Band tone="light-alt" id="newsletter" labelledby="contact-nl-title">
    <div class="ea-wrap">
      <div class="ea-card ct-digest" data-reveal>
        <p class="ea-label">Monthly digest</p>
        <h2 class="ea-h2" id="contact-nl-title">Prefer regulatory updates?</h2>
        <p class="ct-digest__p">
          Get our monthly procurement digest covering PPN 026 social value and Velstrian product news.
        </p>
        <NewsletterForm id="contact-nl" source="contact-newsletter" />
      </div>
    </div>
  </Band>
</Base>

<style>
  /* ── Reach: three cards, each one link ─────────────────────────────────── */
  .ct-reach__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    align-items: stretch;
  }

  .ct-reach__grid > li {
    display: grid;
  }

  .ct-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-8);
    color: var(--ea-ink);
    text-decoration: none;
  }

  .ct-card__h {
    margin: 0;
  }

  .ct-card__body {
    color: var(--ea-muted);
    overflow-wrap: anywhere;
  }

  .ct-card__action {
    color: var(--ea-accent-ink);
    font-weight: var(--t-w-ea-medium);
    overflow-wrap: anywhere;
  }

  @media (hover: hover) {
    .ct-card:hover .ct-card__action {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  .ct-reach__trust {
    margin-top: var(--space-8);
    font-size: var(--t-ea-small);
    color: var(--ea-muted);
    text-align: center;
  }

  /* ── The form and the directory ────────────────────────────────────────── */
  .ct-head {
    display: grid;
    gap: var(--space-3);
  }

  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: stretch;
  }

  .ct-pane {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(var(--space-6), 3vw, var(--space-8));
  }

  .ct-pane__next {
    margin-top: var(--space-6);
  }

  .ct-list {
    display: grid;
  }

  .ct-list__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--ea-rule);
  }

  .ct-list__row:last-child {
    border-bottom: 0;
  }

  .ct-list dt {
    color: var(--ea-muted);
  }

  .ct-list dd {
    color: var(--ea-sub);
    overflow-wrap: anywhere;
  }

  .ct-list dd.is-mono {
    font-family: var(--font-mono);
  }

  .ct-list__link {
    color: var(--ea-accent-ink);
    text-underline-offset: 4px;
  }

  /* ── Digest ────────────────────────────────────────────────────────────── */
  .ct-digest {
    max-width: var(--measure-band);
    margin-inline: auto;
    padding: clamp(var(--space-8), 5vw, var(--space-12));
    display: grid;
    gap: var(--space-4);
  }

  .ct-digest__p {
    max-width: var(--measure-prose);
    color: var(--ea-muted);
  }

  @media (max-width: 959px) {
    .ct-reach__grid,
    .ct-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 599px) {
    .ct-list__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>
