---
/**
 * /tools/: the free tools hub.
 *
 * ── 2026-10-22: ON DESIGN SYSTEM VERSION 3 ──────────────────────────────────
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy 0.7. Both tools, the four product
 * cards, every link and fact of the previous page are kept, on the v3 bands:
 *
 *   1. PageHero   light      what is free here?       h1, lead, open either tool, three topic chips
 *   2. Tools      light      which tool do I want?    two cards, each one link
 *   3. Product    light alt  what if I want more?     four cards into Velstrian Bid, pricing, a question
 *   4. Close      gradient   what now?                into the footer
 *
 * The lead and the close no longer say "public sector" only (RULE 0-U): the
 * finder searches public notices, and the matrix reads any tender text,
 * public or private. Headings are unchanged.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/evidenced/PageHero.astro';
import Band from '../../components/evidenced/Band.astro';
import Action from '../../components/evidenced/Action.astro';
import Close from '../../components/evidenced/Close.astro';
import { breadcrumbs } from '../../lib/schema';
import { SITE } from '../../data/site';
import { HELLO_EMAIL, PRODUCT_NAME_BID } from '../../lib/brand-names';
import { LIVE_SOURCES } from '../../data/site-facts';
import { RECENT_DAYS } from '../../data/tender-finder';
import '../../styles/evidenced.css';

const title = 'Free Tender Finder and Compliance Matrix | Velstrian';
const description =
  'Two free tools for UK public sector bidders: search open UK and EU tenders, and extract compliance requirements from tender text. Free, no account needed.';


const CHIPS = ['PPN 026 social value', 'National TOMs', 'Procurement Act 2023'];

const TOOLS = [
  {
    tag: 'Open notices · UK and EU',
    name: 'Tender Finder',
    body: `Search open tenders from ${LIVE_SOURCES}, published in the last ${RECENT_DAYS} days. Filter by keyword, region, value and closing date. No account.`,
    cta: 'Open tool',
    href: '/tools/tender-finder/',
  },
  {
    tag: 'Requirements · verbatim',
    name: 'Tender Compliance Matrix',
    body: 'Paste tender text and read back the requirements the wording states, each with the line it came from. Rule based, no upload, no account.',
    cta: 'Open tool',
    href: '/tools/tender-compliance-matrix/',
  },
];

const CROSS_SELL = [
  {
    job: 'Find',
    heading: 'Tender discovery',
    body: `Live tenders from ${LIVE_SOURCES}, filtered to what you can actually win.`,
    href: '/bid/',
  },
  {
    job: 'Draft',
    heading: 'Grounded answers',
    body: 'Answers drafted from your own submitted bids, with a note saying AI helped (following PPN 017 guidance) and figures checked in code.',
    href: '/bid/',
  },
  {
    job: 'Score',
    heading: 'PPN 026 social value',
    // Corrected string. The live page duplicated "National TOMs".
    body: 'Social value scored with National TOMs proxies, calculated rather than generated.',
    href: '/bid/',
  },
  {
    job: 'Evidence',
    heading: 'Delivery under the Act',
    body: 'Track s.52 KPIs and evidence what you promised, after the contract is awarded.',
    href: '/bid/',
  },
];

/** Generated from TOOLS, so a withdrawn tool cannot linger in the schema. The
    NAME is not generated, so it is the one part of this node that can go stale,
    and it has now been wrong in three directions: it described a list of tools
    while the list held one tool and its methodology (O-58), it then described
    one calculator while the list held two tools, and it named the calculator
    and its methodology after both were removed. It says what the one entry is. */
const itemList = {
  '@type': 'ItemList',
  name: 'Free UK tender tools: the tender finder and the tender compliance matrix',
  itemListElement: TOOLS.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `${SITE.origin}${t.href}`,
  })),
};

const schema = [
  itemList,
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Tools', path: '/tools/' },
  ]),
];

const UPDATED = new Date('2026-10-22');

---

<Base title={title} description={description} path="/tools" schema={schema} updatedAt={UPDATED} typeface="evidenced" headerTone="light">
  <PageHero
    id="tools-hero-title"
    bandId="tools-hero"
    label="Free, no account"
    title="Free tender finder and compliance matrix."
    lead="Two free tools. Search open UK and EU public tenders, then paste any tender text, public or private, to list what it asks for: the social value weighting, the certificates, the deadlines and the formats. No account, no email gate."
  >
    <Action href={TOOLS[0].href}>Open the {TOOLS[0].name}</Action>
    <Action href={TOOLS[1].href} variant="secondary">Open the {TOOLS[1].name}</Action>
    <ul slot="after" class="ea-chips" role="list">
      {CHIPS.map((c) => <li class="ea-chip">{c}</li>)}
    </ul>
  </PageHero>

  <Band tone="light" id="tools" labelledby="tools-title">
    <div class="ea-wrap">
      <div class="ea-head-row" data-reveal>
        <div class="ea-split__head">
          <p class="ea-label">Sourced end to end</p>
          <h2 class="ea-h2" id="tools-title">Two tools, each one fully shown.</h2>
        </div>
        <p class="ea-lead">
          Each states where its answer comes from: the finder links every notice to its official source, and the matrix
          returns the tender's own wording, line by line. No email gate.
        </p>
      </div>

      <ul class="ea-cards ea-cards--2" role="list">
        {
          TOOLS.map((t) => (
            <li data-reveal>
              <a class="ea-card ea-tcard" href={t.href}>
                <p class="ea-label">{t.tag}</p>
                <h3 class="ea-h3">{t.name}</h3>
                <p>{t.body}</p>
                <span class="ea-tcard__more">{t.cta}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Band>

  <Band tone="light-alt" id="products" labelledby="products-title">
    <div class="ea-wrap">
      <div class="ea-head-row" data-reveal>
        <div class="ea-split__head">
          <p class="ea-label">The full product</p>
          <h2 class="ea-h2" id="products-title">Ready for more than a free check?</h2>
        </div>
        <p class="ea-lead">
          {PRODUCT_NAME_BID} takes the same sourced approach across the whole bid: find the tender, draft the answers,
          evidence the delivery.
        </p>
      </div>

      <ul class="ea-cards ea-cards--4" role="list">
        {
          CROSS_SELL.map((x) => (
            <li data-reveal>
              <a class="ea-card ea-tcard" href={x.href}>
                <p class="ea-label">{x.job}</p>
                <h3 class="ea-h3">{x.heading}</h3>
                <p>{x.body}</p>
                <span class="ea-tcard__more">Explore</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="tools-ask" data-reveal>
        <a class="ea-link" href="/pricing/">See pricing</a>
        <a class="ea-link" href={`mailto:${HELLO_EMAIL}`}>Ask a question</a>
      </p>
    </div>
  </Band>

  <Close title="Find it. Draft it. Win it." lead="Everything you need to bid for public and private work, in one place." />
</Base>

<style>
  .tools-ask {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
</style>
