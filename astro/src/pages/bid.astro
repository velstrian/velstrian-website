---
/**
 * /bid/: the Velstrian Bid product page.
 *
 * ── 2026-10-22: REBUILT ON DESIGN SYSTEM VERSION 3, VERSION 2 STORYLINE ────
 *
 * R285-WEB-ENTERPRISE-REDESIGN-01, strategy section 0.7 step (2). Written for a
 * small or mid size organisation, 5 to 200 people, that writes its own bids,
 * public AND private, never for an expert bid manager (RULE 0-U). Composed from
 * components/evidenced/ (the parts the home page proved) and the page's own
 * bands in components/bid/. Each band answers the next thing a first time
 * visitor wonders:
 *
 *   BidHero        light      what is it, is it for me?    stage, sequence
 *   BidWhatItDoes  light alt  what does it do for me?      five rows, five stages
 *   Refusal        dark       can I trust what it writes?  the one slow moment
 *   Screens        light      what does it look like?      product carousel
 *   Steps          dark       how hard is it to start?     three steps
 *   BidTrust       light      am I in charge, is it safe?  hairline facts, trust strip
 *   Plans          light alt  what does it cost?           three plans, from pricing.ts
 *   BidDetail      dark       the expert detail            the rules, fit reasons, all twelve capabilities
 *   BidFaq         light alt  words I do not know          newcomer terms first
 *   Close          gradient   what now?                    overlaps into the footer
 *
 * EVERY CAPABILITY THE PREVIOUS PAGE CARRIED IS STILL HERE, said in plain
 * words: the section 52 and 71 duties, PPN 026, PPN 017, the fit score and
 * its seven reasons, award history, private quotes, the evidence vault, the
 * answer library, the Advisor, the free tool and the other side of the table.
 * The previous page's design (DutyCard, the drawn artefacts, styles/bid.css
 * and its inline view trigger) is retired with it: motion is now the shared
 * evidenced script, the same one the home page runs.
 *
 * ── SEO IS CARRIED OVER ─────────────────────────────────────────────────────
 *
 * Title, description, canonical and the JSON-LD types are unchanged. The
 * description's starting price is now read from data/pricing.ts rather than
 * typed, and renders the same string. The FAQPage node is built from the
 * questions this page shows (components/bid/faqs.ts).
 */
import Base from '../layouts/Base.astro';
import BidHero from '../components/bid/BidHero.astro';
import BidWhatItDoes from '../components/bid/BidWhatItDoes.astro';
import BidTrust from '../components/bid/BidTrust.astro';
import BidDetail from '../components/bid/BidDetail.astro';
import BidFaq from '../components/bid/BidFaq.astro';
import { BID_FAQS } from '../components/bid/faqs';
import Refusal from '../components/evidenced/Refusal.astro';
import Screens from '../components/evidenced/Screens.astro';
import Steps from '../components/evidenced/Steps.astro';
import Plans from '../components/evidenced/Plans.astro';
import Close from '../components/evidenced/Close.astro';
import '../styles/evidenced.css';
import { PLANS } from '../data/pricing';
import { faqPage, breadcrumbs } from '../lib/schema';
import { SITE } from '../data/site';
import { PRODUCT_NAME_BID, PLATFORM_SHORT_NAME } from '../lib/brand-names';

const [STARTER] = PLANS;

const title = `${PRODUCT_NAME_BID} | Bid and tender software for UK suppliers`;
const description = `Find UK tenders, draft answers cited to the regulations and your own bids, and evidence delivery after award. From £${STARTER.monthly}/month.`;

const schema = [
  /*
   * SoftwareApplication. No aggregateRating and no review: this site does not
   * publish ratings it cannot evidence. The offers are derived from PLANS,
   * exactly as /pricing does it, so the two pages cannot publish different
   * prices for the same product (A-88).
   */
  {
    '@type': 'SoftwareApplication',
    name: PRODUCT_NAME_BID,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: `${SITE.origin}/bid`,
    description,
    publisher: { '@type': 'Organization', name: PLATFORM_SHORT_NAME, url: `${SITE.origin}/` },
    offers: PLANS.filter((p) => p.monthly !== null).map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: String(p.monthly),
      priceCurrency: 'GBP',
      url: `${SITE.origin}/pricing`,
    })),
  },
  ...faqPage(BID_FAQS),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: PRODUCT_NAME_BID, path: '/bid/' },
  ]),
];

/*
 * WHEN THIS PAGE LAST MATERIALLY CHANGED. Read by Seo.astro into dateModified
 * and from there into the sitemap <lastmod>. Bumped because the page was
 * rebuilt and its content rewritten on this day.
 */
const UPDATED = new Date('2026-10-22');
---

<Base
  title={title}
  description={description}
  path="/bid"
  schema={schema}
  updatedAt={UPDATED}
  typeface="evidenced"
  headerTone="light"
>
  <BidHero />
  <BidWhatItDoes />
  <Refusal />
  <Screens />
  <Steps flash />
  <BidTrust />
  <Plans />
  <BidDetail />
  <BidFaq />
  <Close />
</Base>
